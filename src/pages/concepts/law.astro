        .desk-feature img { object-position: 58% center; }
        .desk-feature::after { background: linear-gradient(180deg, rgba(11,16,12,0.34), rgba(11,16,12,0.88)); }
        .desk-overlay { padding: 48px 22px; }
        .desk-overlay h2 { font-size: clamp(54px, 14.5vw, 68px); }
        .principle-grid { margin-top: 48px; grid-template-columns: 1fr; }
        .principle-grid article { min-height: 0; padding: 26px 0 30px; border-right: 0; border-bottom: 1px solid var(--line-light); }
        .principle-grid article:last-child { border-bottom: 0; }
        .principle-grid h3 { margin: 38px 0 12px; }
        .inquiry { grid-template-columns: 1fr; gap: 44px; }
        .seal { width: 96px; height: 96px; margin-bottom: 34px; font-size: 25px; }
        .inquiry-copy > p:not(.section-label) { font-size: 18px; }
        .inquiry-form { padding: 28px 20px; box-shadow: 9px 9px 0 rgba(16,19,15,0.28); }
        .inquiry-form input, .inquiry-form select, .inquiry-form textarea { font-size: 16px; }
        .questions { grid-template-columns: 1fr; gap: 40px; }
        .faq-list summary { min-height: 84px; grid-template-columns: 30px 1fr 18px; gap: 10px; font-size: 12px; line-height: 1.45; }
        .faq-list details > p { margin: 0 0 26px 40px; font-size: 15px; }
        footer { padding: 56px 22px 30px; }
        .footer-mark { font-size: 76px; }
        .footer-name { font-size: 52px; }
        footer nav { margin: 52px 0 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }
