      .inquiry-form input, .inquiry-form select, .inquiry-form textarea { width: 100%; min-width: 0; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line-light); border-radius: 0; color: var(--ink); background: transparent; outline: 0; }
