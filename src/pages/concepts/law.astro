        h1 { font-size: clamp(52px, 14.8vw, 66px); line-height: 0.95; }
        .hero-bottom { margin-top: 32px; grid-template-columns: 1fr; gap: 22px; }
        .hero-bottom p { font-size: 16px; }
        .hero-bottom a { min-width: 0; }
        .hero-rail { display: none; }
        .image-note { right: 25px; bottom: 22px; font-size: 8px; }
        .introduction, .practice, .principles, .inquiry, .questions { padding: 66px 22px; }
        .introduction { display: block; }
        .roman { margin-bottom: 26px; font-size: 64px; }
        .introduction h2, .practice h2, .consultation h2, .principles h2, .inquiry h2, .questions h2 { font-size: clamp(48px, 13.8vw, 62px); }
        .intro-copy { padding-top: 36px; }
        .intro-copy .lead { font-size: 21px; }
        .practice-head { display: block; }
        .practice-list { margin-top: 44px; }
        .practice-list a { min-height: 0; padding: 26px 0; grid-template-columns: 34px 1fr 24px; gap: 12px; }
        .practice-list strong { font-size: 29px; }
        .practice-list small { grid-column: 2; font-size: 14px; }
        .practice-list i { grid-column: 3; grid-row: 1; }
        .practice-list a:hover, .practice-list a:focus-visible { margin-inline: -12px; padding-inline: 12px; }
        .consultation { display: flex; flex-direction: column; }
