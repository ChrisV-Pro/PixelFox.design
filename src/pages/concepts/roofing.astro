    />
    <link rel="canonical" href="https://pixelfox.design/concepts/roofing/" />
    <title>Ridge & Rivet Roofing Co. | Fictional Roofing Concept</title>
    <style>
      :root {
        --ink: #151817;
        --ink-soft: #252a28;
        --paper: #f1eee5;
        --white: #fffdf6;
        --steel: #6c7776;
        --mist: #d5d9d3;
        --orange: #ef5b2a;
        --orange-dark: #c63e15;
        --line-dark: rgba(21, 24, 23, 0.18);
        --line-light: rgba(255, 253, 246, 0.2);
        --display: "Franklin Gothic Condensed", "Haettenschweiler", "Impact", sans-serif;
        --body: "Trebuchet MS", "Gill Sans", sans-serif;
        --gutter: clamp(22px, 5vw, 78px);
        --section: clamp(76px, 9vw, 138px);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 88px; }
      body {
        margin: 0;
        min-width: 0;
        overflow-x: hidden;
        color: var(--ink);
        background: var(--paper);
        font-family: var(--body);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      img, svg { display: block; }
      img { width: 100%; max-width: 100%; }
      h1, h2, h3, p { margin-top: 0; }

      .skip-link {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 100;
        padding: 12px 15px;
        color: var(--white);
        background: var(--orange);
        transform: translateY(-160%);
      }
      .skip-link:focus { transform: translateY(0); }

      .concept-ribbon {
        min-height: 34px;
        padding: 8px var(--gutter);
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: center;
        color: var(--white);
        background: var(--orange);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .concept-ribbon a { border-bottom: 1px solid currentColor; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        min-height: 82px;
        padding: 0 var(--gutter);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 36px;
        color: var(--white);
        background: rgba(21, 24, 23, 0.96);
        border-bottom: 1px solid var(--line-light);
        backdrop-filter: blur(12px);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        min-height: 48px;
      }
      .brand-mark {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        background: var(--orange);
        color: var(--white);
        font-family: var(--display);
        font-size: 17px;
        letter-spacing: -0.04em;
        transform: skewX(-9deg);
      }
      .brand-copy { line-height: 1; }
      .brand-copy strong {
        display: block;
        font-family: var(--display);
        font-size: 19px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .brand-copy span {
        display: block;
        margin-top: 5px;
        color: #aeb5b1;
        font-size: 7px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }
      .desktop-nav {
        justify-self: center;
        display: flex;
        gap: clamp(22px, 3vw, 48px);
      }
      .desktop-nav a,
      .header-cta {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .desktop-nav a { color: #c8ceca; }
      .desktop-nav a:hover,
      .desktop-nav a:focus-visible { color: var(--orange); }
      .header-cta {
        min-width: 184px;
        justify-content: center;
        color: var(--ink);
        background: var(--white);
      }
      .header-cta:hover,
      .header-cta:focus-visible { color: var(--white); background: var(--orange); }
      .mobile-nav { display: none; }

      .hero {
        min-height: calc(100svh - 116px);
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        color: var(--white);
        background: var(--ink);
      }
      .hero-copy {
        position: relative;
        z-index: 1;
        padding: clamp(74px, 9vw, 130px) var(--gutter) 58px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
      }
      .hero-copy::after {
        content: "";
        position: absolute;
        inset: auto -120px -190px auto;
        width: 420px;
        height: 420px;
        border: 1px solid rgba(239, 91, 42, 0.35);
        transform: rotate(45deg);
        pointer-events: none;
      }
      .eyebrow {
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--orange);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .eyebrow::before { content: ""; width: 28px; height: 2px; background: currentColor; }
      h1, h2, h3 {
        font-family: var(--display);
        font-weight: 500;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 760px;
        margin-bottom: 24px;
        font-size: clamp(70px, 8.6vw, 146px);
        line-height: 0.79;
        letter-spacing: -0.035em;
      }
      .hero h1 .accent { display: block; color: var(--orange); }
      .hero-intro {
        max-width: 560px;
        margin-bottom: 0;
        color: #c9ceca;
        font-size: clamp(14px, 1.2vw, 18px);
        line-height: 1.65;
      }
      .hero-actions {
        margin-top: 38px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .button {
        min-height: 54px;
        padding: 0 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 22px;
        border: 1px solid transparent;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .button svg { width: 16px; height: 16px; }
      .button-primary { color: var(--white); background: var(--orange); }
      .button-primary:hover,
      .button-primary:focus-visible { background: var(--orange-dark); }
      .button-ghost { color: var(--white); border-color: rgba(255, 253, 246, 0.35); }
      .button-ghost:hover,
      .button-ghost:focus-visible { border-color: var(--orange); }
      .hero-meta {
        position: relative;
        z-index: 2;
        margin-top: 68px;
        display: flex;
        gap: 38px;
        color: #939b96;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .hero-visual { position: relative; min-height: 650px; overflow: hidden; }
      .hero-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(21, 24, 23, 0.35), transparent 34%);
        pointer-events: none;
      }
      .hero-visual picture,
      .hero-visual img { width: 100%; height: 100%; }
      .hero-visual img { object-fit: cover; object-position: center; }
      .hero-caption {
        position: absolute;
        right: 24px;
        bottom: 24px;
        z-index: 2;
        max-width: 230px;
        padding: 13px 15px;
        color: var(--white);
        background: rgba(21, 24, 23, 0.88);
        font-size: 8px;
        line-height: 1.45;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .trust-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        color: var(--white);
        background: var(--orange);
      }
      .trust-item {
        min-height: 108px;
        padding: 22px clamp(18px, 3vw, 42px);
        display: flex;
        align-items: center;
        gap: 14px;
        border-right: 1px solid rgba(255, 253, 246, 0.3);
      }
      .trust-item:last-child { border-right: 0; }
      .trust-item span {
        font-family: var(--display);
        font-size: 34px;
        line-height: 1;
        opacity: 0.42;
      }
      .trust-item strong {
        font-size: 10px;
        line-height: 1.55;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .section { padding: var(--section) var(--gutter); }
      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(250px, 0.36fr);
        gap: 48px;
        align-items: end;
        margin-bottom: clamp(46px, 6vw, 82px);
      }
      .section-kicker {
        margin-bottom: 16px;
        color: var(--orange);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.17em;
        text-transform: uppercase;
      }
      .section h2 {
        max-width: 900px;
        margin-bottom: 0;
        font-size: clamp(55px, 7.4vw, 112px);
        line-height: 0.84;
        letter-spacing: -0.03em;
      }
      .section-head > p {
        margin-bottom: 0;
        color: #5e6662;
        font-size: 14px;
        line-height: 1.7;
      }

      .services { background: var(--paper); }
      .services-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--line-dark);
      }
      .service-card {
        position: relative;
        min-height: 410px;
        padding: 34px clamp(22px, 3vw, 42px) 30px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--line-dark);
        overflow: hidden;
      }
      .service-card:last-child { border-right: 0; }
      .service-card::after {
        content: "";
        position: absolute;
        right: -55px;
        bottom: -68px;
        width: 180px;
        height: 180px;
        border: 22px solid rgba(108, 119, 118, 0.12);
        transform: rotate(45deg);
      }
      .service-number {
        color: var(--steel);
        font-family: var(--display);
        font-size: 32px;
      }
      .service-card h3 {
        max-width: 330px;
        margin: auto 0 16px;
        font-size: clamp(34px, 4vw, 58px);
        line-height: 0.9;
      }
      .service-card p {
        position: relative;
        z-index: 1;
        max-width: 360px;
        margin-bottom: 0;
        color: #58605c;
        font-size: 13px;
        line-height: 1.65;
      }

      .inspection {
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
        color: var(--white);
        background: var(--ink-soft);
      }
      .inspection-media { min-height: 690px; }
      .inspection-media picture,
      .inspection-media img { width: 100%; height: 100%; }
      .inspection-media img { object-fit: cover; }
      .inspection-copy {
        padding: clamp(68px, 8vw, 126px) var(--gutter);
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-image: repeating-linear-gradient(135deg, transparent 0 38px, rgba(255,255,255,0.025) 38px 39px);
      }
      .inspection-copy h2 {
        margin-bottom: 28px;
        font-size: clamp(54px, 6vw, 92px);
        line-height: 0.86;
      }
      .inspection-copy > p {
        max-width: 500px;
        color: #c5cbc7;
        font-size: 15px;
        line-height: 1.75;
      }
      .inspection-list {
        margin: 35px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line-light);
      }
      .inspection-list li {
        min-height: 60px;
        display: flex;
        align-items: center;
        gap: 16px;
        border-bottom: 1px solid var(--line-light);
        color: var(--white);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .inspection-list span { color: var(--orange); }

      .process { color: var(--white); background: var(--ink); }
      .process .section-head > p { color: #aeb5b1; }
      .process-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--line-light);
      }
      .process-step {
        min-height: 340px;
        padding: 30px 28px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--line-light);
      }
      .process-step:last-child { border-right: 0; }
      .process-step .step-no {
        color: var(--orange);
        font-family: var(--display);
        font-size: 36px;
      }
      .process-step h3 {
        margin: auto 0 14px;
        font-size: clamp(32px, 3vw, 48px);
      }
      .process-step p {
        margin-bottom: 0;
        color: #aeb5b1;
        font-size: 12px;
        line-height: 1.65;
      }

      .project {
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
        background: var(--mist);
      }
      .project-media { min-height: 820px; }
      .project-media picture,
      .project-media img { width: 100%; height: 100%; }
      .project-media img { object-fit: cover; }
      .project-copy {
        padding: var(--section) var(--gutter);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .project-label {
        width: max-content;
        margin-bottom: 32px;
        padding: 10px 13px;
        color: var(--white);
        background: var(--orange);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .project-copy h2 {
        margin-bottom: 24px;
        font-size: clamp(64px, 8vw, 126px);
        line-height: 0.8;
      }
      .project-copy > p {
        max-width: 660px;
        color: #4f5753;
        font-size: 15px;
        line-height: 1.75;
      }
      .project-facts {
        margin-top: 42px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--line-dark);
      }
      .project-fact { padding: 20px 18px 0 0; }
      .project-fact span {
        display: block;
        margin-bottom: 7px;
        color: var(--steel);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .project-fact strong {
        font-family: var(--display);
        font-size: 23px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .estimate {
        display: grid;
        grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
        gap: clamp(50px, 8vw, 130px);
        color: var(--white);
        background: var(--orange);
      }
      .estimate h2 {
        margin-bottom: 26px;
        font-size: clamp(66px, 7.5vw, 118px);
        line-height: 0.79;
      }
      .estimate-copy > p {
        max-width: 500px;
        font-size: 14px;
        line-height: 1.7;
      }
      .concept-note {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 253, 246, 0.35);
        font-size: 9px;
        font-weight: 800;
        line-height: 1.6;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .estimate-form {
        padding: clamp(28px, 4vw, 54px);
        color: var(--ink);
        background: var(--white);
        box-shadow: 18px 18px 0 rgba(21, 24, 23, 0.16);
      }
      .estimate-form h3 { margin-bottom: 10px; font-size: 36px; }
      .estimate-form > p { color: #69716d; font-size: 12px; line-height: 1.6; }
      .field-grid {
        margin-top: 28px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }
      .field { min-width: 0; }
      .field-wide { grid-column: 1 / -1; }
      .field label {
        display: block;
        margin-bottom: 8px;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .field input,
      .field select,
      .field textarea {
        width: 100%;
        min-width: 0;
        border: 0;
        border-bottom: 1px solid var(--line-dark);
        border-radius: 0;
        color: var(--ink);
        background: transparent;
        outline: none;
      }
      .field input,
      .field select { min-height: 48px; }
      .field textarea { min-height: 100px; padding-top: 12px; resize: vertical; }
      .field input:focus,
      .field select:focus,
      .field textarea:focus { border-color: var(--orange); }
      .form-submit {
        width: 100%;
        min-height: 54px;
        margin-top: 28px;
        border: 0;
        color: var(--white);
        background: var(--ink);
        cursor: pointer;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .form-submit:hover,
      .form-submit:focus-visible { background: var(--orange-dark); }
      .form-status { min-height: 20px; margin: 13px 0 0; color: #5f6763; font-size: 11px; }

      .faq { background: var(--paper); }
      .faq-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.34fr);
        gap: clamp(48px, 8vw, 120px);
      }
      .faq h2 { font-size: clamp(58px, 7vw, 104px); }
      .faq-list { border-top: 1px solid var(--line-dark); }
      .faq-list details { border-bottom: 1px solid var(--line-dark); }
      .faq-list summary {
        min-height: 82px;
        padding: 18px 0;
        display: grid;
        grid-template-columns: 42px 1fr auto;
        align-items: center;
        gap: 16px;
        cursor: pointer;
        list-style: none;
      }
      .faq-list summary::-webkit-details-marker { display: none; }
      .faq-list summary span:first-child { color: var(--orange); font-family: var(--display); font-size: 25px; }
      .faq-list summary strong { font-family: var(--display); font-size: 25px; font-weight: 500; text-transform: uppercase; }
      .faq-list summary b { color: var(--orange); font-size: 24px; font-weight: 400; }
      .faq-list details[open] summary b { transform: rotate(45deg); }
      .faq-answer { max-width: 720px; padding: 0 48px 26px 58px; color: #5a625e; font-size: 13px; line-height: 1.75; }

      .site-footer {
        padding: 56px var(--gutter) 30px;
        color: var(--white);
        background: var(--ink);
      }
      .footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 40px;
      }
      .footer-title {
        margin-bottom: 0;
        font-family: var(--display);
        font-size: clamp(52px, 8vw, 114px);
        line-height: 0.8;
        text-transform: uppercase;
      }
      .footer-title span { color: var(--orange); }
      .footer-nav { display: grid; gap: 10px; text-align: right; }
      .footer-nav a {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        color: #bec5c0;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .footer-bottom {
        margin-top: 60px;
        padding-top: 22px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        border-top: 1px solid var(--line-light);
        color: #8e9791;
        font-size: 9px;
        line-height: 1.7;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .footer-bottom p { max-width: 900px; margin-bottom: 0; }
      .footer-bottom a { color: var(--white); }

      .reveal { animation: rise 0.8s cubic-bezier(.2,.7,.2,1) both; }
      .delay-1 { animation-delay: 0.08s; }
      .delay-2 { animation-delay: 0.16s; }
      @keyframes rise {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 980px) {
        .site-header { grid-template-columns: auto 1fr auto; }
        .desktop-nav { display: none; }
        .mobile-nav { display: block; justify-self: end; }
        .mobile-nav summary {
          min-height: 44px;
          display: flex;
          align-items: center;
          gap: 10px;
          color: var(--white);
          cursor: pointer;
          list-style: none;
          font-size: 8px;
          font-weight: 800;
          letter-spacing: 0.14em;
          text-transform: uppercase;
        }
        .mobile-nav summary::-webkit-details-marker { display: none; }
        .mobile-nav summary::after { content: ""; width: 19px; height: 10px; border-block: 1px solid currentColor; }
        .mobile-nav nav {
          position: absolute;
          inset: 82px 0 auto;
          padding: 20px var(--gutter) 24px;
          display: grid;
          background: var(--ink);
          border-top: 1px solid var(--line-light);
        }
        .mobile-nav nav a {
          min-height: 50px;
          display: flex;
          align-items: center;
          border-bottom: 1px solid var(--line-light);
          font-family: var(--display);
          font-size: 24px;
          text-transform: uppercase;
        }
        .header-cta { display: none; }
        .hero { grid-template-columns: 1fr; }
        .hero-copy { min-height: 640px; }
        .hero-visual { min-height: 620px; }
        .trust-strip { grid-template-columns: repeat(2, 1fr); }
        .trust-item:nth-child(2) { border-right: 0; }
        .trust-item:nth-child(-n+2) { border-bottom: 1px solid rgba(255,253,246,.3); }
        .services-grid { grid-template-columns: 1fr; }
        .service-card { min-height: 300px; border-right: 0; border-bottom: 1px solid var(--line-dark); }
        .inspection { grid-template-columns: 1fr; }
        .inspection-media { min-height: 520px; }
        .process-grid { grid-template-columns: repeat(2, 1fr); }
        .process-step:nth-child(2) { border-right: 0; }
        .process-step:nth-child(-n+2) { border-bottom: 1px solid var(--line-light); }
        .project { grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); }
        .estimate { grid-template-columns: 1fr; }
      }

      @media (max-width: 700px) {
        html { scroll-padding-top: 72px; }
        .concept-ribbon { justify-content: center; text-align: center; font-size: 7px; }
        .concept-ribbon a { display: none; }
        .site-header { min-height: 72px; gap: 12px; }
        .brand-mark { width: 34px; height: 34px; font-size: 15px; }
        .brand-copy strong { font-size: 16px; }
        .brand-copy span { font-size: 6px; }
        .mobile-nav nav { inset-block-start: 72px; }
        .hero { min-height: auto; }
        .hero-copy { min-height: 600px; padding-top: 74px; }
        .hero h1 { font-size: clamp(67px, 22vw, 88px); }
        .hero-intro { font-size: 14px; }
        .hero-actions { display: grid; grid-template-columns: 1fr; }
        .button { width: 100%; min-height: 52px; justify-content: space-between; }
        .hero-meta { margin-top: 48px; gap: 20px; flex-direction: column; }
        .hero-visual { min-height: 430px; }
        .hero-visual img { object-position: 58% center; }
        .trust-strip { grid-template-columns: 1fr; }
        .trust-item { min-height: 78px; border-right: 0; border-bottom: 1px solid rgba(255,253,246,.3); }
        .trust-item:last-child { border-bottom: 0; }
        .trust-item span { font-size: 27px; }
        .section-head { grid-template-columns: 1fr; gap: 22px; }
        .section h2 { font-size: clamp(55px, 18vw, 76px); }
        .section-head > p { font-size: 13px; }
        .service-card { min-height: 280px; padding-inline: 0; }
        .inspection-media { min-height: 380px; }
        .inspection-media img { object-position: 44% center; }
        .inspection-copy { padding-block: 72px; }
        .inspection-copy h2 { font-size: clamp(54px, 17vw, 72px); }
        .process-grid { grid-template-columns: 1fr; }
        .process-step { min-height: 230px; padding-inline: 0; border-right: 0; border-bottom: 1px solid var(--line-light); }
        .process-step:last-child { border-bottom: 0; }
        .project { grid-template-columns: 1fr; }
        .project-media { min-height: 520px; }
        .project-copy { padding-block: 74px; }
        .project-copy h2 { font-size: clamp(66px, 21vw, 88px); }
        .project-facts { grid-template-columns: 1fr; }
        .project-fact { padding: 17px 0; border-bottom: 1px solid var(--line-dark); }
        .estimate { gap: 40px; }
        .estimate h2 { font-size: clamp(64px, 20vw, 82px); }
        .estimate-form { padding: 28px 22px; box-shadow: 9px 9px 0 rgba(21,24,23,.16); }
        .field-grid { grid-template-columns: 1fr; }
        .field-wide { grid-column: auto; }
        .field input,
        .field select,
        .field textarea { font-size: 16px; }
        .faq-grid { grid-template-columns: 1fr; gap: 38px; }
        .faq-list summary { grid-template-columns: 34px 1fr auto; }
        .faq-list summary strong { font-size: 21px; }
        .faq-answer { padding-left: 50px; }
        .footer-top { display: grid; }
        .footer-nav { text-align: left; }
        .footer-nav a { justify-content: flex-start; min-height: 44px; }
        .footer-bottom { grid-template-columns: 1fr; margin-top: 38px; }
      }

      @media (max-width: 380px) {
        :root { --gutter: 19px; }
        .brand-copy span { display: none; }
        .hero-copy { min-height: 570px; }
        .hero h1 { font-size: clamp(62px, 21vw, 76px); }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="concept-ribbon">
      <a href="/">PixelFox.design</a>
      <span>Independent fictional concept / Not client work</span>
    </div>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Ridge and Rivet Roofing home">
        <span class="brand-mark" aria-hidden="true">R/R</span>
        <span class="brand-copy"><strong>Ridge & Rivet</strong><span>Roofing Co.</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#services">Services</a>
        <a href="#inspection">Inspection</a>
        <a href="#process">Process</a>
        <a href="#project">Project</a>
      </nav>
      <a class="header-cta" href="#estimate">Request an inspection</a>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="#services">Services</a>
          <a href="#inspection">Inspection</a>
          <a href="#process">Process</a>
          <a href="#project">Project</a>
          <a href="#estimate">Request an inspection</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div>
            <p class="eyebrow reveal">Residential roofing / Storm response</p>
            <h1 class="reveal delay-1" id="hero-title">Built above.<span class="accent">Trusted below.</span></h1>
            <p class="hero-intro reveal delay-2">Clear roof assessments, durable systems, and a crew that treats your property like a jobsite, not a storage yard.</p>
            <div class="hero-actions reveal delay-2">
              <a class="button button-primary" href="#estimate">Request an inspection <span aria-hidden="true">&#8599;</span></a>
              <a class="button button-ghost" href="#services">Explore services <span aria-hidden="true">&#8595;</span></a>
            </div>
          </div>
          <div class="hero-meta">
            <span>Fictional Pine County service area</span>
            <span>Concept emergency line: not active</span>
          </div>
        </div>
        <div class="hero-visual">
          <picture>
            <source type="image/avif" srcset="/images/roofing/hero-900.avif 900w, /images/roofing/hero-1600.avif 1600w" sizes="(max-width: 980px) 100vw, 56vw" />
            <source type="image/webp" srcset="/images/roofing/hero-900.webp 900w, /images/roofing/hero-1600.webp 1600w" sizes="(max-width: 980px) 100vw, 56vw" />
            <img src="/images/roofing/hero-1600.webp" width="1600" height="894" alt="Roofing crew working with safety equipment on a charcoal shingle roof" fetchpriority="high" />
          </picture>
          <span class="hero-caption">Original AI-generated jobsite image for this fictional concept</span>
        </div>
      </section>

      <section class="trust-strip" aria-label="Service principles">
        <div class="trust-item"><span>01</span><strong>Documented roof assessment</strong></div>
        <div class="trust-item"><span>02</span><strong>Plain-language scope</strong></div>
        <div class="trust-item"><span>03</span><strong>Weather-ready materials</strong></div>
        <div class="trust-item"><span>04</span><strong>Clean-site standard</strong></div>
      </section>

      <section class="section services" id="services" aria-labelledby="services-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">01 / What we handle</p>
            <h2 id="services-title">The right roof.<br />The honest scope.</h2>
          </div>
          <p>Service architecture built around the questions homeowners actually have: what is wrong, what can wait, and what a lasting repair requires.</p>
        </div>
        <div class="services-grid">
          <article class="service-card">
            <span class="service-number">01</span>
            <h3>Roof replacement</h3>
            <p>Illustrative positioning for complete shingle, metal, and low-slope systems, with options explained around the home and climate.</p>
          </article>
          <article class="service-card">
            <span class="service-number">02</span>
            <h3>Repair + storm assessment</h3>
            <p>A direct path for leaks, wind, hail, flashing issues, and repairability questions without fear-based claims or pressure.</p>
          </article>
          <article class="service-card">
            <span class="service-number">03</span>
            <h3>Metal + specialty</h3>
            <p>A premium service lane for standing seam, porch roofs, additions, ventilation, and architectural detailing.</p>
          </article>
        </div>
      </section>

      <section class="inspection" id="inspection" aria-labelledby="inspection-title">
        <div class="inspection-media">
          <picture>
            <source type="image/avif" srcset="/images/roofing/inspection-720.avif 720w, /images/roofing/inspection-1400.avif 1400w" sizes="(max-width: 980px) 100vw, 58vw" />
            <source type="image/webp" srcset="/images/roofing/inspection-720.webp 720w, /images/roofing/inspection-1400.webp 1400w" sizes="(max-width: 980px) 100vw, 58vw" />
            <img src="/images/roofing/inspection-1400.webp" width="1400" height="933" loading="lazy" alt="Roofing professional inspecting flashing on a standing-seam metal roof" />
          </picture>
        </div>
        <div class="inspection-copy">
          <p class="eyebrow">02 / A better inspection</p>
          <h2 id="inspection-title">No mystery above the ceiling line.</h2>
          <p>The concept turns an inspection into visible evidence. Homeowners get a clear explanation of conditions, priorities, and the next sensible step.</p>
          <ul class="inspection-list">
            <li><span>+</span> Photo-documented findings</li>
            <li><span>+</span> Repair versus replacement context</li>
            <li><span>+</span> Materials and ventilation overview</li>
            <li><span>+</span> Clear concept scope and next steps</li>
          </ul>
        </div>
      </section>

      <section class="section process" id="process" aria-labelledby="process-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">03 / How the work moves</p>
            <h2 id="process-title">Measure twice.<br />Roof once.</h2>
          </div>
          <p>A straightforward customer journey designed to reduce surprises before, during, and after the work.</p>
        </div>
        <div class="process-grid">
          <article class="process-step"><span class="step-no">01</span><h3>Inspect</h3><p>Start with the roof, attic conditions, drainage, flashing, and the questions that brought the homeowner in.</p></article>
          <article class="process-step"><span class="step-no">02</span><h3>Explain</h3><p>Show what was found, separate urgent issues from watch items, and compare sensible paths forward.</p></article>
          <article class="process-step"><span class="step-no">03</span><h3>Build</h3><p>Stage materials and protection carefully, communicate progress, and keep the property organized.</p></article>
          <article class="process-step"><span class="step-no">04</span><h3>Walk through</h3><p>Review the completed scope, cleanup, care notes, and documentation before calling the job finished.</p></article>
        </div>
      </section>

      <section class="project" id="project" aria-labelledby="project-title">
        <div class="project-media">
          <picture>
            <source type="image/avif" srcset="/images/roofing/project-600.avif 600w, /images/roofing/project-900.avif 900w" sizes="(max-width: 700px) 100vw, 42vw" />
            <source type="image/webp" srcset="/images/roofing/project-600.webp 600w, /images/roofing/project-900.webp 900w" sizes="(max-width: 700px) 100vw, 42vw" />
            <img src="/images/roofing/project-900.webp" width="900" height="1200" loading="lazy" alt="Fictional completed craftsman-home roofing project after rainfall" />
          </picture>
        </div>
        <div class="project-copy">
          <span class="project-label">Fictional project study / Not client work</span>
          <h2 id="project-title">Cedar Vale Re-roof</h2>
          <p>An original visual study showing how a roofer could present a project with useful material context and architectural detail, without inventing a customer quote or performance result.</p>
          <div class="project-facts" aria-label="Fictional project details">
            <div class="project-fact"><span>System</span><strong>Architectural shingle</strong></div>
            <div class="project-fact"><span>Detail</span><strong>Metal valleys</strong></div>
            <div class="project-fact"><span>Palette</span><strong>Charcoal + cedar</strong></div>
          </div>
        </div>
      </section>

      <section class="section estimate" id="estimate" aria-labelledby="estimate-title">
        <div class="estimate-copy">
          <p class="section-kicker">04 / Start with clarity</p>
          <h2 id="estimate-title">Get eyes on the roof.</h2>
          <p>This concept form demonstrates a focused, low-friction inspection request. It does not contact a business or schedule a real service.</p>
          <p class="concept-note">Concept only. Ridge & Rivet is not a real roofing contractor. No information entered here is sent or stored.</p>
        </div>
        <form class="estimate-form" id="concept-form">
          <h3>Request a concept inspection</h3>
          <p>Choose what is happening and preview the next-step experience.</p>
          <div class="field-grid">
            <div class="field"><label for="roof-name">First name</label><input id="roof-name" name="name" autocomplete="off" /></div>
            <div class="field"><label for="roof-zip">ZIP code</label><input id="roof-zip" name="zip" inputmode="numeric" autocomplete="off" /></div>
            <div class="field field-wide"><label for="roof-need">What brings you here?</label><select id="roof-need" name="need"><option>Active leak</option><option>Storm or wind concern</option><option>Roof replacement planning</option><option>Metal roofing</option><option>Not sure yet</option></select></div>
            <div class="field field-wide"><label for="roof-message">What have you noticed?</label><textarea id="roof-message" name="message"></textarea></div>
          </div>
          <button class="form-submit" type="submit">Preview request</button>
          <p class="form-status" id="form-status" role="status">Demonstration only. Nothing is sent.</p>
        </form>
      </section>

      <section class="section faq" id="questions" aria-labelledby="faq-title">
        <div class="faq-grid">
          <div><p class="section-kicker">05 / Good questions</p><h2 id="faq-title">Before anyone climbs.</h2></div>
          <div class="faq-list">
            <details><summary><span>01</span><strong>Is Ridge & Rivet a real roofing company?</strong><b aria-hidden="true">+</b></summary><p class="faq-answer">No. It is a fictional web design concept created by PixelFox.design. The company, service area, project study, and form are demonstrations only.</p></details>
            <details><summary><span>02</span><strong>Why avoid made-up ratings and warranties?</strong><b aria-hidden="true">+</b></summary><p class="faq-answer">Trust signals should be specific and verifiable for a real contractor. This concept shows where those details could live without fabricating reviews, licenses, certifications, or guarantees.</p></details>
            <details><summary><span>03</span><strong>What would a real launch need?</strong><b aria-hidden="true">+</b></summary><p class="faq-answer">Verified business information, service areas, license and insurance details where applicable, actual project photography, warranty terms, accessibility review, and a secure form destination.</p></details>
            <details><summary><span>04</span><strong>Does the estimate form send anything?</strong><b aria-hidden="true">+</b></summary><p class="faq-answer">No. The form is intentionally local and non-sending. It only demonstrates the interaction a finished site could use.</p></details>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <p class="footer-title">Built to<br /><span>hold up.</span></p>
        <nav class="footer-nav" aria-label="Footer navigation"><a href="#services">Services</a><a href="#inspection">Inspection</a><a href="#process">Process</a><a href="#top">Back to top</a></nav>
      </div>
      <div class="footer-bottom">
        <p>Ridge & Rivet Roofing Co. is an independent fictional website concept by PixelFox.design. It is not a real contractor and makes no customer, licensing, warranty, response-time, or performance claims. Images were AI-generated specifically for this concept.</p>
        <a href="/">Return to PixelFox.design</a>
      </div>
    </footer>

    <script>
      const form = document.querySelector("#concept-form");
      const status = document.querySelector("#form-status");
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (status) status.textContent = "Preview complete. In a real site, the request would be reviewed before scheduling. Nothing was sent.";
      });

      document.querySelectorAll(".mobile-nav a").forEach((link) => {
        link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
      });
    </script>
  </body>
</html>
