    <meta property="og:description" content="A bold, trust-first roofing-company website concept by PixelFox.design." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pixelfox.design/concepts/roofing/" />
    <meta property="og:image" content="https://pixelfox.design/images/roofing/hero-1600.webp" />
    <link
