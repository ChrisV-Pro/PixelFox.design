<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ridge & Rivet Roofing Co., an independent fictional roofing-company landing page concept by PixelFox.design."
    />
