---
const title = "Field & Hearth Kitchen Co. | Fictional Country Kitchen Concept";
const description = "A warm, collected country kitchen remodeling website concept by PixelFox.design.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#66705b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pixelfox.design/concepts/kitchen/" />
    <meta property="og:image" content="https://pixelfox.design/images/field-hearth/hero-1800.webp" />
    <link rel="canonical" href="https://pixelfox.design/concepts/kitchen/" />
    <link rel="icon" href="/social-preview.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="concept-note">
      <a href="/">A PixelFox.design concept</a>
      <p>Fictional studio, rooms, and services. Original generated imagery.</p>
    </div>

    <header class="site-header" id="top">
      <nav class="desktop-nav desktop-nav--left" aria-label="Primary navigation">
        <a href="#homes">Our rooms</a>
        <a href="#materials">Materials</a>
      </nav>
      <a class="brand" href="#top" aria-label="Field and Hearth Kitchen Company home">
        <span class="brand-flourish" aria-hidden="true">&#10023;</span>
        <strong>Field <i>&amp;</i> Hearth</strong>
        <small>Kitchen Company</small>
      </a>
      <nav class="desktop-nav desktop-nav--right" aria-label="More navigation">
        <a href="#approach">Our approach</a>
        <a href="#contact">Begin a room</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Open menu"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#homes">Our rooms</a>
          <a href="#materials">Materials</a>
          <a href="#approach">Our approach</a>
          <a href="#guide">Project guide</a>
          <a href="#contact">Begin a room</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Thoughtful kitchens for unrushed living</p>
          <h1 id="hero-title">A kitchen that feels like it has <em>always</em> belonged.</h1>
          <p class="hero-intro">Rooms shaped around morning light, family recipes, and the way a home is truly lived in. Field &amp; Hearth is an original fictional remodeling concept.</p>
          <div class="hero-actions">
            <a class="button button--olive" href="#contact">Begin your room</a>
            <a class="text-link" href="#homes">Wander through the homes <span aria-hidden="true">&#8595;</span></a>
          </div>
          <div class="hero-signature" aria-label="Design qualities">
            <span>Collected</span><i></i><span>Useful</span><i></i><span>Made to last</span>
          </div>
        </div>
        <figure class="hero-media">
          <picture>
            <source sizes="(max-width: 760px) 100vw, 58vw" srcset="/images/field-hearth/hero-900.avif 900w, /images/field-hearth/hero-1800.avif 1800w" type="image/avif" />
            <source sizes="(max-width: 760px) 100vw, 58vw" srcset="/images/field-hearth/hero-900.webp 900w, /images/field-hearth/hero-1800.webp 1800w" type="image/webp" />
            <img alt="Cream country kitchen with an oak worktable island, soapstone counters, brass details, and garden windows" decoding="async" fetchpriority="high" height="1024" src="/images/field-hearth/hero-1800.webp" width="1536" />
          </picture>
          <figcaption>Field &amp; Hearth / Original generated concept image</figcaption>
        </figure>
      </section>

      <section class="keepsakes" aria-label="Field and Hearth design principles">
        <p><span aria-hidden="true">01</span><strong>Made for mornings</strong><small>Easy starts and clear surfaces</small></p>
        <p><span aria-hidden="true">02</span><strong>Open to gathering</strong><small>Room for people, not just things</small></p>
        <p><span aria-hidden="true">03</span><strong>Better with age</strong><small>Natural materials with a story</small></p>
      </section>

      <section class="welcome section-shell" aria-labelledby="welcome-title">
        <div class="ornament" aria-hidden="true"><span></span>&#10022;<span></span></div>
        <p class="eyebrow">The heart of the house</p>
        <h2 id="welcome-title">The best rooms feel <em>collected</em>,<br />not composed overnight.</h2>
        <div class="welcome-copy">
          <p>We imagined Field &amp; Hearth for homeowners who want a room with warmth, rhythm, and a little history in its bones. Nothing too perfect. Nothing chosen simply because it is new.</p>
          <p>Painted wood, honest stone, woven texture, and worktables that invite one more chair. Every fictional room study begins with how the household gathers.</p>
        </div>
      </section>

      <section class="homes" id="homes" aria-labelledby="homes-title">
        <header class="homes-heading section-shell">
          <div><p class="eyebrow">Three imagined homes</p><h2 id="homes-title">Rooms with roots.</h2></div>
          <p>Original studies in country living, each designed for a different kind of house. These are fictional concepts, not completed client projects.</p>
        </header>

        <article class="home-story home-story--garden">
          <figure class="home-image home-image--arch">
            <picture>
              <source sizes="(max-width: 820px) 100vw, 58vw" srcset="/images/field-hearth/gathering-800.avif 800w, /images/field-hearth/gathering-1600.avif 1600w" type="image/avif" />
              <source sizes="(max-width: 820px) 100vw, 58vw" srcset="/images/field-hearth/gathering-800.webp 800w, /images/field-hearth/gathering-1600.webp 1600w" type="image/webp" />
              <img alt="Country kitchen with a deep olive island, oak dining table, rush chairs, and French doors to a garden" decoding="async" height="1024" loading="lazy" src="/images/field-hearth/gathering-1600.webp" width="1536" />
            </picture>
            <figcaption>Fictional room study / Generated imagery</figcaption>
          </figure>
          <div class="home-copy">
            <p class="folio">House No. 01</p><p class="eyebrow">The Garden House</p>
            <h3>A generous table between supper and the garden.</h3>
            <p>Mushroom-painted cabinets quiet the working walls while a deep olive island gives the room its center. The table stays close enough for chopping, homework, and lingering after dinner.</p>
            <dl><div><dt>Character</dt><dd>Relaxed and gathered</dd></div><div><dt>Palette</dt><dd>Olive, oak, warm plaster</dd></div></dl>
            <button type="button" data-project="garden">Open the room notes <span aria-hidden="true">&#8594;</span></button>
          </div>
        </article>

        <article class="home-story home-story--cottage">
          <figure class="home-image">
            <picture>
              <source sizes="(max-width: 820px) 100vw, 55vw" srcset="/images/field-hearth/cottage-640.avif 640w, /images/field-hearth/cottage-1200.avif 1200w" type="image/avif" />
              <source sizes="(max-width: 820px) 100vw, 55vw" srcset="/images/field-hearth/cottage-640.webp 640w, /images/field-hearth/cottage-1200.webp 1200w" type="image/webp" />
              <img alt="Dusty blue-gray cottage kitchen with a farmhouse sink, oak prep table, copper pans, and timber beams" decoding="async" height="1024" loading="lazy" src="/images/field-hearth/cottage-1200.webp" width="1536" />
            </picture>
            <figcaption>Fictional room study / Generated imagery</figcaption>
          </figure>
          <div class="home-copy">
            <p class="folio">House No. 02</p><p class="eyebrow">Bluebell Cottage</p>
            <h3>Small, storied, and wonderfully hardworking.</h3>
            <p>A compact room keeps its old beams and garden outlook. Dusty blue-gray paint, a fireclay sink, and an oak prep table make every useful inch feel considered rather than crowded.</p>
            <dl><div><dt>Character</dt><dd>Quiet and resourceful</dd></div><div><dt>Palette</dt><dd>Blue-gray, limestone, copper</dd></div></dl>
            <button type="button" data-project="bluebell">Open the room notes <span aria-hidden="true">&#8594;</span></button>
          </div>
        </article>

        <article class="home-story home-story--stone">
          <figure class="home-image home-image--soft">
            <picture>
              <source sizes="(max-width: 820px) 100vw, 58vw" srcset="/images/field-hearth/stone-house-800.avif 800w, /images/field-hearth/stone-house-1600.avif 1600w" type="image/avif" />
              <source sizes="(max-width: 820px) 100vw, 58vw" srcset="/images/field-hearth/stone-house-800.webp 800w, /images/field-hearth/stone-house-1600.webp 1600w" type="image/webp" />
              <img alt="Putty-painted country kitchen with a walnut island, plaster hood, brass pot rail, and stone doorway" decoding="async" height="1024" loading="lazy" src="/images/field-hearth/stone-house-1600.webp" width="1536" />
            </picture>
            <figcaption>Fictional room study / Generated imagery</figcaption>
          </figure>
          <div class="home-copy">
            <p class="folio">House No. 03</p><p class="eyebrow">The Old Stone House</p>
            <h3>New joinery, in conversation with old walls.</h3>
            <p>Putty-toned cabinetry settles into the stone shell. A walnut island carries the visual weight while unlacquered brass and a breakfast nook soften the room around it.</p>
            <dl><div><dt>Character</dt><dd>Grounded and enduring</dd></div><div><dt>Palette</dt><dd>Walnut, putty, aged brass</dd></div></dl>
            <button type="button" data-project="stone">Open the room notes <span aria-hidden="true">&#8594;</span></button>
          </div>
        </article>
      </section>

      <section class="pantry-story" aria-labelledby="pantry-title">
        <div class="pantry-copy">
          <p class="eyebrow">The useful cupboard</p>
          <h2 id="pantry-title">A place for everything.<br /><em>Nothing</em> too precious.</h2>
          <p>A freestanding larder can make a fitted room feel inherited. Doors open wide, oak drawers carry the daily weight, and the things worth seeing stay within reach.</p>
          <ul><li><span>01</span>Breakfast shelf at hand height</li><li><span>02</span>Deep drawers for linens and baking</li><li><span>03</span>Adjustable storage for real routines</li></ul>
        </div>
        <figure>
          <picture>
            <source sizes="(max-width: 820px) 100vw, 56vw" srcset="/images/field-hearth/pantry-640.avif 640w, /images/field-hearth/pantry-1200.avif 1200w" type="image/avif" />
            <source sizes="(max-width: 820px) 100vw, 56vw" srcset="/images/field-hearth/pantry-640.webp 640w, /images/field-hearth/pantry-1200.webp 1200w" type="image/webp" />
            <img alt="Open sage-green country larder with oak drawers, baskets, jars, linens, and cream stoneware" decoding="async" height="1024" loading="lazy" src="/images/field-hearth/pantry-1200.webp" width="1536" />
          </picture>
          <figcaption>Fictional cabinetry detail / Generated imagery</figcaption>
        </figure>
      </section>

      <section class="materials section-shell" id="materials" aria-labelledby="materials-title">
        <header class="materials-heading">
          <p class="eyebrow">A quieter palette</p>
          <h2 id="materials-title">Materials that remember<br />the touch of a hand.</h2>
          <p>Select a material to explore how it gives a country kitchen depth without making the room feel decorated.</p>
        </header>
        <div class="materials-layout">
          <figure>
            <picture>
              <source sizes="(max-width: 820px) 100vw, 50vw" srcset="/images/field-hearth/materials-560.avif 560w, /images/field-hearth/materials-1000.avif 1000w" type="image/avif" />
              <source sizes="(max-width: 820px) 100vw, 50vw" srcset="/images/field-hearth/materials-560.webp 560w, /images/field-hearth/materials-1000.webp 1000w" type="image/webp" />
              <img alt="Country kitchen material palette with painted wood, oak, soapstone, limestone, aged brass, striped linen, and woven rush" decoding="async" height="1024" loading="lazy" src="/images/field-hearth/materials-1000.webp" width="1365" />
            </picture>
            <figcaption>Concept material table / Generated imagery</figcaption>
          </figure>
          <div class="material-picker">
            <div class="material-buttons" role="group" aria-label="Explore country kitchen materials">
              <button class="is-active" type="button" data-material="Warm cream" data-description="A soft painted base that follows changing daylight and lets timber, stone, and collected objects carry the room." aria-pressed="true"><i class="swatch swatch--cream"></i><span>Warm cream</span></button>
              <button type="button" data-material="Garden sage" data-description="An earthy green for islands and larders. It feels at home beside oak, rush, herbs, and a view into the garden." aria-pressed="false"><i class="swatch swatch--sage"></i><span>Garden sage</span></button>
              <button type="button" data-material="Charcoal soapstone" data-description="Dark, velvety stone gives the work surface substance while developing the marks and softness of everyday use." aria-pressed="false"><i class="swatch swatch--stone"></i><span>Charcoal soapstone</span></button>
              <button type="button" data-material="Aged brass" data-description="A warm metal used sparingly on latches, taps, rails, and lights. Its changing patina keeps the room from feeling brand new." aria-pressed="false"><i class="swatch swatch--brass"></i><span>Aged brass</span></button>
            </div>
            <div class="material-result" aria-live="polite">
              <p>At the material table</p><strong id="material-name">Warm cream</strong><span class="rule"></span>
              <p id="material-description">A soft painted base that follows changing daylight and lets timber, stone, and collected objects carry the room.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="approach" id="approach" aria-labelledby="approach-title">
        <div class="approach-intro">
          <p class="eyebrow">From first sketch to Sunday supper</p>
          <h2 id="approach-title">A gentle process for a room that does a great deal.</h2>
          <p>This fictional process is designed to feel personal and legible, with space to listen before anything is drawn.</p>
        </div>
        <ol>
          <li><span>01</span><div><h3>Listen</h3><p>Notice the rituals, bottlenecks, keepsakes, and small frustrations already living in the room.</p></div></li>
          <li><span>02</span><div><h3>Draw</h3><p>Shape movement, storage, and gathering before choosing the things that sit on the surface.</p></div></li>
          <li><span>03</span><div><h3>Gather</h3><p>Bring paint, timber, stone, hardware, and lighting into one calm material story.</p></div></li>
          <li><span>04</span><div><h3>Build</h3><p>Sequence the work carefully, keeping decisions visible and the room's original character in view.</p></div></li>
          <li><span>05</span><div><h3>Settle in</h3><p>Leave room for cookbooks, flowers, scuffed chairs, and the life that makes a kitchen complete.</p></div></li>
        </ol>
      </section>

      <section class="guide section-shell" id="guide" aria-labelledby="guide-title">
        <div class="guide-card">
          <div class="guide-copy">
            <p class="eyebrow">A small project guide</p><h2 id="guide-title">What should your next room make easier?</h2>
            <p>Choose the change that matters most. This interactive sample demonstrates how a remodeling studio could turn an early feeling into a useful first conversation.</p>
          </div>
          <div class="guide-choices" role="group" aria-label="Choose a project priority">
            <button class="is-active" type="button" data-priority="flow" data-title="A clearer everyday path" data-copy="Begin with movement: fridge to sink, garden to table, groceries to pantry. A better plan can make the room feel larger without adding a single foot." aria-pressed="true"><span>01</span>Better flow</button>
            <button type="button" data-priority="storage" data-title="Storage with a reason" data-copy="Start by giving daily objects a natural home. A larder, appliance cupboard, or fitted dresser can reduce visual noise without erasing personality." aria-pressed="false"><span>02</span>More storage</button>
            <button type="button" data-priority="gather" data-title="A generous place to gather" data-copy="Plan the social center first. A worktable island or nearby dining table should welcome company without crossing the cook's working path." aria-pressed="false"><span>03</span>A gathering place</button>
            <button type="button" data-priority="character" data-title="Old character, thoughtfully kept" data-copy="Keep what gives the room its roots: a beam, a stone wall, a garden view, or an old dresser. Let new cabinetry speak quietly around it." aria-pressed="false"><span>04</span>More character</button>
          </div>
          <aside class="guide-result" aria-live="polite">
            <p>Your starting point</p><strong id="priority-title">A clearer everyday path</strong><span></span>
            <p id="priority-copy">Begin with movement: fridge to sink, garden to table, groceries to pantry. A better plan can make the room feel larger without adding a single foot.</p>
            <a href="#contact">Carry this into a brief <span aria-hidden="true">&#8594;</span></a>
            <small>Illustrative guidance only, not a design consultation or quote.</small>
          </aside>
        </div>
      </section>

      <section class="faq section-shell" aria-labelledby="faq-title">
        <div class="faq-heading"><p class="eyebrow">Before we add the kettle</p><h2 id="faq-title">A few honest details.</h2></div>
        <div class="faq-list">
          <details><summary>Is Field &amp; Hearth a real remodeling company?</summary><p>No. Field &amp; Hearth Kitchen Co. is a fictional brand and website concept created by PixelFox.design.</p></details>
          <details><summary>Are these completed client homes?</summary><p>No. Every house name, room, service, material story, and process on this page is illustrative portfolio content, not client work or documented results.</p></details>
          <details><summary>Where did the photography come from?</summary><p>The room and material images are original AI-generated concept imagery created specifically for this design direction.</p></details>
          <details><summary>Does the inquiry form send my information?</summary><p>No. This is a front-end demonstration. The form does not send, save, or submit any information.</p></details>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="eyebrow">Come sit at the table</p><h2 id="contact-title">Tell us about the room you keep imagining.</h2>
          <p>This fictional inquiry demonstrates a warm, low-pressure first step for a country kitchen remodeling brand.</p>
        </div>
        <form id="contact-form">
          <div class="field-pair">
            <label>First name<input type="text" autocomplete="given-name" placeholder="Your first name" /></label>
            <label>Email address<input type="email" autocomplete="email" placeholder="you@example.com" required /></label>
          </div>
          <label>What would you love to change?<textarea rows="4" placeholder="A little about the room, the house, and what matters most..."></textarea></label>
          <button class="button button--cream" type="submit">Prepare my concept note</button>
          <p id="form-status" role="status">Demonstration only. Nothing is sent or saved.</p>
        </form>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top"><span aria-hidden="true">&#10023;</span><strong>Field <i>&amp;</i> Hearth</strong><small>Kitchen Company</small></a>
      <nav aria-label="Footer navigation"><a href="#homes">Rooms</a><a href="#materials">Materials</a><a href="#approach">Approach</a><a href="/">PixelFox.design</a></nav>
      <p>Field &amp; Hearth Kitchen Co. is a fictional remodeling brand and portfolio concept by PixelFox.design. All rooms, names, services, copy, and imagery are illustrative. No remodeling services are offered through this page.</p>
    </footer>

    <dialog id="project-dialog" aria-labelledby="dialog-title">
      <button id="dialog-close" type="button" aria-label="Close project notes">Close</button>
      <p class="eyebrow">Fictional room study</p><h2 id="dialog-title">The Garden House</h2>
      <p id="dialog-copy">A generous family room organized around an olive island, an oak table, and an easy path to the garden.</p>
      <span class="dialog-note">Concept only / No real client project</span>
    </dialog>

    <script>
      const mobileMenu = document.querySelector(".mobile-menu");
      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => mobileMenu.removeAttribute("open")));

      const materialName = document.querySelector("#material-name");
      const materialDescription = document.querySelector("#material-description");
      document.querySelectorAll("[data-material]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-material]").forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-pressed", "false");
          });
          button.classList.add("is-active");
          button.setAttribute("aria-pressed", "true");
          materialName.textContent = button.dataset.material;
          materialDescription.textContent = button.dataset.description;
        });
      });

      const priorityTitle = document.querySelector("#priority-title");
      const priorityCopy = document.querySelector("#priority-copy");
      document.querySelectorAll("[data-priority]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-priority]").forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-pressed", "false");
          });
          button.classList.add("is-active");
          button.setAttribute("aria-pressed", "true");
          priorityTitle.textContent = button.dataset.title;
          priorityCopy.textContent = button.dataset.copy;
        });
      });

      const projects = {
        garden: { title: "The Garden House", copy: "A generous family room organized around an olive island, an oak table, and an easy path to the garden." },
        bluebell: { title: "Bluebell Cottage", copy: "A compact cottage kitchen that keeps its beams, garden light, and useful freestanding furniture while making every working inch count." },
        stone: { title: "The Old Stone House", copy: "A grounded room where putty-painted joinery and a walnut island settle gently beside existing stone and a breakfast nook." },
      };
      const dialog = document.querySelector("#project-dialog");
      const dialogTitle = document.querySelector("#dialog-title");
      const dialogCopy = document.querySelector("#dialog-copy");
      document.querySelectorAll("[data-project]").forEach((button) => {
        button.addEventListener("click", () => {
          const project = projects[button.dataset.project];
          dialogTitle.textContent = project.title;
          dialogCopy.textContent = project.copy;
          dialog.showModal();
        });
      });
      document.querySelector("#dialog-close")?.addEventListener("click", () => dialog.close());
      dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });

      document.querySelector("#contact-form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        document.querySelector("#form-status").textContent = "Concept note prepared. This demo did not send or save your information.";
      });
    </script>

    <style>
      :root {
        --cream: #f3eee3; --paper: #fbf8f0; --sage: #66705b; --sage-dark: #3f4c3c;
        --walnut: #392b22; --clay: #9a6849; --brass: #a98b57; --ink: #302b25;
        --line: rgba(57, 43, 34, 0.2); --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
        --sans: "Gill Sans", Candara, Calibri, sans-serif; --gutter: clamp(24px, 4.7vw, 92px);
        --shell: min(1680px, calc(100vw - (var(--gutter) * 2)));
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 100px; }
      body { margin: 0; overflow-x: hidden; background: var(--paper); color: var(--ink); font-family: var(--sans); }
      button, input, textarea { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      a { color: inherit; } img { display: block; width: 100%; }
      figure, p, h1, h2, h3, dl, dd { margin: 0; }
      ::selection { background: var(--sage); color: var(--paper); }
      .skip-link { position: fixed; top: 12px; left: 12px; z-index: 1000; padding: 12px 16px; background: var(--walnut); color: white; transform: translateY(-180%); }
      .skip-link:focus { transform: none; }
      .section-shell { width: var(--shell); margin-inline: auto; }
      .eyebrow { color: var(--clay); font-size: 11px; font-weight: 700; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
      h1, h2, h3 { font-family: var(--serif); font-weight: 400; }
      h2 { font-size: clamp(54px, 5.1vw, 98px); letter-spacing: -.045em; line-height: .94; }
      em { font-weight: 400; }

      .concept-note { min-height: 32px; padding: 7px var(--gutter); display: flex; justify-content: space-between; align-items: center; gap: 24px; background: var(--sage-dark); color: #f6f1e7; font-size: 9px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
      .concept-note a { text-underline-offset: 3px; }
      .site-header { position: relative; z-index: 50; min-height: 112px; padding-inline: var(--gutter); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); background: var(--paper); }
      .desktop-nav { display: flex; align-items: center; gap: clamp(26px, 3vw, 56px); }
      .desktop-nav--right { justify-content: flex-end; }
      .desktop-nav a { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
      .desktop-nav a::after { content: ""; display: block; width: 0; height: 1px; margin-top: 5px; background: var(--clay); transition: width 220ms ease; }
      .desktop-nav a:hover::after, .desktop-nav a:focus-visible::after { width: 100%; }
      .brand { position: relative; min-width: 280px; display: flex; flex-direction: column; align-items: center; text-decoration: none; }
      .brand-flourish { position: absolute; left: -12px; top: 7px; color: var(--brass); font-size: 15px; }
      .brand strong { color: var(--walnut); font-family: var(--serif); font-size: clamp(27px, 2vw, 38px); font-weight: 400; letter-spacing: -.045em; line-height: 1; }
      .brand strong i, .footer-brand i { color: var(--clay); font-weight: 400; }
      .brand small { margin-top: 7px; font-size: 8px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; }
      .mobile-menu { display: none; }

      .hero { min-height: min(790px, calc(100vh - 144px)); display: grid; grid-template-columns: minmax(430px, 42%) minmax(0, 58%); background: var(--cream); }
      .hero-copy { position: relative; z-index: 2; padding: clamp(68px, 7vw, 130px) clamp(38px, 5.5vw, 110px) clamp(50px, 5vw, 90px) var(--gutter); display: flex; flex-direction: column; justify-content: center; }
      .hero-copy::before { content: ""; position: absolute; left: var(--gutter); top: 10%; width: 34px; height: 44px; border: 1px solid var(--brass); border-radius: 50%; opacity: .7; transform: rotate(28deg); }
      .hero h1 { max-width: 740px; margin-top: 26px; color: var(--walnut); font-size: clamp(62px, 5.6vw, 112px); letter-spacing: -.055em; line-height: .88; }
      .hero h1 em { color: var(--sage); }
      .hero-intro { max-width: 590px; margin-top: 32px; font-family: var(--serif); font-size: clamp(18px, 1.3vw, 25px); line-height: 1.55; }
      .hero-actions { margin-top: 38px; display: flex; align-items: center; gap: 30px; }
      .button { min-height: 52px; padding: 0 28px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-decoration: none; text-transform: uppercase; cursor: pointer; }
      .button--olive { background: var(--sage-dark); color: white; }
      .button--olive:hover, .button--olive:focus-visible { background: var(--clay); }
      .text-link { min-height: 44px; display: inline-flex; align-items: center; gap: 14px; color: var(--walnut); font-family: var(--serif); font-size: 16px; text-underline-offset: 6px; }
      .hero-signature { margin-top: auto; padding-top: 62px; display: flex; align-items: center; gap: 12px; color: var(--sage-dark); font-size: 9px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
      .hero-signature i { width: 3px; height: 3px; border-radius: 50%; background: var(--clay); }
      .hero-media { position: relative; min-height: 620px; overflow: hidden; border-radius: 0 0 0 220px; }
      .hero-media picture, .hero-media img { width: 100%; height: 100%; }
      .hero-media img { object-fit: cover; object-position: 51% center; animation: hero-reveal 900ms cubic-bezier(.2,.72,.28,1) both; }
      .hero-media figcaption, .home-image figcaption, .pantry-story figcaption, .materials-layout figcaption { position: absolute; right: 14px; bottom: 12px; padding: 6px 8px; background: rgba(251,248,240,.86); color: var(--walnut); font-size: 7px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
      @keyframes hero-reveal { from { opacity: 0; transform: scale(1.035); } to { opacity: 1; transform: scale(1); } }

      .keepsakes { min-height: 112px; padding-inline: var(--gutter); display: grid; grid-template-columns: repeat(3, 1fr); align-items: center; background: var(--paper); border-bottom: 1px solid var(--line); }
      .keepsakes p { min-width: 0; padding: 18px clamp(16px, 3vw, 56px); display: grid; grid-template-columns: auto 1fr; column-gap: 16px; align-items: center; }
      .keepsakes p + p { border-left: 1px solid var(--line); }
      .keepsakes p > span { grid-row: 1 / span 2; color: var(--clay); font-family: var(--serif); font-size: 18px; font-style: italic; }
      .keepsakes strong { font-family: var(--serif); font-size: 19px; font-weight: 400; }
      .keepsakes small { margin-top: 4px; color: rgba(48,43,37,.66); font-size: 10px; letter-spacing: .06em; }

      .welcome { padding-block: clamp(110px, 12vw, 220px); text-align: center; }
      .ornament { margin-bottom: 44px; display: flex; align-items: center; justify-content: center; gap: 14px; color: var(--brass); }
      .ornament span { width: 52px; height: 1px; background: var(--line); }
      .welcome h2 { max-width: 1420px; margin: 26px auto 0; }
      .welcome h2 em { color: var(--sage); }
      .welcome-copy { max-width: 930px; margin: 58px auto 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 58px; text-align: left; }
      .welcome-copy p { font-family: var(--serif); font-size: clamp(17px, 1.25vw, 23px); line-height: 1.6; }
      .welcome-copy p:first-child::first-letter { float: left; margin: -7px 9px -6px 0; color: var(--clay); font-family: var(--serif); font-size: 76px; line-height: 1; }

      .homes { padding-bottom: clamp(90px, 10vw, 190px); background: var(--cream); }
      .homes-heading { padding-block: clamp(80px, 9vw, 150px) clamp(62px, 7vw, 110px); display: grid; grid-template-columns: 1.2fr .8fr; gap: 8vw; align-items: end; }
      .homes-heading h2 { margin-top: 20px; }
      .homes-heading > p { max-width: 540px; justify-self: end; font-family: var(--serif); font-size: clamp(17px, 1.25vw, 23px); line-height: 1.55; }
      .home-story { width: min(1780px, calc(100vw - (var(--gutter) * 2))); margin: 0 auto clamp(110px, 11vw, 210px); display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(360px, .7fr); gap: clamp(52px, 7vw, 140px); align-items: center; }
      .home-story:last-child { margin-bottom: 0; }
      .home-image { position: relative; overflow: hidden; box-shadow: 0 30px 80px rgba(57,43,34,.1); }
      .home-image--arch { border-radius: 260px 260px 12px 12px; }
      .home-image--soft { border-radius: 12px 220px 12px 12px; }
      .home-image img { aspect-ratio: 3 / 2; object-fit: cover; transition: transform 800ms cubic-bezier(.2,.7,.3,1); }
      .home-image:hover img { transform: scale(1.02); }
      .home-copy { max-width: 570px; }
      .folio { margin-bottom: 42px; color: var(--brass); font-family: var(--serif); font-size: 18px; font-style: italic; }
      .home-copy h3 { margin-top: 22px; color: var(--walnut); font-size: clamp(45px, 4vw, 78px); letter-spacing: -.045em; line-height: .98; }
      .home-copy > p:not(.folio, .eyebrow) { margin-top: 28px; font-family: var(--serif); font-size: clamp(17px, 1.2vw, 22px); line-height: 1.6; }
      .home-copy dl { margin-top: 34px; padding-block: 18px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; border-block: 1px solid var(--line); }
      .home-copy dl div { display: grid; gap: 5px; }
      .home-copy dt { color: var(--clay); font-size: 9px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
      .home-copy dd { font-family: var(--serif); font-size: 15px; }
      .home-copy button { min-height: 48px; margin-top: 22px; padding: 0; display: inline-flex; align-items: center; gap: 18px; border: 0; border-bottom: 1px solid var(--walnut); background: transparent; color: var(--walnut); font-family: var(--serif); font-size: 16px; cursor: pointer; }
      .home-story--cottage { grid-template-columns: minmax(360px, .7fr) minmax(0, 1.45fr); }
      .home-story--cottage figure { grid-column: 2; grid-row: 1; }
      .home-story--cottage .home-copy { grid-column: 1; grid-row: 1; margin-left: clamp(0px, 2vw, 40px); }
      .home-story--cottage .home-image { transform: rotate(.6deg); border: 12px solid var(--paper); box-shadow: 0 20px 65px rgba(57,43,34,.13); }

      .pantry-story { min-height: 760px; display: grid; grid-template-columns: minmax(420px, 44%) minmax(0, 56%); background: var(--sage-dark); color: var(--paper); }
      .pantry-copy { padding: clamp(80px, 8vw, 150px) clamp(42px, 7vw, 130px) clamp(70px, 8vw, 140px) var(--gutter); display: flex; flex-direction: column; justify-content: center; }
      .pantry-copy .eyebrow { color: #c8b27c; }
      .pantry-copy h2 { margin-top: 26px; font-size: clamp(52px, 4.8vw, 92px); }
      .pantry-copy h2 em { color: #d9c8a6; }
      .pantry-copy > p:not(.eyebrow) { max-width: 620px; margin-top: 34px; color: rgba(251,248,240,.82); font-family: var(--serif); font-size: clamp(17px, 1.15vw, 22px); line-height: 1.6; }
      .pantry-copy ul { margin: 44px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(251,248,240,.22); }
      .pantry-copy li { min-height: 58px; display: flex; align-items: center; gap: 22px; border-bottom: 1px solid rgba(251,248,240,.22); font-family: var(--serif); font-size: 15px; }
      .pantry-copy li span { color: #c8b27c; font-size: 11px; }
      .pantry-story figure { position: relative; overflow: hidden; }
      .pantry-story picture, .pantry-story img { width: 100%; height: 100%; }
      .pantry-story img { min-height: 760px; object-fit: cover; object-position: center; }

      .materials { padding-block: clamp(110px, 11vw, 200px); }
      .materials-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: end; }
      .materials-heading .eyebrow { grid-column: 1 / -1; }
      .materials-heading p:last-child { max-width: 520px; justify-self: end; font-family: var(--serif); font-size: clamp(17px, 1.2vw, 22px); line-height: 1.6; }
      .materials-layout { margin-top: clamp(60px, 7vw, 110px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(460px, .9fr); gap: clamp(56px, 7vw, 130px); align-items: center; }
      .materials-layout figure { position: relative; overflow: hidden; border-radius: 220px 220px 8px 8px; }
      .materials-layout img { aspect-ratio: 4 / 3; object-fit: cover; }
      .material-picker { display: grid; grid-template-columns: minmax(220px, .75fr) minmax(250px, 1fr); gap: clamp(32px, 4vw, 76px); align-items: start; }
      .material-buttons { display: grid; border-top: 1px solid var(--line); }
      .material-buttons button { min-height: 78px; padding: 12px 8px; display: grid; grid-template-columns: 34px 1fr; align-items: center; gap: 16px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); text-align: left; cursor: pointer; }
      .material-buttons button span { font-family: var(--serif); font-size: 17px; }
      .material-buttons button.is-active span { color: var(--clay); font-style: italic; }
      .swatch { width: 28px; height: 28px; border: 1px solid rgba(57,43,34,.28); border-radius: 50%; box-shadow: inset 0 0 0 4px var(--paper); }
      .swatch--cream { background: #e8dfce; } .swatch--sage { background: #66705b; }
      .swatch--stone { background: #2c2c29; } .swatch--brass { background: #a98b57; }
      .material-result { min-height: 320px; padding: 36px; display: flex; flex-direction: column; background: var(--cream); border: 1px solid rgba(57,43,34,.11); box-shadow: 18px 18px 0 rgba(102,112,91,.12); }
      .material-result > p:first-child { color: var(--clay); font-size: 9px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
      .material-result strong { margin-top: 46px; font-family: var(--serif); font-size: clamp(32px, 2.5vw, 48px); font-weight: 400; line-height: 1; }
      .material-result .rule { width: 52px; height: 1px; margin: 25px 0; background: var(--brass); }
      .material-result p:last-child { font-family: var(--serif); font-size: 17px; line-height: 1.55; }

      .approach { padding: clamp(100px, 10vw, 180px) var(--gutter); background: #d8ddd3; }
      .approach-intro { max-width: 1080px; margin-inline: auto; text-align: center; }
      .approach-intro h2 { margin-top: 24px; }
      .approach-intro > p:last-child { max-width: 620px; margin: 34px auto 0; font-family: var(--serif); font-size: 19px; line-height: 1.55; }
      .approach ol { width: min(1400px, 100%); margin: clamp(70px, 7vw, 120px) auto 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); list-style: none; }
      .approach li { position: relative; min-height: 310px; padding: 40px 28px; border-block: 1px solid rgba(57,43,34,.25); }
      .approach li + li { border-left: 1px solid rgba(57,43,34,.25); }
      .approach li:nth-child(even) { background: rgba(251,248,240,.4); }
      .approach li > span { color: var(--clay); font-family: var(--serif); font-size: 14px; font-style: italic; }
      .approach li div { position: absolute; left: 28px; right: 28px; bottom: 38px; }
      .approach h3 { font-size: clamp(28px, 2vw, 38px); }
      .approach li p { margin-top: 14px; color: rgba(48,43,37,.76); font-family: var(--serif); font-size: 15px; line-height: 1.55; }

      .guide { padding-block: clamp(100px, 11vw, 190px); }
      .guide-card { padding: clamp(42px, 5vw, 84px); display: grid; grid-template-columns: minmax(340px, .85fr) minmax(300px, .75fr) minmax(340px, .9fr); gap: clamp(42px, 5vw, 90px); background: var(--cream); border: 1px solid rgba(57,43,34,.14); box-shadow: 0 34px 90px rgba(57,43,34,.08); }
      .guide-copy h2 { margin-top: 24px; font-size: clamp(46px, 4vw, 76px); }
      .guide-copy > p:last-child { margin-top: 28px; font-family: var(--serif); font-size: 17px; line-height: 1.6; }
      .guide-choices { display: grid; align-content: start; border-top: 1px solid var(--line); }
      .guide-choices button { min-height: 76px; padding: 14px 4px; display: flex; align-items: center; gap: 18px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); font-family: var(--serif); font-size: 18px; text-align: left; cursor: pointer; }
      .guide-choices button span { color: var(--brass); font-size: 12px; font-style: italic; }
      .guide-choices button.is-active { color: var(--clay); padding-left: 16px; }
      .guide-result { min-height: 390px; padding: clamp(32px, 3vw, 52px); display: flex; flex-direction: column; background: var(--sage-dark); color: var(--paper); }
      .guide-result > p:first-child { color: #cfbd91; font-size: 9px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
      .guide-result strong { margin-top: 46px; font-family: var(--serif); font-size: clamp(31px, 2.4vw, 46px); font-weight: 400; line-height: 1; }
      .guide-result > span { width: 46px; height: 1px; margin: 26px 0; background: #c9b27c; }
      .guide-result > p:nth-of-type(2) { color: rgba(251,248,240,.82); font-family: var(--serif); font-size: 16px; line-height: 1.55; }
      .guide-result a { margin-top: 28px; font-family: var(--serif); font-size: 16px; text-underline-offset: 5px; }
      .guide-result small { margin-top: auto; padding-top: 34px; color: rgba(251,248,240,.55); font-size: 8px; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase; }

      .faq { padding-bottom: clamp(110px, 12vw, 210px); display: grid; grid-template-columns: .7fr 1.3fr; gap: 10vw; }
      .faq-heading h2 { margin-top: 24px; font-size: clamp(52px, 5vw, 90px); }
      .faq-list { border-top: 1px solid var(--line); }
      .faq-list details { border-bottom: 1px solid var(--line); }
      .faq-list summary { min-height: 88px; padding: 24px 48px 24px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; font-family: var(--serif); font-size: clamp(18px, 1.4vw, 23px); cursor: pointer; list-style: none; }
      .faq-list summary::-webkit-details-marker { display: none; }
      .faq-list summary::after { content: "+"; color: var(--clay); font-family: var(--sans); font-size: 18px; }
      .faq-list details[open] summary::after { content: "-"; }
      .faq-list details p { max-width: 720px; padding: 0 38px 28px 0; color: rgba(48,43,37,.75); font-family: var(--serif); font-size: 17px; line-height: 1.6; }

      .contact { padding: clamp(80px, 9vw, 150px) var(--gutter); display: grid; grid-template-columns: minmax(340px, .85fr) minmax(480px, 1.15fr); gap: 10vw; background: var(--clay); color: var(--paper); }
      .contact .eyebrow { color: #f0d8b6; }
      .contact h2 { max-width: 800px; margin-top: 24px; font-size: clamp(54px, 5.5vw, 100px); }
      .contact-copy > p:last-child { max-width: 560px; margin-top: 30px; color: rgba(251,248,240,.78); font-family: var(--serif); font-size: 18px; line-height: 1.55; }
      .contact form { align-self: center; }
      .contact label { display: grid; gap: 9px; font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
      .field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
      .contact input, .contact textarea { width: 100%; padding: 15px 0; border: 0; border-bottom: 1px solid rgba(251,248,240,.55); border-radius: 0; outline: 0; background: transparent; color: white; font-family: var(--serif); font-size: 18px; resize: vertical; }
      .contact textarea { margin-bottom: 22px; }
      .contact input::placeholder, .contact textarea::placeholder { color: rgba(251,248,240,.55); }
      .contact input:focus, .contact textarea:focus { border-color: white; }
      .contact form > label { margin-top: 32px; }
      .button--cream { background: var(--paper); color: var(--walnut); }
      .button--cream:hover, .button--cream:focus-visible { background: var(--sage-dark); color: white; }
      #form-status { margin-top: 18px; color: rgba(251,248,240,.68); font-size: 10px; letter-spacing: .06em; }

      footer { padding: 64px var(--gutter) 46px; display: grid; grid-template-columns: 1fr auto; gap: 48px; background: var(--walnut); color: var(--paper); }
      .footer-brand { display: inline-flex; width: max-content; flex-direction: column; text-decoration: none; }
      .footer-brand > span { color: #c9b27c; }
      .footer-brand strong { margin-top: 8px; font-family: var(--serif); font-size: 30px; font-weight: 400; letter-spacing: -.04em; }
      .footer-brand small { margin-top: 6px; font-size: 7px; font-weight: 700; letter-spacing: .25em; text-transform: uppercase; }
      footer nav { display: flex; align-items: center; gap: 36px; }
      footer nav a { font-size: 9px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; text-underline-offset: 5px; }
      footer > p { grid-column: 1 / -1; max-width: 1000px; padding-top: 34px; border-top: 1px solid rgba(251,248,240,.18); color: rgba(251,248,240,.55); font-size: 8px; letter-spacing: .1em; line-height: 1.7; text-transform: uppercase; }

      dialog { width: min(620px, calc(100vw - 40px)); padding: clamp(42px, 6vw, 72px); border: 0; border-radius: 180px 180px 8px 8px; background: var(--paper); color: var(--ink); box-shadow: 0 30px 100px rgba(20,20,15,.3); }
      dialog::backdrop { background: rgba(43,42,35,.72); backdrop-filter: blur(5px); }
      #dialog-close { position: absolute; top: 20px; left: 50%; min-height: 44px; border: 0; background: transparent; color: var(--walnut); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-decoration: underline; text-underline-offset: 4px; text-transform: uppercase; cursor: pointer; transform: translateX(-50%); }
      dialog .eyebrow { margin-top: 54px; text-align: center; }
      dialog h2 { margin-top: 22px; font-size: clamp(46px, 6vw, 70px); text-align: center; }
      dialog > p:not(.eyebrow) { margin-top: 28px; font-family: var(--serif); font-size: 18px; line-height: 1.6; text-align: center; }
      .dialog-note { margin-top: 34px; display: block; color: var(--clay); font-size: 8px; font-weight: 700; letter-spacing: .15em; text-align: center; text-transform: uppercase; }

      @media (max-width: 1180px) {
        .site-header { min-height: 96px; } .desktop-nav { gap: 22px; } .desktop-nav a { font-size: 9px; } .brand { min-width: 230px; }
        .hero { grid-template-columns: minmax(360px, 44%) minmax(0, 56%); } .hero-copy { padding-right: 44px; }
        .home-story { grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr); gap: 52px; }
        .home-story--cottage { grid-template-columns: minmax(320px, .8fr) minmax(0, 1.2fr); }
        .materials-layout { grid-template-columns: minmax(0, 1fr) minmax(400px, .95fr); gap: 52px; }
        .material-picker { grid-template-columns: 1fr; } .material-result { min-height: 260px; }
        .guide-card { grid-template-columns: 1fr 1fr; } .guide-result { grid-column: 1 / -1; min-height: 320px; }
      }

      @media (max-width: 900px) {
        html { scroll-padding-top: 78px; }
        .concept-note { justify-content: center; text-align: center; } .concept-note p { display: none; }
        .site-header { position: sticky; top: 0; min-height: 78px; grid-template-columns: 1fr auto; background: rgba(251,248,240,.96); backdrop-filter: blur(12px); }
        .desktop-nav { display: none; } .brand { min-width: 0; align-items: flex-start; } .brand-flourish { display: none; }
        .brand strong { font-size: 26px; } .brand small { font-size: 6px; }
        .mobile-menu { position: relative; display: block; justify-self: end; }
        .mobile-menu summary { width: 48px; height: 48px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 7px; cursor: pointer; list-style: none; }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu summary span { width: 27px; height: 1px; background: var(--walnut); }
        .mobile-menu summary span:last-child { width: 19px; }
        .mobile-menu[open] summary span:first-child { transform: translateY(4px) rotate(45deg); }
        .mobile-menu[open] summary span:last-child { width: 27px; transform: translateY(-4px) rotate(-45deg); }
        .mobile-menu nav { position: fixed; left: 0; right: 0; top: 110px; padding: 18px var(--gutter) 26px; display: grid; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px rgba(57,43,34,.12); }
        .mobile-menu nav a { min-height: 52px; display: flex; align-items: center; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 20px; text-decoration: none; }
        .hero { min-height: 0; grid-template-columns: 1fr; }
        .hero-media { grid-row: 1; min-height: 0; aspect-ratio: 4 / 3; border-radius: 0 0 140px 0; }
        .hero-copy { min-height: 590px; padding: 70px var(--gutter) 54px; }
        .hero-copy::before { display: none; }
