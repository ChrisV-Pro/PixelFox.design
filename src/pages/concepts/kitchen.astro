---
const title = "KANTER Kitchens | Fictional Kitchen Remodeling Concept";
const description = "A clean, modern Scandinavian-inspired kitchen remodeling website concept by PixelFox.design.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0754c6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pixelfox.design/concepts/kitchen/" />
    <meta property="og:image" content="https://pixelfox.design/images/kitchen/hero-1536.webp" />
    <link rel="canonical" href="https://pixelfox.design/concepts/kitchen/" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="concept-strip">
      <a href="/">A PixelFox.design concept</a>
      <p>Fictional company, projects, timelines, and prices</p>
    </div>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="KANTER Kitchens home">
        <span class="brand-mark" aria-hidden="true">K</span>
        <span><strong>KANTER</strong><small>Kitchen planning + renovation</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#kitchens">Kitchens</a>
        <a href="#process">How it works</a>
        <a href="#materials">Materials</a>
        <a href="#planner">Budget planner</a>
      </nav>
      <a class="header-cta" href="#contact">Plan your kitchen <span aria-hidden="true">&#8594;</span></a>
      <details class="mobile-menu">
        <summary aria-label="Open menu"><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#kitchens">Kitchens</a>
          <a href="#process">How it works</a>
          <a href="#materials">Materials</a>
          <a href="#planner">Budget planner</a>
          <a href="#contact">Plan your kitchen</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Kitchen remodeling, simplified</p>
          <h1 id="hero-title">Less clutter.<br /><span>More kitchen.</span></h1>
          <p class="hero-intro">Clear plans, smart storage, and one coordinated build. We shape modern kitchens around the way a home actually works.</p>
          <div class="hero-actions">
            <a class="button button--blue" href="#planner">Build a concept budget</a>
            <a class="text-link" href="#kitchens">See three directions <span aria-hidden="true">&#8595;</span></a>
          </div>
          <p class="concept-note"><strong>Concept 06</strong><span>Original imagery and an illustrative customer journey for a fictional remodeler.</span></p>
        </div>
        <figure class="hero-image">
          <picture>
            <source
              sizes="(max-width: 880px) 100vw, 52vw"
              srcset="/images/kitchen/hero-800.avif 800w, /images/kitchen/hero-1536.avif 1536w"
              type="image/avif"
            />
            <source
              sizes="(max-width: 880px) 100vw, 52vw"
              srcset="/images/kitchen/hero-800.webp 800w, /images/kitchen/hero-1536.webp 1536w"
              type="image/webp"
            />
            <img
              alt="Bright modern kitchen with flat white cabinetry, a pale oak island, and a blue stool"
              decoding="async"
              fetchpriority="high"
              height="1024"
              src="/images/kitchen/hero-1536.webp"
              width="1536"
            />
          </picture>
          <figcaption>Original AI-generated concept photography</figcaption>
        </figure>
      </section>

      <section class="service-rail" aria-label="Concept remodeling services">
        <p><span>01</span><strong>Measure</strong>Start with the room</p>
        <p><span>02</span><strong>Plan</strong>Make every inch useful</p>
        <p><span>03</span><strong>Specify</strong>Choose fewer, better materials</p>
        <p><span>04</span><strong>Build</strong>Keep one clear scope</p>
      </section>

      <section class="statement section" aria-labelledby="statement-title">
        <div class="section-number" aria-hidden="true">01</div>
        <div>
          <p class="eyebrow">Function before fuss</p>
          <h2 id="statement-title">Your kitchen should solve the morning rush before it tries to impress anyone.</h2>
        </div>
        <p class="statement-copy">KANTER is a fictional, full-service remodeling studio built around straightforward decisions. The concept pairs clean Scandinavian utility with local project coordination, so the experience feels organized from first measure to final fit.</p>
      </section>

      <section class="kitchens section" id="kitchens" aria-labelledby="kitchens-title">
        <header class="section-head">
          <div>
            <p class="eyebrow">Three kitchen directions</p>
            <h2 id="kitchens-title">Pick a system.<br />Make it yours.</h2>
          </div>
          <p>Each fictional direction starts with a clear material logic, then adapts to the room, storage needs, and daily routine.</p>
        </header>

        <div class="project-grid">
          <article class="project-card project-card--wide">
            <picture>
              <source sizes="(max-width: 760px) 100vw, 62vw" srcset="/images/kitchen/oak-galley-720.avif 720w, /images/kitchen/oak-galley-1440.avif 1440w" type="image/avif" />
              <source sizes="(max-width: 760px) 100vw, 62vw" srcset="/images/kitchen/oak-galley-720.webp 720w, /images/kitchen/oak-galley-1440.webp 1440w" type="image/webp" />
              <img alt="Pale oak Scandinavian galley kitchen with stainless worktop and breakfast ledge" decoding="async" height="960" loading="lazy" src="/images/kitchen/oak-galley-1440.webp" width="1440" />
            </picture>
            <div class="project-copy">
              <span>01 / Pale oak</span>
              <h3>LINEA</h3>
              <p>A light, hardworking galley system for narrow rooms that need more storage without more visual weight.</p>
              <button type="button" data-project="LINEA">View concept details <span aria-hidden="true">+</span></button>
            </div>
          </article>

          <article class="project-card">
            <picture>
              <source sizes="(max-width: 760px) 100vw, 38vw" srcset="/images/kitchen/cobalt-kitchen-720.avif 720w, /images/kitchen/cobalt-kitchen-1440.avif 1440w" type="image/avif" />
              <source sizes="(max-width: 760px) 100vw, 38vw" srcset="/images/kitchen/cobalt-kitchen-720.webp 720w, /images/kitchen/cobalt-kitchen-1440.webp 1440w" type="image/webp" />
              <img alt="Cobalt blue family kitchen with white counters and a pale oak island" decoding="async" height="960" loading="lazy" src="/images/kitchen/cobalt-kitchen-1440.webp" width="1440" />
            </picture>
            <div class="project-copy">
              <span>02 / Cobalt + oak</span>
              <h3>BLOCK</h3>
              <p>Color with discipline: bold cabinetry, calm work surfaces, and a central island made for busy family use.</p>
              <button type="button" data-project="BLOCK">View concept details <span aria-hidden="true">+</span></button>
            </div>
          </article>

          <article class="project-card project-card--horizontal">
            <picture>
              <source sizes="(max-width: 760px) 100vw, 55vw" srcset="/images/kitchen/mono-kitchen-720.avif 720w, /images/kitchen/mono-kitchen-1440.avif 1440w" type="image/avif" />
              <source sizes="(max-width: 760px) 100vw, 55vw" srcset="/images/kitchen/mono-kitchen-720.webp 720w, /images/kitchen/mono-kitchen-1440.webp 1440w" type="image/webp" />
              <img alt="Minimal black and white kitchen with a pale oak shelf and square cabinet grid" decoding="async" height="960" loading="lazy" src="/images/kitchen/mono-kitchen-1440.webp" width="1440" />
            </picture>
            <div class="project-copy">
              <span>03 / Black + white</span>
              <h3>FRAME</h3>
              <p>A graphic, compact system that keeps appliances, prep space, and storage in one sharp visual line.</p>
              <button type="button" data-project="FRAME">View concept details <span aria-hidden="true">+</span></button>
            </div>
          </article>
        </div>
      </section>

      <section class="process section" id="process" aria-labelledby="process-title">
        <header>
          <p class="eyebrow">A cleaner way to remodel</p>
          <h2 id="process-title">Four stages.<br />No mystery.</h2>
          <p>Every figure and timeline below is illustrative, but the experience is intentionally direct.</p>
        </header>
        <ol>
          <li><span>01</span><div><h3>Measure the room</h3><p>Map walls, services, light, movement, and the storage that is not working now.</p></div></li>
          <li><span>02</span><div><h3>Set the system</h3><p>Choose a layout direction, cabinet logic, and practical working zones.</p></div></li>
          <li><span>03</span><div><h3>Lock the details</h3><p>Confirm surfaces, hardware, appliances, scope, sequence, and concept budget.</p></div></li>
          <li><span>04</span><div><h3>Coordinate the build</h3><p>Keep decisions visible and finish with a final fit-and-function review.</p></div></li>
        </ol>
      </section>

      <section class="materials section" id="materials" aria-labelledby="materials-title">
        <figure>
          <picture>
            <source sizes="(max-width: 840px) 100vw, 48vw" srcset="/images/kitchen/materials-560.avif 560w, /images/kitchen/materials-1024.avif 1024w" type="image/avif" />
            <source sizes="(max-width: 840px) 100vw, 48vw" srcset="/images/kitchen/materials-560.webp 560w, /images/kitchen/materials-1024.webp 1024w" type="image/webp" />
            <img alt="Modern kitchen material samples arranged in a precise grid" decoding="async" height="1024" loading="lazy" src="/images/kitchen/materials-1024.webp" width="1024" />
          </picture>
          <figcaption>Concept material board</figcaption>
        </figure>
        <div class="material-copy">
          <p class="eyebrow">Material library</p>
          <h2 id="materials-title">Touch every decision.</h2>
          <p>Start with one cabinet tone, one work surface, and one honest accent. Fewer materials make the room calmer and the choices clearer.</p>
          <div class="material-selector" role="group" aria-label="Preview concept material palettes">
            <button class="is-active" type="button" data-material="Pale oak / White quartz" data-description="Quiet grain, soft reflection, and the lightest visual footprint."><i class="swatch swatch--oak"></i><span>01</span>Pale oak</button>
            <button type="button" data-material="Cobalt / Pale oak" data-description="A confident cabinet color balanced by a warm, natural island."><i class="swatch swatch--blue"></i><span>02</span>Cobalt</button>
            <button type="button" data-material="Black / Warm white" data-description="High contrast, exact lines, and a compact architectural feel."><i class="swatch swatch--black"></i><span>03</span>Mono</button>
          </div>
          <div class="material-result" aria-live="polite">
            <span>Selected concept palette</span>
            <strong id="material-name">Pale oak / White quartz</strong>
            <p id="material-description">Quiet grain, soft reflection, and the lightest visual footprint.</p>
          </div>
        </div>
      </section>

      <section class="planner section" id="planner" aria-labelledby="planner-title">
        <header>
          <p class="eyebrow">Concept budget planner</p>
          <h2 id="planner-title">Start with the size.<br />See the range.</h2>
          <p>This interactive estimate demonstrates how a real remodeling site could qualify leads. It is not a quote or offer.</p>
        </header>
        <div class="planner-card">
          <div class="planner-options">
            <fieldset>
              <legend>1. Room scale</legend>
              <div class="choice-grid">
                <button class="is-active" type="button" data-room="compact" aria-pressed="true"><span>Compact</span><small>Up to 140 sq. ft.</small></button>
                <button type="button" data-room="classic" aria-pressed="false"><span>Classic</span><small>140 to 220 sq. ft.</small></button>
                <button type="button" data-room="expansive" aria-pressed="false"><span>Expansive</span><small>220+ sq. ft.</small></button>
              </div>
            </fieldset>
            <fieldset>
              <legend>2. Finish level</legend>
              <div class="choice-grid">
                <button class="is-active" type="button" data-finish="essential" aria-pressed="true"><span>Essential</span><small>Simple + durable</small></button>
                <button type="button" data-finish="select" aria-pressed="false"><span>Select</span><small>More material choice</small></button>
                <button type="button" data-finish="tailored" aria-pressed="false"><span>Tailored</span><small>Custom details</small></button>
              </div>
            </fieldset>
          </div>
          <div class="estimate" aria-live="polite">
            <span>Illustrative investment</span>
            <strong id="estimate-range">$38k - $52k</strong>
            <div class="estimate-bar"><i id="estimate-progress"></i></div>
            <dl>
              <div><dt>Concept timeline</dt><dd id="estimate-time">7 - 9 weeks</dd></div>
              <div><dt>Planning stage</dt><dd>2 - 3 weeks</dd></div>
              <div><dt>Real quote?</dt><dd>No, demonstration only</dd></div>
            </dl>
            <a class="button button--black" href="#contact">Bring us your room</a>
          </div>
        </div>
      </section>

      <section class="principles section" aria-labelledby="principles-title">
        <p class="eyebrow">The KANTER idea</p>
        <h2 id="principles-title">Straight lines.<br />Straight answers.</h2>
        <div class="principle-grid">
          <article><span>01</span><h3>Useful first</h3><p>Storage, movement, light, and cleaning guide the room before decoration does.</p></article>
          <article><span>02</span><h3>Visible choices</h3><p>Keep the scope, allowances, and open decisions in one understandable place.</p></article>
          <article><span>03</span><h3>Calm materials</h3><p>Use a small palette well instead of asking the room to carry every trend.</p></article>
        </div>
      </section>

      <section class="faq section" aria-labelledby="faq-title">
        <div>
          <p class="eyebrow">Before the first measure</p>
          <h2 id="faq-title">Useful questions.</h2>
        </div>
        <div class="faq-list">
          <details><summary>Is KANTER a real remodeling company?</summary><p>No. KANTER Kitchens is a fictional website concept created by PixelFox.design.</p></details>
          <details><summary>Are the prices and project details real?</summary><p>No. Budgets, timelines, services, and named kitchen systems are illustrative design content only.</p></details>
          <details><summary>Where did the kitchen photography come from?</summary><p>The photographs are original AI-generated concept imagery created specifically for this portfolio exercise.</p></details>
        </div>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">Start with your room</p>
          <h2 id="contact-title">Show us what is not working.</h2>
        </div>
        <form id="contact-form">
          <label for="contact-email">Email address</label>
          <div><input id="contact-email" type="email" placeholder="you@example.com" required /><button type="submit">Start concept brief</button></div>
          <p id="form-status" role="status">Demo only. Nothing is sent or saved.</p>
        </form>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top"><span>K</span><strong>KANTER</strong></a>
      <nav aria-label="Footer navigation"><a href="#kitchens">Kitchens</a><a href="#process">Process</a><a href="#planner">Planner</a><a href="/">PixelFox.design</a></nav>
      <p>KANTER Kitchens is a fictional remodeling company concept by PixelFox.design. Projects, services, materials, timelines, budgets, and photography are presented only as design examples. No services are offered through this page.</p>
    </footer>

    <dialog id="project-dialog" aria-labelledby="dialog-title">
      <button id="dialog-close" type="button">Close</button>
      <p class="eyebrow">Fictional kitchen system</p>
      <h2 id="dialog-title">LINEA</h2>
      <p id="dialog-copy">A focused pale-oak direction for compact rooms.</p>
      <a class="button button--blue" href="#planner">Try the concept planner</a>
    </dialog>

    <p class="toast" id="toast" role="status" aria-live="polite"></p>

    <script>
      const materialButtons = [...document.querySelectorAll("[data-material]")];
      const materialName = document.querySelector("#material-name");
      const materialDescription = document.querySelector("#material-description");

      materialButtons.forEach((button) => {
        button.addEventListener("click", () => {
          materialButtons.forEach((item) => item.classList.remove("is-active"));
          button.classList.add("is-active");
          materialName.textContent = button.dataset.material;
          materialDescription.textContent = button.dataset.description;
        });
      });

      const estimates = {
        compact: { essential: [38, 52, "7 - 9 weeks", 30], select: [50, 66, "8 - 10 weeks", 42], tailored: [64, 84, "10 - 12 weeks", 55] },
        classic: { essential: [54, 78, "9 - 12 weeks", 48], select: [68, 96, "10 - 13 weeks", 62], tailored: [86, 122, "12 - 15 weeks", 76] },
        expansive: { essential: [82, 112, "12 - 16 weeks", 68], select: [104, 144, "14 - 18 weeks", 82], tailored: [132, 184, "16 - 22 weeks", 96] },
      };
      let room = "compact";
      let finish = "essential";

      const updateEstimate = () => {
        const [low, high, time, progress] = estimates[room][finish];
        document.querySelector("#estimate-range").textContent = `$${low}k - $${high}k`;
        document.querySelector("#estimate-time").textContent = time;
        document.querySelector("#estimate-progress").style.width = `${progress}%`;
      };

      document.querySelectorAll("[data-room]").forEach((button) => {
        button.addEventListener("click", () => {
          room = button.dataset.room;
          document.querySelectorAll("[data-room]").forEach((item) => {
            const active = item === button;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-pressed", String(active));
          });
          updateEstimate();
        });
      });

      document.querySelectorAll("[data-finish]").forEach((button) => {
        button.addEventListener("click", () => {
          finish = button.dataset.finish;
          document.querySelectorAll("[data-finish]").forEach((item) => {
            const active = item === button;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-pressed", String(active));
          });
          updateEstimate();
        });
      });

      const projects = {
        LINEA: "A focused pale-oak direction for compact rooms, with continuous storage and a light visual footprint.",
        BLOCK: "A high-contrast family kitchen centered on cobalt cabinetry, a pale-oak island, and clearly defined work zones.",
        FRAME: "A graphic black-and-white system that organizes appliances, prep, and storage into one exact line.",
      };
      const dialog = document.querySelector("#project-dialog");
      document.querySelectorAll("[data-project]").forEach((button) => {
        button.addEventListener("click", () => {
          const project = button.dataset.project;
          document.querySelector("#dialog-title").textContent = project;
          document.querySelector("#dialog-copy").textContent = projects[project];
          dialog.showModal();
        });
      });
      document.querySelector("#dialog-close").addEventListener("click", () => dialog.close());

      document.querySelector("#contact-form").addEventListener("submit", (event) => {
        event.preventDefault();
        document.querySelector("#form-status").textContent = "Concept brief prepared. Nothing was sent or saved.";
        const toast = document.querySelector("#toast");
        toast.textContent = "Concept brief ready. This demonstration did not send any information.";
        toast.classList.add("is-visible");
        window.setTimeout(() => toast.classList.remove("is-visible"), 3200);
      });

      document.querySelectorAll(".mobile-menu a").forEach((link) => {
        link.addEventListener("click", () => link.closest("details").removeAttribute("open"));
      });
    </script>

    <style>
      :root {
        --blue: #0754c6;
        --blue-dark: #053b8c;
        --yellow: #ffd324;
        --ink: #111111;
        --paper: #ffffff;
        --warm: #f4f2eb;
        --line: #c9c7bf;
        --muted: #686761;
        --font: "Aptos", "Trebuchet MS", sans-serif;
        --display: "Bahnschrift", "Aptos Display", "Trebuchet MS", sans-serif;
        --gutter: clamp(20px, 4vw, 72px);
        --page-max: 2200px;
        --wide-max: 2560px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 104px; }
      body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--paper); font-family: var(--font); font-size: 16px; line-height: 1.45; }
      body, button, input { font-family: var(--font); }
      button, input { color: inherit; }
      button, summary, a { -webkit-tap-highlight-color: transparent; }
      button, summary { cursor: pointer; }
      a { color: inherit; text-decoration: none; }
      img { width: 100%; height: auto; display: block; }
      picture { display: block; }
      h1, h2, h3, p { margin-top: 0; }
      h1, h2, h3 { margin-bottom: 0; font-family: var(--display); font-weight: 700; letter-spacing: -0.055em; line-height: 0.9; }
      fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
      .skip-link { position: fixed; z-index: 999; top: 0; left: 0; padding: 12px 16px; color: var(--paper); background: var(--ink); transform: translateY(-110%); }
      .skip-link:focus { transform: translateY(0); }
      .concept-strip { min-height: 30px; padding: 6px max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--paper); background: var(--ink); font-size: 9px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
      .concept-strip a { text-decoration: underline; text-underline-offset: 3px; }
      .concept-strip p { margin: 0; }

      .site-header { position: sticky; z-index: 100; top: 0; width: 100%; min-height: 86px; padding: 0 max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(28px, 4vw, 72px); border-bottom: 1px solid var(--ink); background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px); }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; color: var(--ink); background: var(--yellow); font-family: var(--display); font-size: 23px; font-weight: 800; }
      .brand > span:last-child { display: flex; flex-direction: column; }
      .brand strong { font-family: var(--display); font-size: 24px; letter-spacing: -0.04em; line-height: 1; }
      .brand small { margin-top: 4px; font-size: 7px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .desktop-nav { justify-self: center; display: flex; align-items: center; gap: clamp(20px, 2.8vw, 48px); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .desktop-nav a { position: relative; padding: 34px 0 32px; }
      .desktop-nav a::after { position: absolute; right: 0; bottom: 24px; left: 0; height: 2px; background: var(--blue); content: ""; transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
      .desktop-nav a:hover::after { transform: scaleX(1); }
      .header-cta, .button { min-height: 50px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: center; gap: 28px; border: 1px solid currentColor; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
      .header-cta { color: var(--paper); background: var(--blue); }
      .header-cta span { font-size: 18px; }
      .mobile-menu { display: none; }

      .hero { width: min(100%, var(--wide-max)); height: clamp(560px, calc(100svh - 116px), 860px); margin-inline: auto; display: grid; grid-template-columns: minmax(520px, 0.96fr) minmax(0, 1.04fr); border-bottom: 1px solid var(--ink); }
      .hero-copy { min-width: 0; padding: clamp(54px, 5vw, 90px) clamp(38px, 5vw, 86px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; background: var(--warm); }
      .eyebrow { margin-bottom: 24px; color: var(--blue); font-size: 10px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; }
      .hero h1 { max-width: 850px; font-size: clamp(64px, 7vw, 118px); }
      .hero h1 span { color: var(--blue); }
      .hero-intro { max-width: 620px; margin: 34px 0 36px; font-size: clamp(17px, 1.35vw, 21px); line-height: 1.55; }
      .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
      .button--blue { color: var(--paper); background: var(--blue); border-color: var(--blue); }
      .button--black { color: var(--paper); background: var(--ink); border-color: var(--ink); }
      .text-link { padding-bottom: 5px; border-bottom: 2px solid var(--ink); font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
      .text-link span { margin-left: 12px; }
      .concept-note { width: min(100%, 620px); margin: auto 0 0; padding-top: 22px; display: grid; grid-template-columns: 95px 1fr; gap: 22px; border-top: 1px solid var(--line); font-size: 12px; }
      .concept-note strong { color: var(--blue); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
      .hero-image { position: relative; min-width: 0; margin: 0; overflow: hidden; background: #ddd8cb; }
      .hero-image picture, .hero-image img { width: 100%; height: 100%; }
      .hero-image img { object-fit: cover; object-position: 61% center; }
      .hero-image figcaption { position: absolute; right: 0; bottom: 0; padding: 10px 14px; color: var(--paper); background: var(--ink); font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; }

      .service-rail { padding: 0 max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: grid; grid-template-columns: repeat(4, 1fr); color: var(--paper); background: var(--blue); }
      .service-rail p { min-height: 110px; margin: 0; padding: 24px 28px; display: grid; grid-template-columns: auto 1fr; align-content: center; gap: 2px 18px; border-right: 1px solid rgba(255,255,255,0.32); font-size: 12px; }
      .service-rail p:last-child { border-right: 0; }
      .service-rail span { grid-row: 1 / 3; color: var(--yellow); font-size: 10px; font-weight: 800; }
      .service-rail strong { font-family: var(--display); font-size: 20px; letter-spacing: -0.02em; }

      .section { padding: clamp(72px, 7vw, 128px) max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); }
      .statement { display: grid; grid-template-columns: 120px minmax(0, 1.3fr) minmax(320px, 0.7fr); align-items: end; gap: clamp(34px, 5vw, 90px); }
      .section-number { width: 92px; height: 92px; display: grid; place-items: center; background: var(--yellow); font-family: var(--display); font-size: 28px; font-weight: 800; }
      .statement h2 { max-width: 1120px; font-size: clamp(50px, 6vw, 94px); }
      .statement-copy { max-width: 600px; margin: 0; font-size: 17px; line-height: 1.7; }

      .kitchens { background: var(--warm); }
      .section-head { margin-bottom: clamp(48px, 6vw, 90px); display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); align-items: end; gap: clamp(40px, 7vw, 120px); }
      .section-head h2, .process h2, .material-copy h2, .planner h2, .principles h2, .faq h2, .contact h2 { font-size: clamp(54px, 6vw, 94px); }
      .section-head > p { max-width: 600px; margin: 0; font-size: 16px; line-height: 1.7; }
      .project-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; }
      .project-card { grid-column: span 5; min-width: 0; display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--ink); background: var(--paper); }
      .project-card--wide { grid-column: span 7; }
      .project-card--horizontal { grid-column: 1 / -1; grid-template-columns: 1.4fr 0.6fr; grid-template-rows: none; }
      .project-card picture { aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--ink); }
      .project-card--wide picture { aspect-ratio: 16 / 10; }
      .project-card--horizontal picture { min-height: 470px; aspect-ratio: auto; border-right: 1px solid var(--ink); border-bottom: 0; }
      .project-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
      .project-card:hover img { transform: scale(1.025); }
      .project-copy { min-width: 0; padding: clamp(26px, 3vw, 46px); display: flex; flex-direction: column; align-items: flex-start; }
      .project-copy > span { margin-bottom: 22px; color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
      .project-copy h3 { font-size: clamp(42px, 4.8vw, 72px); letter-spacing: -0.045em; }
      .project-copy p { max-width: 580px; margin: 20px 0 34px; line-height: 1.65; }
      .project-copy button { width: 100%; min-height: 48px; margin-top: auto; padding: 0; display: flex; align-items: center; justify-content: space-between; border: 0; border-top: 1px solid var(--ink); background: transparent; font-size: 9px; font-weight: 800; letter-spacing: 0.11em; text-align: left; text-transform: uppercase; }
      .project-copy button span { font-size: 20px; font-weight: 400; }

      .process { display: grid; grid-template-columns: minmax(360px, 0.72fr) minmax(0, 1.28fr); gap: clamp(60px, 9vw, 160px); color: var(--paper); background: var(--blue); }
      .process .eyebrow { color: var(--yellow); }
      .process header > p:last-child { max-width: 520px; margin: 30px 0 0; }
      .process ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,0.42); }
      .process li { padding: 30px 0; display: grid; grid-template-columns: 70px 1fr; gap: 26px; border-bottom: 1px solid rgba(255,255,255,0.42); }
      .process li > span { width: 48px; height: 48px; display: grid; place-items: center; color: var(--ink); background: var(--yellow); font-size: 11px; font-weight: 800; }
      .process h3 { font-size: clamp(28px, 2.8vw, 42px); letter-spacing: -0.035em; line-height: 1; }
      .process li p { max-width: 660px; margin: 12px 0 0; color: rgba(255,255,255,0.8); }

      .materials { display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, 0.92fr); gap: clamp(50px, 7vw, 120px); align-items: center; }
      .materials figure { position: relative; margin: 0; border: 1px solid var(--ink); }
      .materials figcaption { position: absolute; right: 0; bottom: 0; padding: 9px 13px; color: var(--paper); background: var(--ink); font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; }
      .material-copy > p:not(.eyebrow) { max-width: 660px; margin: 30px 0 40px; font-size: 17px; line-height: 1.7; }
      .material-selector { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--ink); }
      .material-selector button { min-width: 0; min-height: 128px; padding: 15px; display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; border: 0; border-right: 1px solid var(--ink); background: var(--paper); font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
      .material-selector button:last-child { border-right: 0; }
      .material-selector button.is-active { color: var(--paper); background: var(--blue); }
      .material-selector button span { color: var(--muted); }
      .material-selector button.is-active span { color: var(--yellow); }
      .swatch { width: 42px; height: 42px; display: block; border: 1px solid var(--ink); background: #d7b887; }
      .swatch--blue { background: #174982; }
      .swatch--black { background: #191919; }
      .material-result { padding: 26px; border: 1px solid var(--ink); border-top: 0; }
      .material-result span { display: block; margin-bottom: 9px; color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
      .material-result strong { font-family: var(--display); font-size: 28px; letter-spacing: -0.03em; }
      .material-result p { margin: 8px 0 0; color: var(--muted); }

      .planner { background: var(--yellow); }
      .planner > header { margin-bottom: 52px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr); align-items: end; gap: 70px; }
      .planner .eyebrow { color: var(--ink); }
      .planner > header > p:last-child { max-width: 560px; margin: 0; }
      .planner-card { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(360px, 0.7fr); border: 1px solid var(--ink); background: var(--paper); }
      .planner-options { padding: clamp(32px, 4vw, 64px); display: grid; gap: 48px; border-right: 1px solid var(--ink); }
      .planner-options legend { margin-bottom: 18px; font-size: 10px; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
      .choice-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--ink); }
      .choice-grid button { min-height: 112px; padding: 20px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; border: 0; border-right: 1px solid var(--ink); background: var(--paper); text-align: left; }
      .choice-grid button:last-child { border-right: 0; }
      .choice-grid button.is-active { color: var(--paper); background: var(--blue); }
      .choice-grid span { font-family: var(--display); font-size: 24px; font-weight: 700; letter-spacing: -0.03em; }
      .choice-grid small { margin-top: 8px; color: var(--muted); font-size: 10px; }
      .choice-grid button.is-active small { color: rgba(255,255,255,0.76); }
      .estimate { padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; align-items: flex-start; background: var(--warm); }
      .estimate > span { color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
      .estimate > strong { margin: 20px 0 30px; font-family: var(--display); font-size: clamp(44px, 4.2vw, 66px); letter-spacing: -0.055em; line-height: 0.95; }
      .estimate-bar { width: 100%; height: 12px; background: #d8d5ca; }
      .estimate-bar i { width: 30%; height: 100%; display: block; background: var(--blue); transition: width 260ms ease; }
      .estimate dl { width: 100%; margin: 30px 0 40px; }
      .estimate dl div { padding: 14px 0; display: flex; justify-content: space-between; gap: 30px; border-top: 1px solid var(--line); }
      .estimate dt { font-size: 11px; font-weight: 800; text-transform: uppercase; }
      .estimate dd { margin: 0; text-align: right; }
      .estimate .button { margin-top: auto; }

      .principles { color: var(--paper); background: var(--ink); }
      .principles .eyebrow { color: var(--yellow); }
      .principles h2 { max-width: 1050px; }
      .principle-grid { margin-top: 70px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,0.4); border-bottom: 1px solid rgba(255,255,255,0.4); }
      .principle-grid article { min-height: 270px; padding: 30px; border-right: 1px solid rgba(255,255,255,0.4); }
      .principle-grid article:last-child { border-right: 0; }
      .principle-grid span { color: var(--yellow); font-size: 10px; font-weight: 800; }
      .principle-grid h3 { margin-top: 62px; font-size: clamp(32px, 3.4vw, 50px); }
      .principle-grid p { max-width: 450px; margin: 18px 0 0; color: rgba(255,255,255,0.74); }

      .faq { display: grid; grid-template-columns: minmax(320px, 0.7fr) minmax(0, 1.3fr); gap: clamp(60px, 9vw, 150px); }
      .faq-list { border-top: 1px solid var(--ink); }
      .faq details { border-bottom: 1px solid var(--ink); }
      .faq summary { min-height: 82px; padding: 22px 54px 22px 0; display: flex; align-items: center; position: relative; list-style: none; font-family: var(--display); font-size: 22px; font-weight: 700; letter-spacing: -0.025em; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { position: absolute; right: 4px; color: var(--blue); font-size: 24px; content: "+"; }
      .faq details[open] summary::after { content: "-"; }
      .faq details p { max-width: 720px; margin: 0 0 26px; color: var(--muted); }

      .contact { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr); align-items: end; gap: clamp(50px, 8vw, 140px); color: var(--paper); background: var(--blue); }
      .contact .eyebrow { color: var(--yellow); }
      .contact h2 { max-width: 1050px; }
      .contact label { display: block; margin-bottom: 10px; font-size: 9px; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
      .contact form > div { display: grid; grid-template-columns: 1fr auto; }
      .contact input { min-width: 0; min-height: 56px; padding: 0 17px; border: 1px solid var(--paper); background: transparent; font-size: 16px; }
      .contact input::placeholder { color: rgba(255,255,255,0.65); }
      .contact button { min-height: 56px; padding: 0 24px; border: 1px solid var(--paper); color: var(--ink); background: var(--yellow); font-size: 9px; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
      .contact form > p { margin: 10px 0 0; font-size: 10px; }

      footer { padding: 52px max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)) 32px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 42px; color: var(--paper); background: var(--ink); }
      .footer-brand { display: flex; align-items: center; gap: 12px; font-family: var(--display); font-size: 28px; letter-spacing: -0.04em; }
      .footer-brand span { width: 40px; height: 40px; display: grid; place-items: center; color: var(--ink); background: var(--yellow); font-size: 22px; }
      footer nav { display: flex; gap: 30px; font-size: 9px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
      footer > p { grid-column: 1 / -1; max-width: 1100px; margin: 0; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.3); color: rgba(255,255,255,0.7); font-size: 9px; letter-spacing: 0.07em; text-transform: uppercase; }

      dialog { width: min(560px, calc(100% - 32px)); padding: 42px; border: 1px solid var(--ink); color: var(--ink); background: var(--paper); box-shadow: 20px 20px 0 var(--yellow); }
      dialog::backdrop { background: rgba(0,0,0,0.62); }
      dialog > button:first-child { float: right; padding: 0 0 3px; border: 0; border-bottom: 1px solid var(--ink); background: transparent; font-size: 9px; font-weight: 800; text-transform: uppercase; }
      dialog h2 { font-size: 70px; }
      dialog > p:not(.eyebrow) { margin: 24px 0 32px; }
      .toast { position: fixed; z-index: 300; right: 20px; bottom: 20px; max-width: min(420px, calc(100% - 40px)); margin: 0; padding: 16px 20px; color: var(--ink); background: var(--yellow); border: 1px solid var(--ink); font-size: 12px; opacity: 0; transform: translateY(18px); transition: 180ms ease; pointer-events: none; }
      .toast.is-visible { opacity: 1; transform: translateY(0); }

      @media (min-width: 2200px) {
        .site-header { min-height: 96px; }
        .hero { height: min(980px, calc(100svh - 126px)); }
        .hero h1 { font-size: 128px; }
        .hero-intro { font-size: 22px; }
        .project-copy h3 { font-size: 76px; }
      }

      @media (max-width: 1180px) {
        .desktop-nav { gap: 20px; }
        .desktop-nav a:nth-child(4) { display: none; }
        .hero { grid-template-columns: minmax(430px, 0.96fr) minmax(0, 1.04fr); }
        .hero-copy { padding: 48px 38px; }
        .hero h1 { font-size: clamp(58px, 7vw, 78px); }
        .statement { grid-template-columns: 92px 1fr; }
        .statement-copy { grid-column: 2; }
        .project-card--horizontal { grid-template-columns: 1.15fr 0.85fr; }
        .process { grid-template-columns: 0.8fr 1.2fr; gap: 60px; }
        .materials { grid-template-columns: 1fr 1fr; gap: 50px; }
        .material-selector button { min-height: 116px; padding: 12px; }
        .planner-card { grid-template-columns: 1fr 0.72fr; }
      }

      @media (max-width: 920px) {
        .site-header { grid-template-columns: auto 1fr auto; }
        .desktop-nav { display: none; }
        .header-cta { justify-self: end; }
        .hero { height: auto; grid-template-columns: 1fr; }
        .hero-copy { min-height: 640px; }
        .hero h1 { font-size: clamp(68px, 12vw, 96px); }
        .hero-image { min-height: 560px; }
        .service-rail { grid-template-columns: 1fr 1fr; }
        .service-rail p:nth-child(2) { border-right: 0; }
        .service-rail p:nth-child(-n + 2) { border-bottom: 1px solid rgba(255,255,255,0.32); }
        .statement { grid-template-columns: 76px 1fr; }
        .section-number { width: 68px; height: 68px; font-size: 22px; }
        .section-head { grid-template-columns: 1fr; gap: 28px; }
        .project-card, .project-card--wide { grid-column: span 6; }
        .project-card--horizontal { grid-column: 1 / -1; }
        .process { grid-template-columns: 1fr; }
        .process header > p:last-child { max-width: 680px; }
        .materials { grid-template-columns: 1fr; }
        .material-copy { max-width: 720px; }
        .planner > header { grid-template-columns: 1fr; gap: 28px; }
        .planner-card { grid-template-columns: 1fr; }
        .planner-options { border-right: 0; border-bottom: 1px solid var(--ink); }
        .faq { grid-template-columns: 1fr; gap: 44px; }
        .contact { grid-template-columns: 1fr; }
      }

      @media (max-width: 640px) {
        html { scroll-padding-top: 72px; }
        .concept-strip { min-height: 32px; padding: 6px 12px; justify-content: center; text-align: center; }
        .concept-strip a { display: none; }
        .site-header { min-height: 72px; padding: 0 16px; grid-template-columns: 1fr auto; gap: 12px; }
        .brand-mark { width: 36px; height: 36px; font-size: 20px; }
        .brand strong { font-size: 21px; }
        .brand small { font-size: 6px; }
        .header-cta { display: none; }
        .mobile-menu { display: block; }
        .mobile-menu summary { width: 42px; height: 42px; display: grid; place-items: center; list-style: none; }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu summary span, .mobile-menu summary span::before, .mobile-menu summary span::after { width: 24px; height: 2px; display: block; background: var(--ink); content: ""; }
        .mobile-menu summary span::before { transform: translateY(-7px); }
        .mobile-menu summary span::after { transform: translateY(5px); }
        .mobile-menu nav { position: absolute; top: 72px; right: 0; left: 0; padding: 0 18px 18px; display: grid; background: var(--paper); border-bottom: 1px solid var(--ink); }
        .mobile-menu nav a { min-height: 50px; display: flex; align-items: center; border-bottom: 1px solid var(--line); font-family: var(--display); font-size: 20px; font-weight: 700; }
        .hero-copy { min-height: 0; padding: 54px 20px 42px; }
        .hero h1 { font-size: clamp(52px, 16vw, 70px); }
        .hero-intro { margin: 28px 0 30px; font-size: 16px; }
        .hero-actions { width: 100%; align-items: stretch; flex-direction: column; }
        .hero-actions .button { width: 100%; }
        .text-link { align-self: flex-start; }
        .concept-note { margin-top: 38px; grid-template-columns: 1fr; gap: 7px; }
        .hero-image { min-height: 0; }
        .hero-image picture { aspect-ratio: 4 / 3; }
        .hero-image img { object-position: 67% center; }
        .hero-image figcaption { padding: 8px 10px; font-size: 6px; }
        .service-rail { padding: 0; }
        .service-rail p { min-height: 96px; padding: 17px 14px; grid-template-columns: auto 1fr; gap: 2px 10px; font-size: 10px; }
        .service-rail strong { font-size: 16px; }
        .section { padding: 64px 16px; }
        .statement { grid-template-columns: 1fr; gap: 28px; }
        .statement-copy { grid-column: auto; font-size: 15px; }
        .statement h2, .section-head h2, .process h2, .material-copy h2, .planner h2, .principles h2, .faq h2, .contact h2 { font-size: clamp(44px, 13vw, 58px); }
        .section-head { margin-bottom: 38px; }
        .section-head > p { font-size: 15px; }
        .project-grid { grid-template-columns: 1fr; gap: 18px; }
        .project-card, .project-card--wide, .project-card--horizontal { grid-column: auto; grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
        .project-card picture, .project-card--wide picture, .project-card--horizontal picture { min-height: 0; aspect-ratio: 4 / 3; border-right: 0; border-bottom: 1px solid var(--ink); }
        .project-copy { padding: 25px 20px; }
        .project-copy h3 { font-size: 48px; }
        .process { gap: 46px; }
        .process li { padding: 24px 0; grid-template-columns: 48px 1fr; gap: 16px; }
        .process li > span { width: 40px; height: 40px; }
        .process h3 { font-size: 28px; }
        .materials figure { margin-inline: -16px; border-right: 0; border-left: 0; }
        .material-copy > p:not(.eyebrow) { margin: 24px 0 30px; font-size: 15px; }
        .material-selector { grid-template-columns: 1fr; }
        .material-selector button { min-height: 82px; display: grid; grid-template-columns: 42px 34px 1fr; align-items: center; gap: 12px; border-right: 0; border-bottom: 1px solid var(--ink); }
        .material-selector button:last-child { border-bottom: 0; }
        .planner > header { margin-bottom: 36px; }
        .planner-card { margin-inline: -1px; }
        .planner-options, .estimate { padding: 28px 20px; }
        .choice-grid { grid-template-columns: 1fr; }
        .choice-grid button { min-height: 76px; border-right: 0; border-bottom: 1px solid var(--ink); }
        .choice-grid button:last-child { border-bottom: 0; }
        .estimate > strong { font-size: 46px; }
        .estimate dl div { align-items: flex-start; flex-direction: column; gap: 4px; }
        .estimate dd { text-align: left; }
        .principle-grid { margin-top: 46px; grid-template-columns: 1fr; }
        .principle-grid article { min-height: 220px; padding: 26px 0; border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.4); }
        .principle-grid article:last-child { border-bottom: 0; }
        .principle-grid h3 { margin-top: 36px; }
        .faq { gap: 36px; }
        .faq summary { min-height: 72px; font-size: 19px; }
        .contact form > div { grid-template-columns: 1fr; }
        .contact input { border-bottom: 0; }
        footer { padding: 44px 20px 28px; grid-template-columns: 1fr; gap: 30px; }
        footer nav { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        dialog { padding: 32px 24px; box-shadow: 10px 10px 0 var(--yellow); }
        dialog h2 { font-size: 56px; }
      }

      @media (max-width: 360px) {
        .brand small { max-width: 145px; }
        .hero h1 { font-size: 50px; }
        .service-rail p { min-height: 92px; padding-inline: 10px; }
        .service-rail strong { font-size: 15px; }
        .statement h2, .section-head h2, .process h2, .material-copy h2, .planner h2, .principles h2, .faq h2, .contact h2 { font-size: 42px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
      }
    </style>
