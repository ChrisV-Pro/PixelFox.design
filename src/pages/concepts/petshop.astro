---
const canonicalUrl = "https://pixelfox.design/concepts/petshop/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pogo &amp; Pine | Fictional Pet Products Ecommerce Concept</title>
    <meta name="description" content="Pogo & Pine is a colorful fictional pet-products ecommerce concept created by PixelFox.design." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Pogo & Pine | Fictional Pet Products Ecommerce Concept" />
    <meta property="og:description" content="A bright, product-first ecommerce experience for a fictional modern pet-goods brand." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://pixelfox.design/images/petshop/pack-hero-1000.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2214%22 fill=%22%231240d8%22/><circle cx=%2222%22 cy=%2223%22 r=%226%22 fill=%22%23f4d248%22/><circle cx=%2242%22 cy=%2223%22 r=%226%22 fill=%22%23f4d248%22/><circle cx=%2232%22 cy=%2238%22 r=%2211%22 fill=%22%23f4d248%22/></svg>" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="concept-strip">
      <a href="/">PixelFox.design</a>
      <span>Independent fictional ecommerce concept. No products are sold.</span>
    </div>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Pogo and Pine home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><b></b></span>
        <span>Pogo <em>&amp;</em> Pine</span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#shop">Shop</a>
        <a href="#story">Our rhythm</a>
        <a href="#finder">Find your gear</a>
      </nav>
      <button class="bag-button" id="bag-button" type="button" aria-haspopup="dialog">Bag <span id="bag-count">0</span></button>
      <details class="mobile-nav">
        <summary>Menu <span aria-hidden="true"></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#shop">Shop</a>
          <a href="#story">Our rhythm</a>
          <a href="#finder">Find your gear</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker">Good gear. Great company.</p>
          <h1 id="hero-title">Make every walk <em>a big deal.</em></h1>
          <p class="hero-intro">Color-forward essentials imagined for muddy paws, snack breaks, and the very best part of the day.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#shop">Shop the concept <span>&rarr;</span></a>
            <a class="text-link" href="#finder">Find their fit</a>
          </div>
          <p class="concept-note">Fictional brand, products, and illustrative prices.</p>
        </div>
        <figure class="hero-visual">
          <picture>
            <source media="(max-width: 760px)" srcset="/images/petshop/pack-hero-640.avif" type="image/avif" />
            <source media="(max-width: 760px)" srcset="/images/petshop/pack-hero-640.webp" type="image/webp" />
            <source srcset="/images/petshop/pack-hero-1000.avif" type="image/avif" />
            <img alt="Two cheerful dogs with colorful leash, bowl, and enrichment toy created for the fictional Pogo and Pine concept" decoding="async" fetchpriority="high" height="1253" src="/images/petshop/pack-hero-1000.webp" width="1000" />
          </picture>
          <div class="hero-sticker" aria-hidden="true"><span>Walk kit</span><strong>4 pieces</strong><small>Concept collection</small></div>
          <figcaption>Original AI-generated concept photography</figcaption>
        </figure>
      </section>

      <nav class="category-bar" aria-label="Shop categories">
        <a href="#shop"><span>01</span> Walk</a>
        <a href="#shop"><span>02</span> Play</a>
        <a href="#shop"><span>03</span> Eat</a>
        <a href="#shop"><span>04</span> Carry</a>
      </nav>

      <section class="shop" id="shop" aria-labelledby="shop-title">
        <header class="section-head">
          <p class="eyebrow">The daily lineup</p>
          <h2 id="shop-title">Pick the good stuff.</h2>
          <p>A compact fictional collection designed to make the shopping path quick, visual, and easy to compare.</p>
        </header>
        <div class="shop-grid">
          <figure class="flatlay">
            <picture>
              <source sizes="(max-width: 760px) 100vw, 52vw" srcset="/images/petshop/gear-flatlay-600.avif 600w, /images/petshop/gear-flatlay-1000.avif 1000w" type="image/avif" />
              <source sizes="(max-width: 760px) 100vw, 52vw" srcset="/images/petshop/gear-flatlay-600.webp 600w, /images/petshop/gear-flatlay-1000.webp 1000w" type="image/webp" />
              <img alt="Overhead arrangement of a leash, treat pouch, ceramic bowl, and enrichment toy" decoding="async" height="1000" loading="lazy" src="/images/petshop/gear-flatlay-1000.webp" width="1000" />
            </picture>
            <figcaption>Original AI-generated product study</figcaption>
            <span class="hotspot hotspot-one">01</span>
            <span class="hotspot hotspot-two">02</span>
            <span class="hotspot hotspot-three">03</span>
            <span class="hotspot hotspot-four">04</span>
          </figure>
          <div class="product-list">
            <article class="product-row">
              <span class="product-number">01</span>
              <div><p class="product-type">Walk</p><h3>Loop Rope Lead</h3><p>Soft-grip rope with a simple swivel clip.</p></div>
              <div class="product-buy"><span>$34 <small>Concept price</small></span><button type="button" data-product="Loop Rope Lead">Add <b>+</b></button></div>
            </article>
            <article class="product-row">
              <span class="product-number">02</span>
              <div><p class="product-type">Carry</p><h3>Pocket Treat Pouch</h3><p>A bright, hands-free home for the good snacks.</p></div>
              <div class="product-buy"><span>$28 <small>Concept price</small></span><button type="button" data-product="Pocket Treat Pouch">Add <b>+</b></button></div>
            </article>
            <article class="product-row">
              <span class="product-number">03</span>
              <div><p class="product-type">Eat</p><h3>Slow-Go Bowl</h3><p>A weighty ceramic bowl with a low, friendly profile.</p></div>
              <div class="product-buy"><span>$42 <small>Concept price</small></span><button type="button" data-product="Slow-Go Bowl">Add <b>+</b></button></div>
            </article>
            <article class="product-row">
              <span class="product-number">04</span>
              <div><p class="product-type">Play</p><h3>Bounce Ball</h3><p>Textured enrichment made for lively afternoons.</p></div>
              <div class="product-buy"><span>$18 <small>Concept price</small></span><button type="button" data-product="Bounce Ball">Add <b>+</b></button></div>
            </article>
            <p class="add-status" id="add-status" aria-live="polite">Concept shop preview. Nothing can be purchased.</p>
          </div>
        </div>
      </section>

      <div class="ticker" aria-hidden="true"><span>For good dogs and their people / For good dogs and their people / For good dogs and their people /</span></div>

      <section class="story" id="story" aria-labelledby="story-title">
        <picture>
          <source sizes="100vw" srcset="/images/petshop/walk-story-800.avif 800w, /images/petshop/walk-story-1500.avif 1500w" type="image/avif" />
          <source sizes="100vw" srcset="/images/petshop/walk-story-800.webp 800w, /images/petshop/walk-story-1500.webp 1500w" type="image/webp" />
          <img alt="A person enjoying a sunny walk with a happy dog in colorful walking gear" decoding="async" height="1000" loading="lazy" src="/images/petshop/walk-story-1500.webp" width="1500" />
        </picture>
        <div class="story-card">
          <p class="eyebrow">Out the door</p>
          <h2 id="story-title">Built around the best part of the day.</h2>
          <p>This concept positions everyday pet gear like a joyful lifestyle collection: useful first, visually memorable, and always centered on the bond.</p>
          <a class="button button-light" href="#finder">Meet your match <span>&rarr;</span></a>
        </div>
        <p class="photo-note">AI-generated lifestyle concept</p>
      </section>

      <section class="principles" aria-labelledby="principles-title">
        <div class="principles-title">
          <p class="eyebrow">Concept product principles</p>
          <h2 id="principles-title">Easy to grab.<br />Hard to leave home.</h2>
        </div>
        <div class="principle-grid">
          <article><span>01</span><h3>Daily-use shapes</h3><p>A tight assortment keeps decisions simple and puts useful products first.</p></article>
          <article><span>02</span><h3>Color with purpose</h3><p>Bold color helps categories feel distinct while giving the shop a recognizable voice.</p></article>
          <article><span>03</span><h3>Details up close</h3><p>Product texture, hardware, and scale stay visible so shoppers can compare confidently.</p></article>
        </div>
      </section>

      <section class="finder" id="finder" aria-labelledby="finder-title">
        <div class="finder-copy">
          <p class="eyebrow">One-question gear finder</p>
          <h2 id="finder-title">What kind of outing is on the calendar?</h2>
        </div>
        <div class="finder-options" role="group" aria-label="Choose an outing">
          <button type="button" data-answer="The Loop Rope Lead and Pocket Treat Pouch make a lively neighborhood pairing."><span>A</span> The quick block loop</button>
          <button type="button" data-answer="The full Walk Kit concept keeps the park-day essentials together."><span>B</span> The long park wander</button>
          <button type="button" data-answer="The Slow-Go Bowl and Bounce Ball concept are ready for a relaxed home day."><span>C</span> The backyard hang</button>
          <p id="finder-result" aria-live="polite">Choose one to preview a fictional recommendation.</p>
        </div>
      </section>

      <section class="signup" aria-labelledby="signup-title">
        <div><p class="eyebrow">Letters from the pack</p><h2 id="signup-title">Good mail.<br />No junk.</h2></div>
        <form id="signup-form">
          <label for="signup-email">Email address</label>
          <div><input id="signup-email" name="email" type="email" placeholder="you@example.com" required /><button type="submit">Join the concept list <span>&rarr;</span></button></div>
          <p id="signup-status" aria-live="polite">Demonstration only. No information is sent or saved.</p>
        </form>
      </section>
    </main>

    <footer>
      <div class="footer-brand"><span class="brand-mark" aria-hidden="true"><i></i><i></i><b></b></span><strong>Pogo <em>&amp;</em> Pine</strong></div>
      <nav aria-label="Footer navigation"><a href="#shop">Shop</a><a href="#story">Our rhythm</a><a href="#finder">Find your gear</a><a href="#top">Back to top</a></nav>
      <div class="footer-bottom">
        <p>Pogo & Pine is an independent fictional ecommerce concept by PixelFox.design. Products, prices, availability, claims, and photography are presented only as design examples. No purchases are possible.</p>
        <a href="/">Return to PixelFox.design &rarr;</a>
      </div>
    </footer>

    <dialog class="bag-dialog" id="bag-dialog" aria-labelledby="bag-title">
      <div class="bag-head"><h2 id="bag-title">Concept bag</h2><button type="button" id="bag-close" aria-label="Close bag">&times;</button></div>
      <ul id="bag-items"><li>Your preview bag is empty.</li></ul>
      <p>This is a design demonstration. No order, checkout, or payment is available.</p>
      <button class="bag-done" id="bag-done" type="button">Keep browsing</button>
    </dialog>

    <script is:inline>
      const bag = [];
      const bagDialog = document.getElementById("bag-dialog");
      const bagCount = document.getElementById("bag-count");
      const bagItems = document.getElementById("bag-items");
      const addStatus = document.getElementById("add-status");

      const renderBag = () => {
        bagCount.textContent = String(bag.length);
        bagItems.innerHTML = bag.length ? bag.map((item) => `<li>${item}<span>Concept item</span></li>`).join("") : "<li>Your preview bag is empty.</li>";
      };

      document.querySelectorAll("[data-product]").forEach((button) => {
        button.addEventListener("click", () => {
          const product = button.dataset.product;
          bag.push(product);
          renderBag();
          addStatus.textContent = `${product} was added to the concept bag. Nothing was purchased.`;
        });
      });

      document.getElementById("bag-button")?.addEventListener("click", () => bagDialog?.showModal());
      document.getElementById("bag-close")?.addEventListener("click", () => bagDialog?.close());
      document.getElementById("bag-done")?.addEventListener("click", () => bagDialog?.close());

      document.querySelectorAll("[data-answer]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-answer]").forEach((option) => option.classList.remove("is-selected"));
          button.classList.add("is-selected");
          document.getElementById("finder-result").textContent = button.dataset.answer;
        });
      });

      document.getElementById("signup-form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        document.getElementById("signup-status").textContent = "Preview complete. No information was sent or saved.";
      });
    </script>

    <style is:global>
      :root {
        --cream: #f6efdf;
        --ink: #171716;
        --blue: #1240d8;
        --blue-dark: #0b2da5;
        --red: #ed4b2f;
        --yellow: #f2d34f;
        --paper: #fffaf0;
        --line: rgba(23, 23, 22, 0.24);
        --display: "Bookman Old Style", "URW Bookman", Georgia, serif;
        --sans: "Trebuchet MS", "Gill Sans", sans-serif;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 80px; background: var(--ink); }
      body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--cream); font-family: var(--sans); font-size: 17px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      body:has(dialog[open]) { overflow: hidden; }
      a { color: inherit; text-decoration: none; }
      button, input { font: inherit; }
      button { color: inherit; }
      img { display: block; max-width: 100%; }
      h1, h2, h3, p { margin-top: 0; }
      h1, h2, h3 { font-family: var(--display); }
      :focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px; }
      .skip-link { position: fixed; z-index: 400; top: 12px; left: 12px; padding: 11px 15px; background: var(--yellow); transform: translateY(-170%); }
      .skip-link:focus { transform: translateY(0); }

      .concept-strip { min-height: 32px; padding: 6px clamp(18px, 3.4vw, 54px); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--cream); background: var(--ink); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .concept-strip a { color: var(--yellow); text-decoration: underline; text-underline-offset: 3px; }
      .site-header { position: relative; z-index: 40; min-height: 78px; padding: 0 clamp(18px, 3.4vw, 54px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 34px; background: var(--cream); border-bottom: 2px solid var(--ink); }
      .brand { display: inline-flex; align-items: center; gap: 12px; justify-self: start; font-family: var(--display); font-size: 25px; font-weight: 700; letter-spacing: -0.045em; }
      .brand em, .footer-brand em { color: var(--red); font-style: normal; }
      .brand-mark { position: relative; width: 42px; height: 42px; display: inline-block; flex: 0 0 auto; border-radius: 50%; background: var(--blue); transform: rotate(-8deg); }
      .brand-mark i, .brand-mark b { position: absolute; display: block; border-radius: 50%; background: var(--yellow); }
      .brand-mark i { top: 9px; width: 9px; height: 11px; }
      .brand-mark i:first-child { left: 8px; transform: rotate(-24deg); }
      .brand-mark i:nth-child(2) { right: 8px; transform: rotate(24deg); }
      .brand-mark b { left: 13px; bottom: 8px; width: 16px; height: 17px; }
      .desktop-nav { display: flex; align-items: center; gap: clamp(24px, 3vw, 48px); }
      .desktop-nav a { padding: 8px 0; border-bottom: 2px solid transparent; font-size: 12px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
      .desktop-nav a:hover, .desktop-nav a:focus-visible { border-bottom-color: var(--red); }
      .bag-button { min-height: 44px; padding: 0 17px; display: inline-flex; align-items: center; gap: 11px; justify-self: end; border: 2px solid var(--ink); background: transparent; cursor: pointer; font-size: 12px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
      .bag-button span { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 50%; color: var(--cream); background: var(--red); }
      .mobile-nav { display: none; }

      .hero { min-height: calc(100svh - 110px); display: grid; grid-template-columns: minmax(0, 1.03fr) minmax(460px, 0.97fr); border-bottom: 2px solid var(--ink); }
      .hero > * { min-width: 0; min-height: 0; }
      .hero-copy { min-height: 0; padding: clamp(50px, 6vh, 78px) clamp(30px, 6vw, 100px); display: flex; flex-direction: column; justify-content: center; color: var(--paper); background: var(--blue); }
      .kicker, .eyebrow { margin-bottom: 26px; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
      .kicker::before, .eyebrow::before { width: 34px; height: 2px; margin-right: 11px; display: inline-block; vertical-align: middle; background: currentColor; content: ""; }
      h1 { max-width: 850px; margin-bottom: 28px; font-size: clamp(68px, 7.8vw, 126px); font-weight: 700; letter-spacing: -0.075em; line-height: 0.87; }
      h1 em { display: block; color: var(--yellow); font-style: italic; font-weight: 400; }
      .hero-intro { max-width: 660px; margin-bottom: 34px; font-size: clamp(18px, 1.5vw, 22px); }
      .hero-actions { display: flex; align-items: center; gap: 28px; }
      .button { min-height: 54px; padding: 0 20px; display: inline-flex; align-items: center; justify-content: space-between; gap: 42px; border: 2px solid var(--ink); font-size: 12px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; transition: transform 160ms ease, background 160ms ease, color 160ms ease; }
      .button:hover, .button:focus-visible { transform: translate(-3px, -3px); box-shadow: 4px 4px 0 var(--red); }
      .button-dark { color: var(--cream); background: var(--ink); }
      .button-light { color: var(--ink); background: var(--cream); }
      .text-link { padding-bottom: 4px; border-bottom: 2px solid var(--yellow); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
      .concept-note { margin: 34px 0 0; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.78; }
      .hero-visual { position: relative; min-height: 0; margin: 0; overflow: hidden; background: var(--yellow); }
      .hero-visual picture { position: absolute; inset: 0; display: block; }
      .hero-visual picture, .hero-visual img { width: 100%; height: 100%; }
      .hero-visual img { object-fit: cover; object-position: center 48%; }
      .hero-sticker { position: absolute; top: 36px; left: 32px; width: 138px; height: 138px; padding: 22px; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px solid var(--ink); border-radius: 50%; background: var(--yellow); text-align: center; transform: rotate(-7deg); }
      .hero-sticker span, .hero-sticker small { font-size: 10px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
      .hero-sticker strong { margin: 2px 0; font-family: var(--display); font-size: 22px; line-height: 1; }
      .hero-visual figcaption, .flatlay figcaption, .photo-note { position: absolute; right: 14px; bottom: 12px; margin: 0; padding: 6px 8px; color: var(--cream); background: var(--ink); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }

      .category-bar { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 2px solid var(--ink); background: var(--yellow); }
      .category-bar a { min-height: 92px; padding: 20px clamp(18px, 3vw, 45px); display: flex; align-items: center; justify-content: space-between; border-right: 2px solid var(--ink); font-family: var(--display); font-size: clamp(22px, 2vw, 31px); font-weight: 700; letter-spacing: -0.04em; }
      .category-bar a:last-child { border-right: 0; }
      .category-bar a:hover, .category-bar a:focus-visible { color: var(--cream); background: var(--red); }
      .category-bar span { font-family: var(--sans); font-size: 10px; letter-spacing: 0.1em; }

      .shop { padding: clamp(80px, 9vw, 140px) clamp(20px, 5vw, 80px); }
      .section-head { margin-bottom: 70px; display: grid; grid-template-columns: 0.45fr 1.2fr 0.65fr; align-items: end; gap: clamp(28px, 5vw, 80px); }
      .section-head .eyebrow { align-self: start; }
      .section-head h2, .story-card h2, .principles h2, .finder h2, .signup h2 { margin-bottom: 0; font-size: clamp(54px, 6.5vw, 104px); font-weight: 700; letter-spacing: -0.065em; line-height: 0.92; }
      .section-head > p:last-child { margin-bottom: 0; font-size: 18px; }
      .shop-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(480px, 0.95fr); align-items: start; gap: clamp(42px, 6vw, 90px); }
      .flatlay { position: sticky; top: 24px; margin: 0; overflow: hidden; border: 2px solid var(--ink); }
      .flatlay img { width: 100%; aspect-ratio: 1; object-fit: cover; }
      .hotspot { position: absolute; width: 34px; height: 34px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; background: var(--yellow); font-size: 10px; font-weight: 700; }
      .hotspot-one { top: 9%; left: 10%; }
      .hotspot-two { top: 10%; right: 9%; }
      .hotspot-three { bottom: 18%; left: 8%; }
      .hotspot-four { right: 10%; bottom: 22%; }
      .product-list { border-top: 2px solid var(--ink); }
      .product-row { min-height: 185px; padding: 26px 0; display: grid; grid-template-columns: 36px 1fr 118px; align-items: center; gap: 18px; border-bottom: 2px solid var(--ink); }
      .product-number, .product-type { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .product-number { align-self: start; padding-top: 7px; color: var(--blue); }
      .product-type { margin-bottom: 4px; color: var(--red); }
      .product-row h3 { margin-bottom: 8px; font-size: clamp(27px, 2.8vw, 42px); font-weight: 700; letter-spacing: -0.05em; line-height: 1; }
      .product-row p:last-child { max-width: 420px; margin-bottom: 0; font-size: 14px; }
      .product-buy { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
      .product-buy > span { font-family: var(--display); font-size: 20px; font-weight: 700; }
      .product-buy small { display: block; font-family: var(--sans); font-size: 8px; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; }
      .product-buy button { min-width: 92px; min-height: 42px; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; border: 2px solid var(--ink); background: transparent; cursor: pointer; font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
      .product-buy button:hover, .product-buy button:focus-visible { color: var(--cream); background: var(--blue); }
      .product-buy b { font-size: 20px; }
      .add-status { margin: 18px 0 0; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }

      .ticker { overflow: hidden; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); color: var(--cream); background: var(--red); }
