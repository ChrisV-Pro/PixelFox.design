---
const canonicalUrl = "https://pixelfox.design/concepts/petshop/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sunday Mudroom | Fictional Pet Products Ecommerce Concept</title>
    <meta
      name="description"
      content="Sunday Mudroom is an earthy, home-focused fictional pet-products ecommerce concept created by PixelFox.design."
    />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Sunday Mudroom | Fictional Pet Products Ecommerce Concept" />
    <meta
      property="og:description"
      content="A warm, product-led online shop concept for pet goods designed to live beautifully at home."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://pixelfox.design/images/sunday-mudroom/hero-1600.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2232%22 fill=%22%23344536%22/><path d=%22M18 44V28c0-9 6-15 14-15s14 6 14 15v16%22 fill=%22none%22 stroke=%22%23f3eddf%22 stroke-width=%224%22/><circle cx=%2232%22 cy=%2233%22 r=%226%22 fill=%22%23b76a4f%22/></svg>"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to products</a>

    <div class="concept-strip">
      <a href="/">A PixelFox.design concept</a>
      <span>Fictional shop. Illustrative products and prices. Nothing is sold.</span>
    </div>

    <header class="store-header" id="top">
      <div class="header-main">
        <a class="brand" href="#top" aria-label="Sunday Mudroom home">
          <span class="brand-mark" aria-hidden="true"><i></i></span>
          <span class="brand-copy">Sunday Mudroom <small>Pet goods for real homes</small></span>
        </a>

        <button class="search-trigger" id="search-trigger" type="button" aria-controls="search-panel" aria-expanded="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
          Search the shop
        </button>

        <div class="header-actions">
          <button class="account-button" type="button" data-demo="account">Account</button>
          <button class="bag-button" id="bag-button" type="button" aria-haspopup="dialog">
            Bag <span id="bag-count">0</span>
          </button>
          <details class="mobile-menu">
            <summary aria-label="Open shop menu"><span></span></summary>
            <nav aria-label="Mobile shop navigation">
              <a href="#shop">Shop all</a>
              <button type="button" data-category-link="walk">Walk</button>
              <button type="button" data-category-link="rest">Rest</button>
              <button type="button" data-category-link="feed">Feed</button>
              <button type="button" data-category-link="play">Play</button>
              <button type="button" data-category-link="care">Care</button>
              <button type="button" data-category-link="travel">Travel</button>
              <a href="#why">Our approach</a>
            </nav>
          </details>
        </div>
      </div>

      <div class="search-panel" id="search-panel" hidden>
        <form id="search-form" role="search">
          <label for="shop-search">What are you looking for?</label>
          <div>
            <input id="shop-search" name="query" type="search" placeholder="Try bed, bowl, carrier..." autocomplete="off" />
            <button type="submit">Search</button>
          </div>
          <p id="search-status" role="status">Search this eight-product concept collection.</p>
        </form>
      </div>

      <nav class="shop-nav" aria-label="Shop categories">
        <a href="#shop">Shop all</a>
        <button type="button" data-category-link="walk">Walk</button>
        <button type="button" data-category-link="rest">Rest</button>
        <button type="button" data-category-link="feed">Feed</button>
        <button type="button" data-category-link="play">Play</button>
        <button type="button" data-category-link="care">Care</button>
        <button type="button" data-category-link="travel">Travel</button>
        <a href="#why">Why Sunday Mudroom</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="overline">Pet goods for real homes</p>
          <h1 id="hero-title"><span>A better-looking</span><br />life with pets.</h1>
          <p>Everyday beds, bowls, walking gear, and care essentials in calm materials made to feel at home in your home.</p>
          <div class="hero-actions">
            <a class="primary-button" href="#shop">Shop all eight</a>
            <button type="button" data-category-link="travel">Shop travel</button>
          </div>
          <div class="hero-note">
            <strong>Sunday edit 01</strong>
            <span>Eight coordinated concept goods for walk, rest, feed, play, care, and travel.</span>
          </div>
        </div>
        <figure class="hero-visual">
          <picture>
            <source
              sizes="(max-width: 760px) 100vw, 56vw"
              srcset="/images/sunday-mudroom/hero-900.avif 900w, /images/sunday-mudroom/hero-1600.avif 1600w"
              type="image/avif"
            />
            <source
              sizes="(max-width: 760px) 100vw, 56vw"
              srcset="/images/sunday-mudroom/hero-900.webp 900w, /images/sunday-mudroom/hero-1600.webp 1600w"
              type="image/webp"
            />
            <img
              alt="Woman helping a happy dog into an earthy green harness beside coordinated pet products in a warm mudroom"
              decoding="async"
              fetchpriority="high"
              height="1067"
              src="/images/sunday-mudroom/hero-1600.webp"
              width="1600"
            />
          </picture>
          <figcaption>Original AI-generated concept photography</figcaption>
        </figure>
      </section>

      <section class="service-row" aria-label="Concept store benefits">
        <p><span>01</span> Thoughtful materials</p>
        <p><span>02</span> Calm, simple choices</p>
        <p><span>03</span> Made for daily routines</p>
        <p><span>04</span> Concept checkout only</p>
      </section>

      <section class="shop-section" id="shop" aria-labelledby="shop-title">
        <div class="section-heading">
          <div>
            <p class="overline">Shop the concept</p>
            <h2 id="shop-title">The everyday shop</h2>
          </div>
          <p>Eight coordinated essentials with straightforward categories, useful details, and room to browse. Prices and product details are illustrative.</p>
        </div>

        <div class="filter-bar" aria-label="Filter products">
          <button class="filter-chip is-active" type="button" data-filter="all" aria-pressed="true">All goods</button>
          <button class="filter-chip" type="button" data-filter="walk" aria-pressed="false">Walk</button>
          <button class="filter-chip" type="button" data-filter="rest" aria-pressed="false">Rest</button>
          <button class="filter-chip" type="button" data-filter="feed" aria-pressed="false">Feed</button>
          <button class="filter-chip" type="button" data-filter="play" aria-pressed="false">Play</button>
          <button class="filter-chip" type="button" data-filter="care" aria-pressed="false">Care</button>
          <button class="filter-chip" type="button" data-filter="travel" aria-pressed="false">Travel</button>
          <span id="product-count" aria-live="polite">8 concept products</span>
        </div>

        <div class="product-grid">
          <article class="product-card" data-product-card data-category="rest" data-search="hearth bed rest washable moss">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/hearth-bed-520.avif 520w, /images/sunday-mudroom/hearth-bed-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/hearth-bed-520.webp 520w, /images/sunday-mudroom/hearth-bed-900.webp 900w" type="image/webp" />
                <img alt="Moss green quilted rectangular pet bed" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/hearth-bed-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Hearth Bed">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Rest / Washed cotton</p>
                <h3>The Hearth Bed</h3>
                <p class="product-color">Moss / Oat piping</p>
              </div>
              <p class="price">$128 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Hearth Bed" data-price="$128">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="feed" data-search="stoneware bowl bowls feed ceramic walnut">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/stoneware-bowls-520.avif 520w, /images/sunday-mudroom/stoneware-bowls-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/stoneware-bowls-520.webp 520w, /images/sunday-mudroom/stoneware-bowls-900.webp 900w" type="image/webp" />
                <img alt="Two speckled cream stoneware pet bowls on a walnut tray" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/stoneware-bowls-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Stoneware Pair">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Feed / Speckled ceramic</p>
                <h3>The Stoneware Pair</h3>
                <p class="product-color">Cream / Walnut tray</p>
              </div>
              <p class="price">$64 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Stoneware Pair" data-price="$64">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="walk" data-search="market walk set harness lead leash pouch moss cognac">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/market-walk-set-520.avif 520w, /images/sunday-mudroom/market-walk-set-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/market-walk-set-520.webp 520w, /images/sunday-mudroom/market-walk-set-900.webp 900w" type="image/webp" />
                <img alt="Moss canvas harness, cotton rope lead, and oat treat pouch" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/market-walk-set-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Market Walk Set">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Walk / Three-piece set</p>
                <h3>The Market Walk Set</h3>
                <p class="product-color">Moss / Cognac / Oat</p>
              </div>
              <p class="price">$92 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Market Walk Set" data-price="$92">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="play" data-search="woven play set toys rope clay oat mustard">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/woven-play-set-520.avif 520w, /images/sunday-mudroom/woven-play-set-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/woven-play-set-520.webp 520w, /images/sunday-mudroom/woven-play-set-900.webp 900w" type="image/webp" />
                <img alt="Three woven rope pet toys in clay, oatmeal, and muted mustard" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/woven-play-set-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Woven Play Set">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Play / Woven cotton</p>
                <h3>The Woven Play Set</h3>
                <p class="product-color">Clay / Oat / Mustard</p>
              </div>
              <p class="price">$38 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Woven Play Set" data-price="$38">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="travel" data-search="weekend carrier travel tote canvas oat moss cognac">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/weekend-carrier-520.avif 520w, /images/sunday-mudroom/weekend-carrier-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/weekend-carrier-520.webp 520w, /images/sunday-mudroom/weekend-carrier-900.webp 900w" type="image/webp" />
                <img alt="Oat canvas pet travel carrier with cognac straps and moss cushion" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/weekend-carrier-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Weekend Carrier">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Travel / Waxed canvas</p>
                <h3>The Weekend Carrier</h3>
                <p class="product-color">Oat / Moss cushion</p>
              </div>
              <p class="price">$148 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Weekend Carrier" data-price="$148">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="care" data-search="grooming care brush towel paw balm wash mitt clay sage walnut">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/grooming-kit-520.avif 520w, /images/sunday-mudroom/grooming-kit-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/grooming-kit-520.webp 520w, /images/sunday-mudroom/grooming-kit-900.webp 900w" type="image/webp" />
                <img alt="Walnut pet brush, clay towel, sage balm jar, and cotton wash mitt" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/grooming-kit-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Grooming Day Kit">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Care / Four-piece set</p>
                <h3>The Grooming Day Kit</h3>
                <p class="product-color">Clay / Sage / Walnut</p>
              </div>
              <p class="price">$54 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Grooming Day Kit" data-price="$54">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="feed" data-search="pantry treat crock jar feed speckled ceramic walnut cream">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/treat-crock-520.avif 520w, /images/sunday-mudroom/treat-crock-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/treat-crock-520.webp 520w, /images/sunday-mudroom/treat-crock-900.webp 900w" type="image/webp" />
                <img alt="Speckled cream stoneware pet treat jar with a walnut lid" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/treat-crock-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Pantry Treat Crock">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Feed / Stoneware</p>
                <h3>The Pantry Treat Crock</h3>
                <p class="product-color">Cream / Walnut lid</p>
              </div>
              <p class="price">$46 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Pantry Treat Crock" data-price="$46">Quick add <span>+</span></button>
          </article>

          <article class="product-card" data-product-card data-category="travel" data-search="road trip travel blanket quilt oat moss cognac pouch">
            <div class="product-image">
              <picture>
                <source srcset="/images/sunday-mudroom/travel-blanket-520.avif 520w, /images/sunday-mudroom/travel-blanket-900.avif 900w" type="image/avif" />
                <source srcset="/images/sunday-mudroom/travel-blanket-520.webp 520w, /images/sunday-mudroom/travel-blanket-900.webp 900w" type="image/webp" />
                <img alt="Rolled oat quilted pet blanket with moss binding and cognac straps" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/travel-blanket-520.webp" width="900" />
              </picture>
              <button class="image-action" type="button" data-preview="The Road Trip Quilt">View details</button>
            </div>
            <div class="product-info">
              <div>
                <p class="product-kicker">Travel / Quilted cotton</p>
                <h3>The Road Trip Quilt</h3>
                <p class="product-color">Oat / Moss binding</p>
              </div>
              <p class="price">$86 <small>Concept price</small></p>
            </div>
            <button class="quick-add" type="button" data-add="The Road Trip Quilt" data-price="$86">Quick add <span>+</span></button>
          </article>
        </div>
      </section>

      <section class="collection-banner" aria-labelledby="collection-title">
        <div class="collection-copy">
          <p class="overline">The mudroom set</p>
          <h2 id="collection-title">One calm corner. Every daily essential.</h2>
          <p>Bundle the imagined walking set, bowl pair, and woven toy trio into a coordinated entryway collection.</p>
          <button class="light-button" type="button" data-add="The Mudroom Bundle" data-price="$194">Add concept bundle</button>
          <small>Illustrative bundle and price. No transaction will occur.</small>
        </div>
        <picture>
          <source srcset="/images/sunday-mudroom/market-walk-set-520.avif 520w, /images/sunday-mudroom/market-walk-set-900.avif 900w" type="image/avif" />
          <source srcset="/images/sunday-mudroom/market-walk-set-520.webp 520w, /images/sunday-mudroom/market-walk-set-900.webp 900w" type="image/webp" />
          <img alt="Earth-tone harness, lead, and treat pouch arranged for the fictional collection" decoding="async" height="900" loading="lazy" src="/images/sunday-mudroom/market-walk-set-900.webp" width="900" />
        </picture>
      </section>

      <section class="routine-section" aria-labelledby="routine-title">
        <div class="section-heading section-heading--center">
          <div>
            <p class="overline">Browse by routine</p>
            <h2 id="routine-title">Shop the way home happens</h2>
          </div>
          <p>Start with the moment you are solving for, then see the products that belong there.</p>
        </div>
        <div class="routine-grid">
          <button type="button" data-category-link="walk">
            <span>01 / Entryway</span>
            <strong>Out the door</strong>
            <em>Shop walking</em>
          </button>
          <button type="button" data-category-link="feed">
            <span>02 / Kitchen</span>
            <strong>Supper sorted</strong>
            <em>Shop feeding</em>
          </button>
          <button type="button" data-category-link="rest">
            <span>03 / Family room</span>
            <strong>Settle in</strong>
            <em>Shop resting</em>
          </button>
        </div>
      </section>

      <section class="why-section" id="why" aria-labelledby="why-title">
        <div class="why-photo">
          <picture>
            <source srcset="/images/sunday-mudroom/hero-900.avif" type="image/avif" />
            <img alt="A relaxed pet and owner in a warm family mudroom" decoding="async" height="1067" loading="lazy" src="/images/sunday-mudroom/hero-900.webp" width="1600" />
          </picture>
          <p>Original AI-generated concept photography</p>
        </div>
        <div class="why-copy">
          <p class="overline">Why Sunday Mudroom</p>
          <h2 id="why-title">Pet essentials can belong in the room.</h2>
          <p class="why-intro">This fictional shop treats pet gear like homeware: useful enough for every day and considered enough to leave out.</p>
          <dl>
            <div><dt>Easy to understand</dt><dd>Clear materials, colors, and use cases at a glance.</dd></div>
            <div><dt>Easy to coordinate</dt><dd>A small palette that works together across categories.</dd></div>
            <div><dt>Easy to shop</dt><dd>Simple filters and quick-add controls for busy routines.</dd></div>
          </dl>
        </div>
      </section>

      <section class="faq-section" aria-labelledby="faq-title">
        <div>
          <p class="overline">Before you add</p>
          <h2 id="faq-title">A few useful details</h2>
        </div>
        <div class="faq-list">
          <details><summary>Are these products available to buy?</summary><p>No. Sunday Mudroom is an independent fictional ecommerce concept. The bag and checkout language are demonstrations only.</p></details>
          <details><summary>Are the materials and prices real?</summary><p>No. Product names, materials, colors, bundles, and prices are illustrative parts of the design concept.</p></details>
          <details><summary>Where did the photography come from?</summary><p>The imagery was created specifically for this fictional concept with AI and is labeled throughout the page.</p></details>
        </div>
      </section>

      <section class="newsletter" aria-labelledby="newsletter-title">
        <div>
          <p class="overline">Notes from the mudroom</p>
          <h2 id="newsletter-title">Good finds for pets and the homes they share.</h2>
        </div>
        <form id="newsletter-form">
          <label for="newsletter-email">Email address</label>
          <div><input id="newsletter-email" type="email" placeholder="you@example.com" required /><button type="submit">Join the concept list</button></div>
          <p id="newsletter-status" role="status">Demo only. Nothing is sent or saved.</p>
        </form>
      </section>
    </main>

    <footer>
      <div class="footer-brand">
        <span class="brand-mark" aria-hidden="true"><i></i></span>
        <div><strong>Sunday Mudroom</strong><small>Pet goods for real homes</small></div>
      </div>
      <nav aria-label="Footer navigation"><a href="#shop">Shop all</a><a href="#why">Our approach</a><a href="#top">Back to top</a><a href="/">PixelFox.design</a></nav>
      <p>Sunday Mudroom is a fictional ecommerce concept by PixelFox.design. Products, prices, materials, policies, and photography are presented only as design examples. No purchase is possible.</p>
    </footer>

    <dialog class="cart-drawer" id="cart-dialog" aria-labelledby="cart-title">
      <div class="cart-head"><div><p class="overline">Concept bag</p><h2 id="cart-title">Your Sunday goods</h2></div><button id="cart-close" type="button" aria-label="Close bag">Close</button></div>
      <div class="cart-items" id="cart-items"><p class="empty-cart">Your concept bag is empty.</p></div>
      <div class="cart-foot"><p><span>Concept subtotal</span><strong id="cart-subtotal">$0</strong></p><button type="button" id="checkout-button">Preview checkout</button><small>Nothing can be purchased. No payment details are collected.</small></div>
    </dialog>

    <dialog class="product-dialog" id="product-dialog" aria-labelledby="product-dialog-title">
      <button id="product-dialog-close" type="button" aria-label="Close product preview">Close</button>
      <p class="overline">Concept product preview</p>
      <h2 id="product-dialog-title">Product details</h2>
      <p>This quick-view treatment demonstrates a familiar ecommerce interaction. Product information is illustrative and no item is for sale.</p>
      <button class="primary-button" id="preview-add" type="button">Add to concept bag</button>
    </dialog>

    <p class="toast" id="toast" role="status" aria-live="polite"></p>

    <style>
      :root {
        --ink: #26251f;
        --moss: #354337;
        --deep-moss: #263229;
        --sage: #9da58d;
        --oat: #efe7d8;
        --paper: #faf7f0;
        --clay: #a85f43;
        --mustard: #c69b52;
        --walnut: #76543c;
        --line: rgba(38, 37, 31, 0.2);
        --page-max: 2200px;
        --wide-max: 2560px;
        --gutter: clamp(20px, 4vw, 72px);
        --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
        --sans: "Avenir Next", "Century Gothic", "Trebuchet MS", sans-serif;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 150px; background: var(--deep-moss); }
      body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--paper); font-family: var(--sans); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      body:has(dialog[open]) { overflow: hidden; }
      a { color: inherit; text-decoration: none; }
      button, input { color: inherit; font: inherit; }
      button { cursor: pointer; }
      img { width: 100%; display: block; }
      h1, h2, h3, p { margin-top: 0; }
      h1, h2, h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.045em; text-wrap: balance; }
      :focus-visible { outline: 3px solid var(--clay); outline-offset: 4px; }
      [hidden] { display: none !important; }
      .skip-link { position: fixed; z-index: 500; top: 12px; left: 12px; padding: 10px 14px; color: var(--paper); background: var(--deep-moss); transform: translateY(-160%); }
      .skip-link:focus { transform: translateY(0); }
      .overline { margin-bottom: 14px; color: var(--clay); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }

      .concept-strip { min-height: 30px; padding: 6px max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--oat); background: var(--deep-moss); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .concept-strip a { text-decoration: underline; text-underline-offset: 3px; }
      .store-header { position: sticky; z-index: 80; top: 0; color: var(--ink); background: rgba(250, 247, 240, 0.97); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }
      .header-main { width: min(100%, var(--page-max)); min-height: 84px; margin-inline: auto; padding: 0 var(--gutter); display: grid; grid-template-columns: minmax(260px, 1fr) minmax(280px, 0.75fr) minmax(220px, 1fr); align-items: center; gap: 30px; }
      .brand { display: inline-flex; align-items: center; gap: 13px; justify-self: start; }
      .brand-mark { position: relative; width: 44px; height: 48px; display: inline-block; flex: 0 0 auto; border: 2px solid var(--moss); border-radius: 24px 24px 8px 8px; }
      .brand-mark::before, .brand-mark::after, .brand-mark i { position: absolute; display: block; border-radius: 50%; background: var(--clay); content: ""; }
      .brand-mark::before { top: 13px; left: 9px; width: 8px; height: 9px; }
      .brand-mark::after { top: 13px; right: 9px; width: 8px; height: 9px; }
      .brand-mark i { bottom: 8px; left: 14px; width: 13px; height: 14px; }
      .brand-copy { display: flex; flex-direction: column; font-family: var(--serif); font-size: clamp(21px, 2vw, 27px); line-height: 1; letter-spacing: -0.035em; }
      .brand-copy small, .footer-brand small { margin-top: 5px; font-family: var(--sans); font-size: 8px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
      .search-trigger { min-height: 42px; padding: 0 4px; display: flex; align-items: center; gap: 10px; justify-self: stretch; border: 0; border-bottom: 1px solid var(--ink); background: transparent; font-size: 12px; text-align: left; }
      .search-trigger svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; }
      .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 20px; }
      .account-button, .bag-button { min-height: 42px; padding: 0; border: 0; background: transparent; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
      .bag-button { padding: 0 16px; border: 1px solid var(--ink); border-radius: 999px; }
      .bag-button span { margin-left: 7px; color: var(--clay); }
      .shop-nav { width: min(100%, var(--page-max)); min-height: 48px; margin-inline: auto; padding: 0 var(--gutter); display: flex; align-items: center; justify-content: center; gap: clamp(22px, 3.5vw, 54px); border-top: 1px solid var(--line); }
      .shop-nav a, .shop-nav button { padding: 0; border: 0; background: transparent; font-size: 10px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; }
      .shop-nav a:hover, .shop-nav button:hover { color: var(--clay); }
      .mobile-menu { display: none; }
      .search-panel { padding: 28px clamp(18px, 4vw, 64px); border-top: 1px solid var(--line); background: var(--oat); }
      .search-panel form { max-width: 760px; margin: 0 auto; }
      .search-panel label { font-family: var(--serif); font-size: 30px; }
      .search-panel form > div { margin-top: 16px; display: grid; grid-template-columns: 1fr auto; }
      .search-panel input { min-width: 0; min-height: 50px; padding: 0 16px; border: 1px solid var(--ink); border-right: 0; background: var(--paper); }
      .search-panel button { padding: 0 24px; border: 1px solid var(--moss); color: var(--paper); background: var(--moss); }
      .search-panel p { margin: 10px 0 0; font-size: 11px; }

      .hero { position: relative; isolation: isolate; width: min(100%, var(--wide-max)); height: clamp(520px, calc(100svh - 162px), 860px); margin-inline: auto; display: grid; grid-template-columns: minmax(460px, 0.98fr) minmax(0, 1.02fr); background: var(--oat); border-bottom: 1px solid var(--line); }
      .hero::before { position: absolute; z-index: -1; inset-block: 0; left: 50%; width: 100vw; background: var(--oat); content: ""; transform: translateX(-50%); }
      .hero-copy { min-width: 0; padding: clamp(48px, 5vw, 80px) clamp(34px, 4.5vw, 72px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
      .hero-copy h1 { max-width: 690px; margin-bottom: 24px; font-size: clamp(56px, 5.2vw, 82px); line-height: 0.93; }
      .hero-copy h1 span { white-space: nowrap; }
      .hero-copy > p:not(.overline) { max-width: 560px; margin-bottom: 34px; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.65; }
      .hero-visual { min-width: 0; margin: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; overflow: hidden; background: #d8cbb7; }
      .hero-visual picture { min-height: 0; overflow: hidden; }
      .hero-visual img { height: 100%; object-fit: cover; object-position: 61% center; }
      .hero-visual figcaption { min-height: 32px; padding: 8px 16px; color: rgba(250, 247, 240, 0.86); background: var(--deep-moss); font-size: 8px; letter-spacing: 0.11em; text-align: right; text-transform: uppercase; }
      .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
      .primary-button, .hero-actions button, .light-button { min-height: 50px; padding: 0 21px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--moss); font-size: 10px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; }
      .primary-button { color: var(--paper); background: var(--moss); }
      .hero-actions button { padding: 0; border: 0; border-bottom: 1px solid var(--ink); background: transparent; }
      .hero-note { width: min(100%, 560px); margin-top: clamp(40px, 7vh, 76px); padding-top: 20px; display: grid; grid-template-columns: 120px 1fr; gap: 24px; border-top: 1px solid var(--line); }
      .hero-note strong { color: var(--clay); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
      .hero-note span { font-family: var(--serif); font-size: 15px; line-height: 1.35; }
      .service-row { min-height: 72px; padding: 14px max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; background: var(--oat); border-bottom: 1px solid var(--line); }
      .service-row p { margin: 0; padding: 0 22px; border-right: 1px solid var(--line); font-family: var(--serif); font-size: 16px; text-align: center; }
      .service-row p:last-child { border-right: 0; }
      .service-row span { margin-right: 7px; color: var(--clay); font-family: var(--sans); font-size: 9px; }

      .shop-section, .routine-section, .faq-section { padding: clamp(64px, 5vw, 88px) var(--gutter); }
      .shop-section, .faq-section { width: min(100%, var(--page-max)); margin-inline: auto; }
      .section-heading { margin-bottom: 52px; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr); align-items: end; gap: clamp(30px, 8vw, 130px); }
      .section-heading h2, .collection-copy h2, .why-copy h2, .faq-section h2, .newsletter h2 { margin-bottom: 0; font-size: clamp(44px, 4.5vw, 66px); line-height: 0.98; }
      .section-heading > p { margin-bottom: 4px; font-size: 15px; }
      .filter-bar { margin-bottom: 26px; display: flex; align-items: center; gap: 9px; }
      .filter-chip { min-height: 40px; padding: 0 17px; border: 1px solid var(--line); border-radius: 999px; background: transparent; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
      .filter-chip.is-active { color: var(--paper); background: var(--moss); border-color: var(--moss); }
      #product-count { margin-left: auto; color: rgba(38, 37, 31, 0.68); font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; }
      .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 54px clamp(16px, 2vw, 28px); }
      .product-card[hidden] { display: none; }
      .product-card { min-width: 0; display: flex; flex-direction: column; }
      .product-image { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 22px 22px 6px 6px; background: var(--oat); }
      .product-image picture, .product-image img { width: 100%; height: 100%; display: block; }
      .product-image img { object-fit: cover; transition: transform 450ms ease; }
      .product-card:hover .product-image img { transform: scale(1.035); }
      .image-action { position: absolute; right: 12px; bottom: 12px; left: 12px; min-height: 42px; border: 0; border-radius: 999px; background: rgba(250, 247, 240, 0.92); font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0; transform: translateY(8px); transition: 180ms ease; }
      .product-card:hover .image-action, .image-action:focus-visible { opacity: 1; transform: translateY(0); }
      .product-info { min-height: 154px; padding: 18px 2px 15px; display: flex; flex-direction: column; }
      .product-info > div { min-width: 0; }
      .product-kicker { margin-bottom: 7px; color: var(--clay); font-size: 8px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
      .product-info h3 { max-width: none; margin-bottom: 8px; font-size: clamp(22px, 1.65vw, 27px); line-height: 1.04; }
      .product-color { margin: 0; color: rgba(38, 37, 31, 0.67); font-size: 11px; }
      .price { margin: auto 0 0; padding-top: 11px; font-family: var(--serif); font-size: 20px; line-height: 1.1; text-align: left; }
      .price small { display: inline; margin-left: 5px; font-family: var(--sans); font-size: 7px; letter-spacing: 0.06em; text-transform: uppercase; }
      .quick-add { width: 100%; min-height: 48px; margin-top: auto; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--ink); background: transparent; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .quick-add:hover { color: var(--paper); background: var(--moss); border-color: var(--moss); }
      .quick-add span { font-size: 18px; font-weight: 400; }

      .collection-banner { width: min(calc(100% - (2 * var(--gutter))), 2000px); height: clamp(520px, 42vw, 680px); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr); overflow: hidden; border-radius: 3px 64px 3px 3px; color: var(--paper); background: var(--moss); }
      .collection-copy { padding: clamp(42px, 4.5vw, 76px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
      .collection-copy .overline { color: var(--mustard); }
      .collection-copy h2 { max-width: 640px; font-size: clamp(42px, 3.8vw, 58px); }
      .collection-copy > p:not(.overline) { max-width: 520px; margin: 22px 0; }
      .light-button { color: var(--ink); background: var(--paper); border-color: var(--paper); }
      .collection-copy small { margin-top: 16px; max-width: 370px; font-size: 8px; letter-spacing: 0.08em; text-transform: uppercase; }
      .collection-banner picture, .collection-banner img { height: 100%; min-height: 0; }
      .collection-banner img { object-fit: cover; }

      .section-heading--center { max-width: 1050px; margin-inline: auto; text-align: center; grid-template-columns: 1fr; gap: 22px; }
      .section-heading--center > p { max-width: 600px; margin: 0 auto; }
      .routine-section { background: var(--oat); }
      .routine-grid { width: min(100%, 1700px); margin-inline: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .routine-grid button { position: relative; min-height: 250px; padding: 68px 30px 30px; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; border: 1px solid var(--line); border-radius: 120px 120px 6px 6px; color: var(--paper); background: var(--moss); text-align: left; }
      .routine-grid button:nth-child(2) { color: var(--ink); background: var(--mustard); }
      .routine-grid button:nth-child(3) { background: var(--clay); }
      .routine-grid span { position: absolute; top: 30px; left: 50%; width: max-content; max-width: calc(100% - 80px); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-align: center; text-transform: uppercase; transform: translateX(-50%); }
      .routine-grid strong { font-family: var(--serif); font-size: clamp(36px, 3.2vw, 50px); font-weight: 400; letter-spacing: -0.045em; line-height: 0.98; }
      .routine-grid em { margin-top: 20px; padding-bottom: 3px; border-bottom: 1px solid currentColor; font-style: normal; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }

      .why-section { width: min(100%, var(--wide-max)); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(420px, 0.9fr); background: var(--paper); }
      .why-photo { position: relative; min-height: 560px; overflow: hidden; }
      .why-photo picture, .why-photo img { height: 100%; }
      .why-photo img { object-fit: cover; object-position: 62% center; }
      .why-photo > p { position: absolute; right: 12px; bottom: 10px; margin: 0; padding: 6px 9px; color: var(--paper); background: rgba(38, 50, 41, 0.88); font-size: 8px; letter-spacing: 0.08em; text-transform: uppercase; }
      .why-copy { padding: clamp(48px, 4.5vw, 72px); display: flex; flex-direction: column; justify-content: center; background: #e3dccb; }
      .why-copy h2 { max-width: 700px; font-size: clamp(44px, 4vw, 60px); }
      .why-intro { margin: 24px 0 30px; font-size: 16px; }
      .why-copy dl { margin: 0; }
      .why-copy dl div { padding: 20px 0; display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 24px; border-top: 1px solid var(--line); }
      .why-copy dt { font-family: var(--serif); font-size: 19px; }
      .why-copy dd { margin: 0; font-size: 13px; }

      .faq-section { display: grid; grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr); gap: clamp(56px, 7vw, 120px); }
      .faq-section h2 { font-size: clamp(44px, 4vw, 60px); }
      .faq-list { border-top: 1px solid var(--line); }
      .faq-list details { border-bottom: 1px solid var(--line); }
      .faq-list summary { min-height: 70px; padding: 18px 48px 18px 0; display: flex; align-items: center; position: relative; list-style: none; font-family: var(--serif); font-size: 21px; cursor: pointer; }
      .faq-list summary::-webkit-details-marker { display: none; }
      .faq-list summary::after { position: absolute; right: 5px; font-family: var(--sans); font-size: 18px; content: "+"; }
      .faq-list details[open] summary::after { content: "-"; }
      .faq-list p { max-width: 670px; margin-bottom: 26px; font-size: 14px; }

      .newsletter { padding: clamp(58px, 5vw, 78px) max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)); display: grid; grid-template-columns: minmax(0, 760px) minmax(380px, 640px); align-items: center; justify-content: center; gap: clamp(44px, 5vw, 80px); color: var(--paper); background: var(--clay); }
      .newsletter .overline { color: var(--oat); }
      .newsletter h2 { font-size: clamp(44px, 4vw, 60px); }
      .newsletter label { display: block; margin-bottom: 10px; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .newsletter form > div { display: grid; grid-template-columns: 1fr auto; }
      .newsletter input { min-width: 0; min-height: 52px; padding: 0 15px; border: 1px solid var(--paper); background: transparent; }
      .newsletter input::placeholder { color: rgba(250, 247, 240, 0.68); }
      .newsletter button { padding: 0 20px; border: 1px solid var(--paper); color: var(--ink); background: var(--paper); font-size: 9px; font-weight: 700; text-transform: uppercase; }
      .newsletter form p { margin: 10px 0 0; font-size: 9px; }

      footer { padding: 44px max(var(--gutter), calc((100vw - var(--page-max)) / 2 + 40px)) 28px; display: grid; grid-template-columns: 1fr auto; gap: 36px; color: var(--paper); background: var(--deep-moss); }
      .footer-brand { display: flex; align-items: center; gap: 14px; }
      .footer-brand .brand-mark { border-color: var(--oat); }
      .footer-brand div { display: flex; flex-direction: column; }
      .footer-brand strong { font-family: var(--serif); font-size: 34px; font-weight: 400; letter-spacing: -0.035em; }
      footer nav { display: flex; align-items: center; gap: 28px; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      footer > p { grid-column: 1 / -1; max-width: 970px; margin: 0; padding-top: 24px; border-top: 1px solid rgba(250, 247, 240, 0.2); font-size: 9px; letter-spacing: 0.07em; text-transform: uppercase; }

      dialog { border: 0; color: var(--ink); background: var(--paper); box-shadow: 0 30px 100px rgba(20, 24, 19, 0.35); }
      dialog::backdrop { background: rgba(25, 30, 24, 0.56); backdrop-filter: blur(4px); }
      .cart-drawer { width: min(480px, 100%); max-width: none; height: 100%; max-height: none; margin: 0 0 0 auto; padding: 0; }
      .cart-head { min-height: 120px; padding: 28px 28px 24px; display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid var(--line); }
      .cart-head h2 { margin: 0; font-size: 42px; }
      .cart-head button, .product-dialog > button:first-child { padding: 0; border: 0; border-bottom: 1px solid var(--ink); background: transparent; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .cart-items { min-height: calc(100% - 290px); padding: 24px 28px; }
      .empty-cart { font-family: var(--serif); font-size: 25px; }
      .cart-line { padding: 16px 0; display: flex; justify-content: space-between; gap: 22px; border-bottom: 1px solid var(--line); }
      .cart-line strong { font-family: var(--serif); font-size: 20px; font-weight: 400; }
      .cart-foot { padding: 24px 28px; border-top: 1px solid var(--line); }
      .cart-foot p { display: flex; justify-content: space-between; }
      .cart-foot button { width: 100%; min-height: 52px; border: 0; color: var(--paper); background: var(--moss); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .cart-foot small { margin-top: 12px; display: block; font-size: 8px; text-transform: uppercase; }
      .product-dialog { width: min(560px, calc(100% - 32px)); padding: clamp(34px, 5vw, 58px); border-radius: 4px 42px 4px 4px; }
      .product-dialog > button:first-child { float: right; }
      .product-dialog h2 { font-size: 52px; }
      .product-dialog .primary-button { margin-top: 18px; }
      .toast { position: fixed; z-index: 200; right: 20px; bottom: 20px; max-width: min(390px, calc(100% - 40px)); margin: 0; padding: 14px 18px; color: var(--paper); background: var(--deep-moss); font-size: 11px; opacity: 0; transform: translateY(16px); transition: 180ms ease; pointer-events: none; }
      .toast.is-visible { opacity: 1; transform: translateY(0); }

      @media (min-width: 2200px) {
        .header-main { min-height: 96px; }
        .shop-nav { min-height: 54px; }
        .hero { height: clamp(620px, calc(100svh - 180px), 920px); }
        .hero-copy { padding-inline: 88px; }
        .hero-copy h1 { max-width: 820px; font-size: 96px; }
        .hero-copy > p:not(.overline) { max-width: 650px; font-size: 21px; }
        .hero-note { max-width: 650px; }
        .hero-note span { font-size: 17px; }
        .section-heading h2 { font-size: 70px; }
        .product-info h3 { font-size: 28px; }
        .price { font-size: 21px; }
      }

      @media (max-width: 1180px) {
        .header-main { grid-template-columns: 1fr minmax(210px, 0.7fr) auto; }
        .shop-nav { gap: 22px; }
        .hero { grid-template-columns: minmax(390px, 0.96fr) minmax(0, 1.04fr); }
        .hero-copy { padding: 48px 36px; }
        .hero-copy h1 { font-size: clamp(48px, 5.2vw, 64px); }
        .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 20px; }
        .collection-banner { grid-template-columns: 1fr 1fr; }
        .why-copy { padding: 70px 56px; }
      }

      @media (max-width: 920px) and (min-width: 761px) {
        .header-main { grid-template-columns: 1fr auto; }
        .search-trigger { display: none; }
        .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hero { grid-template-columns: minmax(330px, 0.9fr) minmax(0, 1.1fr); }
        .hero-copy { padding: 46px 32px; }
        .hero-copy h1 { font-size: 46px; }
        .hero-note { grid-template-columns: 1fr; gap: 8px; }
      }

      @media (max-width: 760px) {
        html { scroll-padding-top: 102px; }
        .concept-strip { min-height: 30px; padding: 6px 12px; justify-content: center; text-align: center; }
        .concept-strip a { display: none; }
        .header-main { min-height: 72px; padding: 0 15px; grid-template-columns: 1fr auto; gap: 12px; }
        .brand { gap: 9px; }
        .brand-mark { width: 35px; height: 39px; }
        .brand-mark::before { top: 10px; left: 7px; width: 7px; height: 8px; }
        .brand-mark::after { top: 10px; right: 7px; width: 7px; height: 8px; }
        .brand-mark i { bottom: 6px; left: 11px; width: 11px; height: 12px; }
        .brand-copy { font-size: 19px; }
        .brand-copy small { font-size: 6px; }
        .search-trigger, .account-button, .shop-nav { display: none; }
        .header-actions { gap: 10px; }
        .bag-button { min-height: 38px; padding: 0 12px; font-size: 9px; }
        .mobile-menu { position: static; display: block; }
        .mobile-menu summary { width: 40px; height: 40px; display: grid; place-items: center; list-style: none; cursor: pointer; }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu summary span, .mobile-menu summary span::before, .mobile-menu summary span::after { width: 22px; height: 1px; display: block; background: var(--ink); content: ""; }
        .mobile-menu summary span::before { transform: translateY(-6px); }
        .mobile-menu summary span::after { transform: translateY(5px); }
        .mobile-menu nav { position: absolute; top: 72px; right: 0; left: 0; padding: 12px 18px 20px; display: grid; border-bottom: 1px solid var(--line); background: var(--oat); box-shadow: 0 20px 40px rgba(38, 37, 31, 0.18); }
        .mobile-menu nav a, .mobile-menu nav button { min-height: 48px; padding: 0; display: flex; align-items: center; border: 0; border-bottom: 1px solid var(--line); background: transparent; font-family: var(--serif); font-size: 21px; text-align: left; }

        .hero { min-height: 0; height: auto; max-height: none; grid-template-columns: 1fr; }
        .hero-copy { padding: 38px 20px 34px; }
        .hero-copy h1 { max-width: 520px; margin-bottom: 20px; font-size: clamp(40px, 11vw, 50px); line-height: 0.96; }
        .hero-copy > p:not(.overline) { margin-bottom: 26px; font-size: 15px; line-height: 1.6; }
        .hero-actions { width: 100%; align-items: stretch; flex-direction: column; gap: 12px; }
        .hero-actions .primary-button { width: 100%; }
        .hero-actions button { align-self: flex-start; min-height: 38px; }
        .hero-note { margin-top: 28px; padding-top: 14px; grid-template-columns: 1fr; gap: 6px; }
        .hero-note span { font-size: 14px; }
        .hero-visual { height: auto; }
        .hero-visual picture { aspect-ratio: 4 / 3; }
        .hero-visual img { object-position: 62% center; }
        .hero-visual figcaption { min-height: 30px; padding-inline: 12px; font-size: 7px; }
        .service-row { padding: 18px; grid-template-columns: 1fr 1fr; gap: 0; }
        .service-row p { min-height: 54px; padding: 12px 8px; display: flex; align-items: center; justify-content: center; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 13px; }
        .service-row p:nth-child(2) { border-right: 0; }
        .service-row p:nth-child(n + 3) { border-bottom: 0; }

        .shop-section, .routine-section, .faq-section { padding: 56px 16px; }
        .section-heading { margin-bottom: 34px; grid-template-columns: 1fr; gap: 20px; }
        .section-heading h2, .collection-copy h2, .why-copy h2, .faq-section h2, .newsletter h2 { font-size: clamp(38px, 10.5vw, 48px); }
        .filter-bar { margin-inline: -16px; padding: 0 16px 4px; overflow-x: auto; scrollbar-width: none; }
        .filter-bar::-webkit-scrollbar { display: none; }
        .filter-chip { flex: 0 0 auto; }
        #product-count { display: none; }
        .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 42px 12px; }
        .product-image { border-radius: 14px 14px 4px 4px; }
        .image-action { display: none; }
        .product-info { min-height: 150px; padding: 14px 1px 12px; display: flex; flex-direction: column; gap: 0; }
        .product-kicker { min-height: 26px; margin-bottom: 5px; font-size: 7px; line-height: 1.35; }
        .product-info h3 { max-width: none; margin-bottom: 7px; font-size: 22px; line-height: 1.03; }
        .product-color { font-size: 9px; line-height: 1.35; }
        .price { margin-top: auto; padding-top: 9px; font-size: 18px; text-align: left; }
        .price small { display: inline; margin-left: 4px; font-size: 6px; }
        .quick-add { min-height: 44px; padding: 0 12px; font-size: 8px; }

        .collection-banner { width: calc(100% - 32px); height: auto; margin: 0 16px; display: flex; flex-direction: column-reverse; border-radius: 3px 38px 3px 3px; }
        .collection-copy { padding: 30px 20px; }
        .collection-copy h2 { font-size: 38px; }
        .collection-copy > p:not(.overline) { margin: 16px 0; font-size: 14px; line-height: 1.5; }
        .collection-copy small { margin-top: 12px; font-size: 7px; }
        .collection-banner picture, .collection-banner img { min-height: 270px; }
        .routine-grid { grid-template-columns: 1fr; }
        .routine-grid button { min-height: 184px; padding: 56px 24px 24px; border-radius: 92px 92px 5px 5px; }
        .routine-grid span { top: 25px; }
        .routine-grid strong { font-size: 38px; }

        .why-section { grid-template-columns: 1fr; }
        .why-photo { min-height: 340px; }
        .why-photo img { object-position: 60% center; }
        .why-copy { padding: 44px 20px; }
        .why-copy h2 { font-size: 40px; }
        .why-intro { margin: 20px 0 24px; font-size: 15px; }
        .why-copy dl div { padding: 12px 0; grid-template-columns: 1fr; gap: 4px; }
        .why-copy dd { font-size: 12px; }
        .faq-section { grid-template-columns: 1fr; gap: 32px; }
        .faq-list summary { min-height: 66px; font-size: 18px; }
        .newsletter { padding: 50px 20px; grid-template-columns: 1fr; gap: 28px; }
        .newsletter form > div { grid-template-columns: 1fr; }
        .newsletter input { border-bottom: 0; }
        .newsletter button { min-height: 50px; }
        footer { padding: 42px 20px 26px; grid-template-columns: 1fr; gap: 28px; }
        footer nav { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        .cart-drawer { width: 100%; }
        .cart-head h2 { font-size: 36px; }
        .toast { right: 12px; bottom: 12px; max-width: calc(100% - 24px); }
      }

      @media (max-width: 370px) {
        .brand-copy { font-size: 17px; }
        .bag-button { padding-inline: 9px; }
        .hero-copy h1 { font-size: 39px; }
        .product-grid { gap-inline: 10px; }
        .product-info { min-height: 154px; }
        .product-info h3 { font-size: 20px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; }
      }
    </style>

    <script is:inline>
      const bagButton = document.querySelector("#bag-button");
      const bagCount = document.querySelector("#bag-count");
      const cartDialog = document.querySelector("#cart-dialog");
      const cartClose = document.querySelector("#cart-close");
      const cartItems = document.querySelector("#cart-items");
      const cartSubtotal = document.querySelector("#cart-subtotal");
      const toast = document.querySelector("#toast");
      const productDialog = document.querySelector("#product-dialog");
      const productDialogTitle = document.querySelector("#product-dialog-title");
      const previewAdd = document.querySelector("#preview-add");
      const products = [];
      let toastTimer;

      const showToast = (message) => {
        toast.textContent = message;
        toast.classList.add("is-visible");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2600);
      };

      const renderBag = () => {
        bagCount.textContent = String(products.length);
        if (!products.length) {
          cartItems.innerHTML = '<p class="empty-cart">Your concept bag is empty.</p>';
          cartSubtotal.textContent = "$0";
          return;
        }
        cartItems.innerHTML = products.map((item) => `<div class="cart-line"><strong>${item.name}</strong><span>${item.price}</span></div>`).join("");
        const subtotal = products.reduce((total, item) => total + Number(item.price.replace(/[^0-9.]/g, "")), 0);
        cartSubtotal.textContent = `$${subtotal}`;
      };

      const addProduct = (name, price) => {
        products.push({ name, price });
        renderBag();
        showToast(`${name} was added to the concept bag. Nothing was purchased.`);
      };

      document.querySelectorAll("[data-add]").forEach((button) => {
        button.addEventListener("click", () => addProduct(button.dataset.add, button.dataset.price));
      });

      bagButton.addEventListener("click", () => cartDialog.showModal());
      cartClose.addEventListener("click", () => cartDialog.close());
      document.querySelector("#checkout-button").addEventListener("click", () => showToast("Checkout is intentionally disabled in this fictional concept."));

      document.querySelectorAll("[data-preview]").forEach((button) => {
        button.addEventListener("click", () => {
          const name = button.dataset.preview;
          const addButton = button.closest(".product-card").querySelector("[data-add]");
          productDialogTitle.textContent = name;
          previewAdd.dataset.name = name;
          previewAdd.dataset.price = addButton.dataset.price;
          productDialog.showModal();
        });
      });
      document.querySelector("#product-dialog-close").addEventListener("click", () => productDialog.close());
      previewAdd.addEventListener("click", () => {
        addProduct(previewAdd.dataset.name, previewAdd.dataset.price);
        productDialog.close();
      });

      const filterProducts = (category, searchTerm = "") => {
        let visible = 0;
        document.querySelectorAll("[data-product-card]").forEach((card) => {
          const categoryMatch = category === "all" || card.dataset.category === category;
          const searchMatch = !searchTerm || card.dataset.search.includes(searchTerm);
          card.hidden = !(categoryMatch && searchMatch);
          if (!card.hidden) visible += 1;
        });
        document.querySelectorAll("[data-filter]").forEach((chip) => {
          const active = chip.dataset.filter === category;
          chip.classList.toggle("is-active", active);
          chip.setAttribute("aria-pressed", String(active));
        });
        document.querySelector("#product-count").textContent = `${visible} concept product${visible === 1 ? "" : "s"}`;
        return visible;
      };

      document.querySelectorAll("[data-filter]").forEach((chip) => {
        chip.addEventListener("click", () => filterProducts(chip.dataset.filter));
      });
      document.querySelectorAll("[data-category-link]").forEach((link) => {
        link.addEventListener("click", () => {
          filterProducts(link.dataset.categoryLink);
          document.querySelector("#shop").scrollIntoView({ behavior: "smooth" });
          const menu = link.closest("details");
          if (menu) menu.removeAttribute("open");
        });
      });

      const searchTrigger = document.querySelector("#search-trigger");
      const searchPanel = document.querySelector("#search-panel");
      searchTrigger.addEventListener("click", () => {
        const opening = searchPanel.hidden;
        searchPanel.hidden = !opening;
        searchTrigger.setAttribute("aria-expanded", String(opening));
        if (opening) document.querySelector("#shop-search").focus();
      });
      document.querySelector("#search-form").addEventListener("submit", (event) => {
        event.preventDefault();
        const query = document.querySelector("#shop-search").value.trim().toLowerCase();
        const visible = filterProducts("all", query);
        document.querySelector("#search-status").textContent = visible ? `${visible} concept product${visible === 1 ? "" : "s"} matched.` : "No concept products matched that search.";
        searchPanel.hidden = true;
        searchTrigger.setAttribute("aria-expanded", "false");
        document.querySelector("#shop").scrollIntoView({ behavior: "smooth" });
      });

      document.querySelectorAll("[data-demo]").forEach((button) => button.addEventListener("click", () => showToast("Account features are not active in this fictional concept.")));
      document.querySelector("#newsletter-form").addEventListener("submit", (event) => {
        event.preventDefault();
        document.querySelector("#newsletter-status").textContent = "Concept signup complete. Nothing was sent or saved.";
      });
    </script>
  </body>
</html>
