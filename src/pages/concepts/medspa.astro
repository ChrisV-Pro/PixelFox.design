<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Velaire Aesthetic Studio, an independent fictional medspa landing page concept by PixelFox.design."
    />
    <meta name="theme-color" content="#17372f" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2317372f'/%3E%3Cpath d='M14 17h9l9 25 9-25h9L36 50h-8z' fill='%23e1b9aa'/%3E%3C/svg%3E" />
    <link rel="canonical" href="https://pixelfox.design/concepts/medspa/" />
    <title>Velaire Aesthetic Studio | Independent Medspa Concept</title>
    <style>
      :root {
        --ink: #17231f;
        --pine: #17372f;
        --pine-light: #285247;
        --cream: #f3eee5;
        --paper: #fbf8f2;
        --mist: #dbe7e1;
        --copper: #bf694b;
        --blush: #e1b9aa;
        --line-dark: rgba(23, 35, 31, 0.18);
        --line-light: rgba(251, 248, 242, 0.22);
        --serif: "Bodoni 72", Didot, "Times New Roman", serif;
        --sans: "Avenir Next", "Trebuchet MS", sans-serif;
        --gutter: clamp(24px, 5vw, 76px);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-width: 0;
        overflow-x: hidden;
        color: var(--ink);
        background: var(--paper);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      svg { display: block; }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 100;
        padding: 12px 16px;
        color: var(--paper);
        background: var(--ink);
        transform: translateY(-150%);
      }
      .skip-link:focus { transform: translateY(0); }

      .concept-ribbon {
        min-height: 34px;
        padding: 8px var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        color: var(--paper);
        background: var(--copper);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .concept-ribbon a { border-bottom: 1px solid currentColor; }

      .site-header {
        position: relative;
        z-index: 30;
        min-height: 92px;
        padding: 0 var(--gutter);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        color: var(--paper);
        background: var(--pine);
        border-bottom: 1px solid var(--line-light);
      }
      .brand { display: inline-flex; width: max-content; flex-direction: column; }
      .brand strong {
        font-family: var(--serif);
        font-size: 24px;
        font-weight: 400;
        letter-spacing: 0.17em;
      }
      .brand small {
        margin-top: 5px;
        font-size: 7px;
        font-weight: 700;
        letter-spacing: 0.32em;
      }
      .desktop-nav { display: flex; align-items: center; gap: 34px; }
      .desktop-nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .header-cta {
        justify-self: end;
        min-height: 44px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        gap: 24px;
        color: var(--ink);
        background: var(--mist);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .mobile-menu { display: none; }

      .hero {
        min-height: calc(100vh - 126px);
        display: grid;
        grid-template-columns: minmax(0, 1.06fr) minmax(420px, 0.94fr);
        color: var(--paper);
        background: var(--pine);
      }
      .hero-copy {
        padding: clamp(70px, 8vw, 124px) var(--gutter) 64px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .kicker,
      .section-index {
        margin: 0;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.18em;
        line-height: 1.5;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 10.5ch;
        margin: 28px 0 0;
        font-family: var(--serif);
        font-size: clamp(68px, 7.7vw, 118px);
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 0.87;
      }
      .hero h1 em { color: var(--blush); font-weight: 400; }
      .hero-intro {
        max-width: 570px;
        margin: 34px 0 0;
        color: rgba(251, 248, 242, 0.78);
        font-size: 16px;
        line-height: 1.7;
      }
      .hero-actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 10px; }
      .button {
        min-height: 54px;
        padding: 0 24px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 28px;
        border: 1px solid currentColor;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        transition: color 180ms ease, background 180ms ease, transform 180ms ease;
      }
      .button:hover { transform: translateY(-2px); }
      .button-light { color: var(--ink); background: var(--mist); border-color: var(--mist); }
      .button-ghost { color: var(--paper); }
      .hero-proof {
        width: 100%;
        margin-top: auto;
        padding-top: 60px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }
      .hero-proof span {
        padding-top: 14px;
        border-top: 1px solid var(--line-light);
        color: rgba(251, 248, 242, 0.64);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hero-visual {
        position: relative;
        min-height: 650px;
        overflow: hidden;
        background: var(--mist);
      }
      .hero-visual > svg { width: 100%; height: 100%; }
      .visual-number {
        position: absolute;
        top: 26px;
        right: 30px;
        z-index: 2;
        color: var(--ink);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.16em;
      }
      .care-note {
        position: absolute;
        left: 30px;
        bottom: 30px;
        width: min(270px, calc(100% - 60px));
        padding: 20px;
        color: var(--paper);
        background: rgba(23, 35, 31, 0.9);
        backdrop-filter: blur(10px);
      }
      .care-note small {
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .care-note strong {
        margin-top: 10px;
        display: block;
        font-family: var(--serif);
        font-size: 25px;
        font-weight: 400;
        line-height: 1.1;
      }

      .treatment-strip {
        min-height: 56px;
        padding: 0 var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        overflow: hidden;
        color: var(--paper);
        background: var(--copper);
        font-family: var(--serif);
        font-size: 16px;
        font-style: italic;
        white-space: nowrap;
      }
      .treatment-strip i { width: 5px; height: 5px; flex: 0 0 auto; border-radius: 50%; background: var(--paper); opacity: 0.7; }

      .section { padding: clamp(82px, 10vw, 150px) var(--gutter); }
      .section-heading {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 60px;
        align-items: start;
      }
      .section-heading h2,
      .philosophy h2,
      .consult-copy h2,
      .faq-heading h2 {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(54px, 6.1vw, 92px);
        font-weight: 400;
        letter-spacing: -0.045em;
        line-height: 0.94;
      }
      .section-heading h2 em,
      .philosophy h2 em,
      .consult-copy h2 em,
      .faq-heading h2 em { color: var(--copper); font-weight: 400; }
      .section-heading > div:last-child { padding-top: 8px; }
      .section-heading .lead {
        max-width: 620px;
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(24px, 2.3vw, 34px);
        line-height: 1.22;
      }
      .section-heading .detail {
        max-width: 560px;
        margin: 24px 0 0;
        color: rgba(23, 35, 31, 0.68);
        font-size: 14px;
        line-height: 1.75;
      }

      .treatments { background: var(--paper); }
      .treatment-grid {
        margin-top: 78px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--line-dark);
      }
      .treatment-card {
        min-height: 390px;
        padding: 24px 24px 26px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--line-dark);
        transition: color 200ms ease, background 200ms ease;
      }
      .treatment-card:first-child { border-left: 1px solid var(--line-dark); }
      .treatment-card:hover { color: var(--paper); background: var(--pine); }
      .treatment-card small { font-size: 9px; font-weight: 700; letter-spacing: 0.15em; }
      .treatment-card svg { width: 76px; height: 76px; margin: 50px 0 34px; }
      .treatment-card h3 {
        margin: 0;
        font-family: var(--serif);
        font-size: 30px;
        font-weight: 400;
        line-height: 1.05;
      }
      .treatment-card p { margin: 14px 0 0; font-size: 12px; line-height: 1.65; opacity: 0.7; }
      .treatment-card .arrow { margin-top: auto; align-self: flex-end; font-size: 22px; }

      .philosophy {
        position: relative;
        overflow: hidden;
        padding: clamp(90px, 11vw, 160px) var(--gutter);
        color: var(--paper);
        background: var(--ink);
      }
      .philosophy::before {
        content: "";
        position: absolute;
        top: -36vw;
        right: -26vw;
        width: 70vw;
        height: 70vw;
        border: 1px solid rgba(219, 231, 225, 0.16);
        border-radius: 50%;
        box-shadow: 0 0 0 9vw rgba(219, 231, 225, 0.03), 0 0 0 18vw rgba(219, 231, 225, 0.025);
      }
      .philosophy-grid {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
        gap: 11vw;
        align-items: end;
      }
      .philosophy h2 { max-width: 9ch; }
      .philosophy-copy { padding-bottom: 8px; }
      .philosophy-copy p {
        margin: 0;
        color: rgba(251, 248, 242, 0.72);
        font-size: 15px;
        line-height: 1.75;
      }
      .philosophy-copy p + p { margin-top: 20px; }
      .philosophy-points { margin-top: 44px; display: grid; gap: 0; border-top: 1px solid var(--line-light); }
      .philosophy-points span {
        min-height: 55px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line-light);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .process { background: var(--mist); }
      .process-top {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        align-items: end;
      }
      .process-top h2 {
        max-width: 10ch;
        margin: 18px 0 0;
        font-family: var(--serif);
        font-size: clamp(54px, 6.6vw, 96px);
        font-weight: 400;
        letter-spacing: -0.05em;
        line-height: 0.92;
      }
      .process-top > p:last-child { max-width: 390px; margin: 0; font-size: 14px; line-height: 1.7; }
      .process-grid {
        margin-top: 76px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }
      .process-card {
        min-height: 330px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        background: var(--paper);
      }
      .process-card small { font-size: 9px; font-weight: 700; letter-spacing: 0.15em; }
      .process-card h3 {
        margin: auto 0 16px;
        font-family: var(--serif);
        font-size: 40px;
        font-weight: 400;
      }
      .process-card p { margin: 0; color: rgba(23, 35, 31, 0.65); font-size: 13px; line-height: 1.65; }

      .consult {
        padding: clamp(82px, 10vw, 146px) var(--gutter);
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(460px, 1.15fr);
        gap: 10vw;
        color: var(--paper);
        background: var(--pine);
      }
      .consult-copy h2 { max-width: 8ch; margin-top: 20px; }
      .consult-copy > p:last-of-type { max-width: 470px; margin: 28px 0 0; color: rgba(251, 248, 242, 0.7); font-size: 14px; line-height: 1.75; }
      .concept-note {
        margin-top: 38px;
        padding: 18px;
        border: 1px solid var(--line-light);
        color: rgba(251, 248, 242, 0.72);
        font-size: 11px;
        line-height: 1.6;
      }
      .consult-form { padding-top: 4px; }
      .form-intro {
        margin: 0 0 30px;
        font-family: var(--serif);
        font-size: 30px;
      }
      .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
      .field { margin-bottom: 24px; }
      .field label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .field input,
      .field select,
      .field textarea {
        width: 100%;
        min-height: 52px;
        padding: 12px 0;
        color: var(--paper);
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--line-light);
        border-radius: 0;
        outline: none;
      }
      .field textarea { min-height: 104px; resize: vertical; }
      .field input::placeholder,
      .field textarea::placeholder { color: rgba(251, 248, 242, 0.42); }
      .field input:focus,
      .field select:focus,
      .field textarea:focus { border-bottom-color: var(--blush); }
      .field select { color-scheme: dark; }
      .form-actions { display: flex; align-items: center; gap: 20px; }
      .form-button { cursor: pointer; color: var(--ink); background: var(--blush); border-color: var(--blush); }
      .form-caption, .form-status { margin: 0; font-size: 10px; line-height: 1.55; }
      .form-caption { max-width: 240px; color: rgba(251, 248, 242, 0.58); }
      .form-status { margin-top: 18px; padding: 13px 15px; color: var(--ink); background: var(--mist); }

      .faq {
        padding: clamp(82px, 10vw, 146px) var(--gutter);
        display: grid;
        grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
        gap: 9vw;
        background: var(--paper);
      }
      .faq-heading h2 { margin-top: 20px; }
      .faq-list { border-top: 1px solid var(--line-dark); }
      .faq-list details { border-bottom: 1px solid var(--line-dark); }
      .faq-list summary {
        min-height: 78px;
        cursor: pointer;
        list-style: none;
        display: grid;
        grid-template-columns: 42px 1fr auto;
        gap: 12px;
        align-items: center;
        font-family: var(--serif);
        font-size: 21px;
      }
      .faq-list summary::-webkit-details-marker { display: none; }
      .faq-list summary small { font-family: var(--sans); font-size: 8px; font-weight: 700; letter-spacing: 0.14em; }
      .faq-list summary::after { content: "+"; font-family: var(--sans); font-size: 18px; font-weight: 300; }
      .faq-list details[open] summary::after { content: "-"; }
      .faq-answer { max-width: 640px; padding: 0 42px 28px 54px; color: rgba(23, 35, 31, 0.67); font-size: 13px; line-height: 1.75; }

      .site-footer {
        padding: 48px var(--gutter) 30px;
        color: var(--paper);
        background: var(--ink);
      }
      .footer-top { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: start; }
      .footer-mark {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(40px, 4vw, 60px);
        letter-spacing: -0.04em;
      }
      .footer-mark em { color: var(--blush); font-weight: 400; }
      .footer-nav { display: flex; gap: 28px; }
      .footer-nav a { min-height: 44px; display: flex; align-items: center; font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
      .footer-bottom {
        margin-top: 54px;
        padding-top: 18px;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        border-top: 1px solid var(--line-light);
        color: rgba(251, 248, 242, 0.54);
        font-size: 9px;
        line-height: 1.6;
      }
      .footer-bottom p { max-width: 690px; margin: 0; }

      .mobile-appointment { display: none; }

      @media (max-width: 1000px) {
        .site-header { grid-template-columns: 1fr auto; }
        .desktop-nav { display: none; }
        .hero { grid-template-columns: minmax(0, 1fr) minmax(360px, 0.75fr); }
        .hero-proof { grid-template-columns: 1fr; gap: 4px; }
        .hero-proof span { padding-top: 10px; }
        .treatment-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .treatment-card:nth-child(3) { border-left: 1px solid var(--line-dark); }
        .treatment-card { border-bottom: 1px solid var(--line-dark); }
        .philosophy-grid { grid-template-columns: 1fr 0.8fr; gap: 7vw; }
        .consult { grid-template-columns: 0.8fr 1.2fr; gap: 6vw; }
      }

      @media (max-width: 760px) {
        :root { --gutter: 22px; }
        html { scroll-behavior: auto; scroll-padding-top: 72px; }
        .concept-ribbon { min-height: 40px; font-size: 8px; }
        .concept-ribbon span:last-child { display: none; }
        .site-header {
          position: sticky;
          top: 0;
          min-height: 72px;
          grid-template-columns: 1fr auto;
          background: rgba(23, 55, 47, 0.95);
          backdrop-filter: blur(12px);
        }
        .brand strong { font-size: 21px; }
        .header-cta { display: none; }
        .mobile-menu { display: block; }
        .mobile-menu summary {
          min-width: 50px;
          min-height: 44px;
          cursor: pointer;
          list-style: none;
          display: flex;
          justify-content: flex-end;
          align-items: center;
          font-size: 9px;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu summary::after { content: "Menu"; }
        .mobile-menu[open] summary::after { content: "Close"; }
        .mobile-menu nav {
          position: absolute;
          top: 72px;
          right: 0;
          left: 0;
          padding: 12px var(--gutter) 20px;
          display: grid;
          color: var(--paper);
          background: var(--pine);
          border-top: 1px solid var(--line-light);
          box-shadow: 0 20px 34px rgba(10, 25, 21, 0.2);
        }
        .mobile-menu nav a {
          min-height: 50px;
          display: flex;
          align-items: center;
          border-bottom: 1px solid var(--line-light);
          font-family: var(--serif);
          font-size: 21px;
        }

        .hero { min-height: 0; grid-template-columns: 1fr; }
        .hero-copy { min-height: 670px; padding: 58px var(--gutter) 42px; }
        .hero h1 { max-width: 11ch; margin-top: 24px; font-size: clamp(56px, 17vw, 78px); line-height: 0.9; }
        .hero-intro { margin-top: 26px; font-size: 14px; }
        .hero-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
        .button { padding-inline: 16px; gap: 14px; }
        .hero-proof { margin-top: 44px; padding-top: 0; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .hero-proof span { font-size: 7px; }
        .hero-visual { min-height: 500px; }
        .care-note { left: 20px; bottom: 20px; }
        .treatment-strip { min-height: 50px; padding-right: 0; justify-content: flex-start; gap: 18px; font-size: 14px; }

        .section { padding: 78px var(--gutter); }
        .section-heading { grid-template-columns: 1fr; gap: 28px; }
        .section-heading h2,
        .philosophy h2,
        .consult-copy h2,
        .faq-heading h2 { font-size: clamp(49px, 14vw, 64px); }
        .section-heading .lead { font-size: 24px; }
        .treatment-grid { margin-top: 52px; grid-template-columns: 1fr; }
        .treatment-card,
        .treatment-card:first-child,
        .treatment-card:nth-child(3) {
          min-height: 220px;
          padding: 22px 0;
          display: grid;
          grid-template-columns: 64px 1fr 34px;
          grid-template-rows: auto 1fr;
          column-gap: 16px;
          border-right: 0;
          border-left: 0;
        }
        .treatment-card small { grid-column: 1; grid-row: 1; }
        .treatment-card svg { grid-column: 1; grid-row: 2; width: 52px; height: 52px; margin: 25px 0 0; }
        .treatment-card h3 { grid-column: 2; grid-row: 1; font-size: 27px; }
        .treatment-card p { grid-column: 2; grid-row: 2; }
        .treatment-card .arrow { grid-column: 3; grid-row: 1 / span 2; margin: 0; align-self: center; }

        .philosophy { padding: 84px var(--gutter); }
        .philosophy-grid { grid-template-columns: 1fr; gap: 44px; }
        .philosophy h2 { max-width: 10ch; }
        .philosophy-copy p { font-size: 14px; }

        .process-top { display: block; }
        .process-top h2 { font-size: clamp(52px, 15vw, 68px); }
        .process-top > p:last-child { margin-top: 26px; }
        .process-grid { margin-top: 48px; grid-template-columns: 1fr; gap: 12px; }
        .process-card { min-height: 230px; }
        .process-card h3 { font-size: 36px; }

        .consult { padding: 82px var(--gutter); grid-template-columns: 1fr; gap: 58px; }
        .consult-copy h2 { max-width: 10ch; }
        .field-grid { grid-template-columns: 1fr; gap: 0; }
        .field input, .field select, .field textarea { font-size: 16px; }
        .form-actions { align-items: stretch; flex-direction: column; }
        .form-button { width: 100%; }
        .form-caption { max-width: none; }

        .faq { padding: 82px var(--gutter); grid-template-columns: 1fr; gap: 44px; }
        .faq-list summary { min-height: 74px; grid-template-columns: 32px 1fr auto; font-size: 18px; }
        .faq-answer { padding: 0 0 26px 44px; }

        .site-footer { padding-bottom: 92px; }
        .footer-top { grid-template-columns: 1fr; }
        .footer-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
        .footer-bottom { margin-top: 38px; flex-direction: column; }
        .mobile-appointment {
          position: fixed;
          right: 12px;
          bottom: 12px;
          left: 12px;
          z-index: 25;
          min-height: 54px;
          padding: 0 20px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          color: var(--ink);
          background: var(--blush);
          box-shadow: 0 14px 30px rgba(12, 28, 23, 0.22);
          font-size: 9px;
          font-weight: 700;
          letter-spacing: 0.13em;
          text-transform: uppercase;
          opacity: 0;
          pointer-events: none;
          transform: translateY(calc(100% + 24px));
          transition: opacity 180ms ease, transform 180ms ease;
        }
        .mobile-appointment.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
      }

      @media (max-width: 430px) {
        .hero-copy { min-height: 650px; }
        .hero h1 { font-size: clamp(50px, 16vw, 64px); }
        .hero-actions { grid-template-columns: 1fr; }
        .hero-proof { grid-template-columns: 1fr; }
        .hero-visual { min-height: 430px; }
        .care-note strong { font-size: 22px; }
        .section-heading h2,
        .philosophy h2,
        .consult-copy h2,
        .faq-heading h2 { font-size: clamp(44px, 13.5vw, 56px); }
        .treatment-card { min-height: 244px; }
        .footer-mark { font-size: 38px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 0.01ms !important; }
      }
    </style>
  </head>
  <body id="top">
