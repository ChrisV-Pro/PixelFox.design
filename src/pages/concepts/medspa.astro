              <label for="concept-name">First name</label>
              <input id="concept-name" name="name" placeholder="Your name" autocomplete="off" />
            </div>
            <div class="field">
              <label for="concept-interest">Area of interest</label>
              <select id="concept-interest" name="interest">
                <option>Consultation</option>
                <option>Skin renewal</option>
                <option>Injectable care</option>
                <option>Laser + light</option>
                <option>Not sure yet</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="concept-message">What would you like to discuss?</label>
            <textarea id="concept-message" name="message" placeholder="A few words about your goals or questions"></textarea>
          </div>
          <div class="form-actions">
            <button class="button form-button" type="submit">Preview request <span aria-hidden="true">&#8594;</span></button>
            <p class="form-caption">Demonstration only. Nothing is sent.</p>
          </div>
          <p class="form-status" id="form-status" hidden role="status">Preview complete. No appointment was submitted and no information was sent.</p>
