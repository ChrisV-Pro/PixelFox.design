            </defs>
            <rect width="760" height="920" fill="url(#bg)" />
            <circle cx="90" cy="164" r="250" fill="#f3eee5" opacity="0.72" />
            <circle cx="675" cy="730" r="340" fill="#285247" opacity="0.72" />
            <path d="M212 880C184 696 195 520 252 343C303 185 418 64 542 78C631 88 670 156 666 241C662 318 607 349 592 407C578 463 624 500 591 562C551 636 449 641 424 704C403 758 446 824 469 880Z" fill="#17372f" />
            <path d="M302 871C273 739 266 582 307 420C345 269 431 141 525 133C600 127 627 190 612 259C601 310 547 341 548 392C550 448 604 475 570 531C533 591 444 589 410 641C373 697 407 791 421 871Z" fill="url(#skin)" />
            <path d="M252 318C353 268 454 273 558 330C486 353 424 398 375 467C318 433 277 383 252 318Z" fill="#f3eee5" opacity="0.72" />
            <path d="M85 566C233 472 381 446 529 488C395 527 283 616 194 755C146 704 110 641 85 566Z" fill="url(#light)" />
            <circle cx="475" cy="338" r="10" fill="#17231f" />
