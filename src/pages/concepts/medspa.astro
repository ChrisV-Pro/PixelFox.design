    <a class="mobile-appointment" href="#consult" aria-hidden="true" tabindex="-1">Plan a consultation <span aria-hidden="true">&#8594;</span></a>

    <script>
      const menu = document.querySelector('.mobile-menu');
      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => menu.removeAttribute('open'));
      });

      const form = document.querySelector('#concept-form');
      const status = document.querySelector('#form-status');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        status?.removeAttribute('hidden');
      });

      const mobileAppointment = document.querySelector('.mobile-appointment');
      const hero = document.querySelector('.hero');
      const consult = document.querySelector('#consult');
      let updateQueued = false;

      const updateMobileAppointment = () => {
        updateQueued = false;
        if (!mobileAppointment || !hero || !consult) return;

        const heroRect = hero.getBoundingClientRect();
        const consultRect = consult.getBoundingClientRect();
        const consultVisible = consultRect.top < window.innerHeight && consultRect.bottom > 0;
        const shouldShow = window.innerWidth <= 760 && heroRect.bottom < window.innerHeight * 0.45 && !consultVisible;

        mobileAppointment.classList.toggle('is-visible', shouldShow);
        mobileAppointment.setAttribute('aria-hidden', String(!shouldShow));
        mobileAppointment.setAttribute('tabindex', shouldShow ? '0' : '-1');
      };

      const queueMobileAppointmentUpdate = () => {
        if (updateQueued) return;
        updateQueued = true;
        requestAnimationFrame(updateMobileAppointment);
      };

      window.addEventListener('scroll', queueMobileAppointmentUpdate, { passive: true });
      window.addEventListener('resize', queueMobileAppointmentUpdate);
      updateMobileAppointment();
    </script>
