---
const canonicalUrl = "https://pixelfox.design/concepts/dental/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mira Dental House | Fictional Dental Website Concept</title>
    <meta name="description" content="Mira Dental House is an independent fictional dental website concept by PixelFox.design." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Mira Dental House | Fictional Dental Website Concept" />
    <meta property="og:description" content="A warm, patient-first website concept for a fictional modern dental practice." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://pixelfox.design/images/dental/hero-1440.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2232%22 fill=%22%2323423f%22/><path d=%22M18 43V20h5l9 13 9-13h5v23h-6V30l-8 11-8-11v13z%22 fill=%22%23f6f1e8%22/></svg>" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="concept-bar">
      <a href="/">PixelFox.design</a>
      <span>Independent fictional concept / not client work</span>
    </div>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Mira Dental House home">
        <span class="brand-mark" aria-hidden="true">M</span>
        <span class="brand-name">Mira <i>Dental House</i></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#care">Care</a>
        <a href="#visit">First visit</a>
        <a href="#studio">The studio</a>
        <a href="#questions">Questions</a>
      </nav>
      <a class="header-cta" href="#appointment">Request a visit</a>
      <details class="mobile-nav">
        <summary>Menu <span aria-hidden="true"></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#care">Care</a>
          <a href="#visit">First visit</a>
          <a href="#studio">The studio</a>
          <a href="#questions">Questions</a>
          <a href="#appointment">Request a visit</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Modern general + cosmetic dentistry</p>
          <h1 id="hero-title">Dentistry,<br /><em>made more</em><br />human.</h1>
          <p class="hero-intro">A calmer dental experience built around clear conversations, thoughtful comfort, and care that starts with listening.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#appointment">Request a first visit <span>↗</span></a>
            <a class="text-link" href="#care">Explore care <span>↓</span></a>
          </div>
          <p class="hero-note">Fictional practice concept. No appointments are scheduled.</p>
        </div>
        <figure class="hero-visual">
          <picture>
            <source type="image/avif" srcset="/images/dental/hero-760.avif 760w, /images/dental/hero-1440.avif 1440w" sizes="(max-width: 760px) 100vw, 55vw" />
            <source type="image/webp" srcset="/images/dental/hero-760.webp 760w, /images/dental/hero-1440.webp 1440w" sizes="(max-width: 760px) 100vw, 55vw" />
            <img src="/images/dental/hero-1440.webp" alt="Patient having a relaxed conversation with a dental professional in a warm modern studio" width="1440" height="960" decoding="async" fetchpriority="high" />
          </picture>
          <figcaption>Original AI-generated editorial image for this fictional concept</figcaption>
        </figure>
      </section>

      <section class="reassurance" aria-label="Practice principles">
        <p><span>01</span> A judgment-free welcome</p>
        <p><span>02</span> Clear next steps</p>
        <p><span>03</span> Comfort considered</p>
        <p><span>04</span> Questions encouraged</p>
      </section>

      <section class="intro section" aria-labelledby="intro-title">
        <div class="section-label">01 / Our approach</div>
        <div class="intro-heading">
          <h2 id="intro-title">A softer first impression.<br />A clearer path to care.</h2>
          <div class="orbit" aria-hidden="true"><span>care</span></div>
        </div>
        <div class="intro-copy">
          <p class="intro-lead">Dental websites often lead with procedures. Mira begins with how a visit should feel: understood, informed, and never rushed.</p>
          <p>This concept balances clinical clarity with the warmth of a design-led hospitality brand, helping nervous and routine patients find what they need without visual noise.</p>
        </div>
      </section>

      <section class="care section" id="care" aria-labelledby="care-title">
        <div class="care-heading">
          <div>
            <p class="eyebrow light"><span></span> Care, in plain language</p>
            <h2 id="care-title">For the smile you have.<br /><em>And the life around it.</em></h2>
          </div>
          <p>A simple service architecture organized around patient needs instead of a wall of clinical terminology.</p>
        </div>
        <div class="care-grid">
          <article class="care-card care-card-featured">
            <p class="card-number">01</p>
            <div class="care-icon" aria-hidden="true"><svg viewBox="0 0 80 80"><path d="M23 19c7-7 13-1 17-1s10-6 17 1c8 8 2 19-2 26-4 8-5 22-11 22-5 0-3-16-8-16s-3 16-8 16c-6 0-7-14-11-22-4-7-10-18-2-26Z" /></svg></div>
            <h3>Everyday care</h3>
            <p>Checkups, cleanings, preventive planning, and answers that make home care easier to understand.</p>
            <a href="#appointment">Plan a first visit <span>↗</span></a>
          </article>
          <article class="care-card">
            <p class="card-number">02</p>
            <div class="care-icon" aria-hidden="true"><svg viewBox="0 0 80 80"><path d="M14 42h52M40 16v48M22 25c10 7 26 7 36 0M22 55c10-7 26-7 36 0" /></svg></div>
            <h3>Repair + restore</h3>
            <p>Concept positioning for fillings, crowns, and restorative options explained without pressure.</p>
            <a href="#questions">What to expect <span>↗</span></a>
          </article>
          <article class="care-card">
            <p class="card-number">03</p>
            <div class="care-icon" aria-hidden="true"><svg viewBox="0 0 80 80"><path d="M15 48c13 15 37 15 50 0M22 30c3-5 8-8 13-8m10 0c5 0 10 3 13 8" /><circle cx="29" cy="34" r="2" /><circle cx="51" cy="34" r="2" /></svg></div>
            <h3>Smile goals</h3>
            <p>A thoughtful route for whitening, alignment, and cosmetic conversations without promised outcomes.</p>
            <a href="#appointment">Start a conversation <span>↗</span></a>
          </article>
        </div>
      </section>

      <section class="visit" id="visit" aria-labelledby="visit-title">
        <figure class="visit-media">
          <picture>
            <source type="image/avif" srcset="/images/dental/consultation-560.avif 560w, /images/dental/consultation-1000.avif 1000w" sizes="(max-width: 760px) 100vw, 45vw" />
            <source type="image/webp" srcset="/images/dental/consultation-560.webp 560w, /images/dental/consultation-1000.webp 1000w" sizes="(max-width: 760px) 100vw, 45vw" />
            <img src="/images/dental/consultation-1000.webp" alt="Dental professional calmly explaining a tooth diagram to a patient" width="1000" height="1215" loading="lazy" decoding="async" />
          </picture>
          <span>Original AI-generated image</span>
        </figure>
        <div class="visit-copy">
          <p class="eyebrow"><span></span> Your first visit</p>
          <h2 id="visit-title">Know what comes next.</h2>
          <p class="visit-intro">Less uncertainty begins with a simple, visible plan. This concept makes the first appointment feel easy to picture.</p>
          <ol class="visit-steps">
            <li><span>01</span><div><h3>Tell us what matters</h3><p>Share your goals, concerns, and what would make the visit more comfortable.</p></div></li>
            <li><span>02</span><div><h3>Look together</h3><p>Review findings in everyday language, with room to pause and ask questions.</p></div></li>
            <li><span>03</span><div><h3>Choose your pace</h3><p>Leave with a clear concept plan, priorities, and no invented urgency.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="studio" id="studio" aria-labelledby="studio-title">
        <figure class="studio-media">
          <picture>
            <source type="image/avif" srcset="/images/dental/studio-720.avif 720w, /images/dental/studio-1440.avif 1440w" sizes="100vw" />
            <source type="image/webp" srcset="/images/dental/studio-720.webp 720w, /images/dental/studio-1440.webp 1440w" sizes="100vw" />
            <img src="/images/dental/studio-1440.webp" alt="Warm modern reception area in a fictional boutique dental studio" width="1440" height="960" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="studio-overlay">
          <p>02 / The environment</p>
          <h2 id="studio-title">Designed to lower<br />the volume.</h2>
          <span>Concept interior / AI-generated</span>
        </div>
      </section>

      <section class="principle section" aria-labelledby="principle-title">
        <p class="eyebrow"><span></span> A simple belief</p>
        <h2 id="principle-title">You should never feel<br />behind on your own care.</h2>
        <div class="principle-bottom">
          <p>No lectures. No mystery language. Just a respectful conversation about where things are and what options exist.</p>
          <div class="smile-line" aria-hidden="true"><span></span></div>
        </div>
      </section>

      <section class="appointment" id="appointment" aria-labelledby="appointment-title">
        <div class="appointment-copy">
          <p class="eyebrow light"><span></span> Take the first step</p>
          <h2 id="appointment-title">Let’s make room<br />for your smile.</h2>
          <p>This form demonstrates a friendly new-patient request. Mira Dental House is fictional, and no information is sent or stored.</p>
          <div class="concept-notice">Concept only / not a real dental practice / no appointment is booked</div>
        </div>
        <form class="appointment-form" id="dental-form">
          <div class="form-top"><p>Request a concept visit</p><span>01 — 04</span></div>
          <label><span>Your name</span><input name="name" autocomplete="name" placeholder="First and last name" required /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
          <label><span>What brings you in?</span><select name="reason"><option>New-patient checkup</option><option>Something feels uncomfortable</option><option>Repair or restorative question</option><option>Cosmetic conversation</option><option>I am not sure yet</option></select></label>
          <label><span>Anything we should know?</span><textarea name="message" rows="3" placeholder="Share a question or comfort preference"></textarea></label>
          <button type="submit">Preview my request <span>↗</span></button>
          <p class="form-status" id="dental-form-status" aria-live="polite">Demonstration only. Nothing is sent.</p>
        </form>
      </section>

      <section class="questions section" id="questions" aria-labelledby="questions-title">
        <div><p class="eyebrow"><span></span> Good questions</p><h2 id="questions-title">Before you<br />settle in.</h2></div>
        <div class="faq-list">
          <details><summary><span>01</span> Is Mira Dental House a real practice?<i>+</i></summary><p>No. It is an independent website concept created by PixelFox.design for a fictional dental brand.</p></details>
          <details><summary><span>02</span> Are the people shown actual patients or clinicians?<i>+</i></summary><p>No. Every photograph was AI-generated specifically for this design concept.</p></details>
          <details><summary><span>03</span> Why are there no reviews or credentials?<i>+</i></summary><p>Those details must be verified for a real practice. This concept avoids inventing patient stories, qualifications, insurance participation, or outcomes.</p></details>
          <details><summary><span>04</span> Does the request form send information?<i>+</i></summary><p>No. It only demonstrates the interaction locally in your browser and does not submit or store anything.</p></details>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-wordmark">Mira <em>Dental House</em></div>
      <nav aria-label="Footer navigation"><a href="#care">Care</a><a href="#visit">First visit</a><a href="#studio">Studio</a><a href="#top">Back to top</a></nav>
      <p>Mira Dental House is an independent fictional website concept by PixelFox.design. It is not a real dental practice and makes no patient, treatment, licensing, insurance, availability, or outcome claims. Images were AI-generated for this concept.</p>
      <a class="back-link" href="/">Return to PixelFox.design <span>↗</span></a>
    </footer>

    <script is:inline>
      document.querySelectorAll(".mobile-nav a").forEach((link) => {
        link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
      });
      document.getElementById("dental-form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const status = document.getElementById("dental-form-status");
        if (status) status.textContent = "Preview complete. A real practice would review your request before confirming a visit. Nothing was sent.";
      });
    </script>

    <style is:global>
      :root {
        --ivory: #f5f0e7;
        --paper: #fbf8f2;
        --ink: #17312f;
        --green: #23423f;
        --sage: #a8b6a2;
        --sage-light: #dce2d4;
        --apricot: #e9976f;
        --line: rgba(23, 49, 47, 0.2);
        --serif: "Iowan Old Style", "Baskerville", "Palatino Linotype", serif;
        --sans: "Avenir Next", "Century Gothic", "Trebuchet MS", sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 88px; background: var(--ivory); }
      body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--ivory); font-family: var(--sans); font-size: 16px; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      img { display: block; max-width: 100%; }
      .skip-link { position: fixed; z-index: 200; top: 12px; left: 12px; padding: 10px 14px; color: var(--paper); background: var(--ink); transform: translateY(-150%); }
      .skip-link:focus { transform: translateY(0); }
      .concept-bar { min-height: 32px; padding: 7px clamp(20px, 4.5vw, 72px); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--paper); background: var(--apricot); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
      .concept-bar a { text-decoration: underline; text-underline-offset: 3px; }
      .site-header { position: relative; z-index: 20; min-height: 82px; padding: 0 clamp(20px, 4.5vw, 72px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; border-bottom: 1px solid var(--line); background: rgba(245, 240, 231, 0.96); }
      .brand { display: inline-flex; align-items: center; gap: 12px; justify-self: start; }
      .brand-mark { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; color: var(--paper); background: var(--green); font-family: var(--serif); font-size: 21px; font-style: italic; }
      .brand-name { font-family: var(--serif); font-size: 23px; line-height: 1; }
      .brand-name i { display: block; margin-top: 4px; font-family: var(--sans); font-size: 7px; font-style: normal; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; }
      .desktop-nav { display: flex; gap: clamp(22px, 3vw, 46px); }
      .desktop-nav a, .header-cta { font-size: 9px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
      .desktop-nav a { position: relative; padding: 10px 0; }
      .desktop-nav a::after { position: absolute; right: 0; bottom: 4px; left: 0; height: 1px; background: var(--ink); content: ""; transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
      .desktop-nav a:hover::after, .desktop-nav a:focus-visible::after { transform: scaleX(1); transform-origin: left; }
      .header-cta { min-height: 42px; padding: 0 20px; display: inline-flex; align-items: center; justify-self: end; color: var(--paper); background: var(--green); transition: background 180ms ease, transform 180ms ease; }
      .header-cta:hover, .header-cta:focus-visible { background: var(--ink); transform: translateY(-2px); }
      .mobile-nav { display: none; }
      .hero { min-height: calc(100vh - 114px); display: grid; grid-template-columns: minmax(0, 45%) minmax(0, 55%); background: var(--paper); }
      .hero-copy { min-width: 0; padding: clamp(70px, 9vw, 138px) clamp(28px, 5vw, 80px) 54px; display: flex; flex-direction: column; justify-content: center; }
      .eyebrow { margin: 0 0 28px; display: flex; align-items: center; gap: 12px; font-size: 9px; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
      .eyebrow > span { width: 30px; height: 1px; display: block; background: currentColor; }
      .eyebrow.light { color: var(--sage-light); }
      h1, h2, h3, p { margin-top: 0; }
      h1, h2 { font-family: var(--serif); font-weight: 400; }
      h1 { margin-bottom: 30px; font-size: clamp(62px, 7.1vw, 116px); line-height: 0.84; letter-spacing: -0.055em; }
      h1 em, h2 em { color: var(--apricot); font-weight: 400; }
      .hero-intro { max-width: 470px; margin-bottom: 0; color: rgba(23, 49, 47, 0.78); font-family: var(--serif); font-size: clamp(17px, 1.45vw, 22px); line-height: 1.5; }
      .hero-actions { margin-top: 38px; display: flex; align-items: center; gap: 26px; }
      .button, .text-link { min-height: 52px; display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
      .button { min-width: 225px; padding: 0 18px; }
      .button-dark { color: var(--paper); background: var(--green); }
      .button-dark:hover, .button-dark:focus-visible { background: var(--apricot); }
      .text-link { border-bottom: 1px solid var(--ink); }
      .hero-note { margin: auto 0 0; padding-top: 48px; color: rgba(23, 49, 47, 0.58); font-size: 8px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
      .hero-visual, .visit-media, .studio-media { margin: 0; overflow: hidden; }
      .hero-visual { position: relative; min-height: 620px; }
      .hero-visual picture, .hero-visual img, .visit-media picture, .visit-media img, .studio-media picture, .studio-media img { width: 100%; height: 100%; }
      .hero-visual img, .visit-media img, .studio-media img { object-fit: cover; }
      .hero-visual img { object-position: 60% center; animation: image-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both; }
      .hero-visual figcaption, .visit-media > span { position: absolute; right: 18px; bottom: 16px; padding: 7px 9px; color: var(--paper); background: rgba(23, 49, 47, 0.78); font-size: 7px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .reassurance { min-height: 76px; padding: 0 clamp(24px, 5vw, 76px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; color: var(--paper); background: var(--green); }
      .reassurance p { margin: 0; padding: 0 24px; display: flex; align-items: center; gap: 15px; border-right: 1px solid rgba(245, 240, 231, 0.18); font-size: 9px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; }
      .reassurance p:first-child { padding-left: 0; }
      .reassurance p:last-child { border-right: 0; }
      .reassurance span { color: var(--apricot); }
      .section { padding: clamp(82px, 10vw, 150px) clamp(24px, 7vw, 110px); }
      .section-label { margin-bottom: 58px; font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
      .intro { background: radial-gradient(circle at 82% 16%, rgba(168, 182, 162, 0.32), transparent 24%), var(--ivory); }
      .intro-heading { display: grid; grid-template-columns: minmax(0, 1fr) 150px; align-items: center; gap: 40px; }
      .intro h2, .care h2, .visit h2, .principle h2, .appointment h2, .questions h2 { margin-bottom: 0; font-size: clamp(52px, 6.7vw, 100px); line-height: 0.96; letter-spacing: -0.045em; }
      .orbit { position: relative; width: 140px; height: 140px; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font-family: var(--serif); font-size: 24px; font-style: italic; transform: rotate(-8deg); }
      .orbit::before { position: absolute; width: 18px; height: 18px; border-radius: 50%; background: var(--apricot); content: ""; transform: translate(62px, -26px); }
      .intro-copy { max-width: 860px; margin: 78px 0 0 auto; display: grid; grid-template-columns: 1.3fr 1fr; gap: 70px; }
      .intro-copy p { margin-bottom: 0; line-height: 1.75; }
      .intro-copy .intro-lead { font-family: var(--serif); font-size: clamp(23px, 2.2vw, 34px); line-height: 1.45; }
      .care { color: var(--paper); background: var(--ink); }
      .care-heading { display: grid; grid-template-columns: 1.5fr 0.5fr; align-items: end; gap: 70px; }
      .care-heading > p { margin-bottom: 6px; color: rgba(245, 240, 231, 0.7); line-height: 1.7; }
      .care-grid { margin-top: 78px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(245, 240, 231, 0.2); border-bottom: 1px solid rgba(245, 240, 231, 0.2); }
      .care-card { min-height: 480px; padding: 30px clamp(24px, 3vw, 46px) 34px; display: flex; flex-direction: column; border-right: 1px solid rgba(245, 240, 231, 0.2); }
      .care-card:last-child { border-right: 0; }
      .care-card-featured { color: var(--ink); background: var(--sage-light); }
      .card-number { margin-bottom: 44px; font-size: 9px; font-weight: 700; letter-spacing: 0.16em; }
      .care-icon { width: 80px; height: 80px; margin-bottom: 36px; }
      .care-icon svg { width: 100%; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.4; }
      .care-card h3 { margin-bottom: 15px; font-family: var(--serif); font-size: clamp(29px, 2.8vw, 42px); font-weight: 400; }
      .care-card > p:not(.card-number) { max-width: 340px; margin-bottom: 34px; color: inherit; line-height: 1.7; opacity: 0.75; }
      .care-card > a { margin-top: auto; padding-top: 17px; display: flex; justify-content: space-between; border-top: 1px solid currentColor; font-size: 9px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
      .visit { display: grid; grid-template-columns: minmax(0, 47%) minmax(0, 53%); background: var(--paper); }
      .visit-media { position: relative; min-height: 850px; }
      .visit-media img { object-position: center center; }
      .visit-copy { padding: clamp(76px, 9vw, 140px) clamp(28px, 7vw, 110px); }
      .visit-intro { max-width: 600px; margin: 36px 0 52px; font-family: var(--serif); font-size: clamp(19px, 1.8vw, 27px); line-height: 1.55; }
      .visit-steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .visit-steps li { padding: 24px 0; display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 18px; border-bottom: 1px solid var(--line); }
      .visit-steps > li > span { color: var(--apricot); font-size: 10px; font-weight: 700; letter-spacing: 0.13em; }
      .visit-steps h3 { margin-bottom: 8px; font-family: var(--serif); font-size: 24px; font-weight: 400; }
      .visit-steps p { margin-bottom: 0; color: rgba(23, 49, 47, 0.72); line-height: 1.6; }
      .studio { position: relative; min-height: 86vh; overflow: hidden; }
