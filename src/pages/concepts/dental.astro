---
const canonicalUrl = "https://pixelfox.design/concepts/dental/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mira Dental House | Fictional Dental Website Concept</title>
    <meta name="description" content="Mira Dental House is a bright, smile-first fictional dental website concept by PixelFox.design." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Mira Dental House | Fictional Dental Website Concept" />
    <meta property="og:description" content="A joyful, smile-first website concept for a fictional modern dental practice." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://pixelfox.design/images/dental/smile-hero-1600.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2232%22 fill=%22%231456ff%22/><circle cx=%2223%22 cy=%2228%22 r=%223%22 fill=%22white%22/><circle cx=%2241%22 cy=%2228%22 r=%223%22 fill=%22white%22/><path d=%22M18 38c8 9 20 9 28 0%22 fill=%22none%22 stroke=%22%23ffd52a%22 stroke-width=%224%22 stroke-linecap=%22round%22/></svg>" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="concept-bar">
      <a href="/">PixelFox.design</a>
      <span>Independent fictional concept. Not a real dental practice.</span>
    </div>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Mira Dental House home">
        <span class="brand-bubble" aria-hidden="true">M</span>
        <span><strong>Mira</strong><small>Dental House</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#care">What we do</a>
        <a href="#welcome">First visit</a>
        <a href="#smiles">Smile wall</a>
        <a href="#questions">Questions</a>
      </nav>
      <a class="header-cta" href="#appointment">Say hello <span>↗</span></a>
      <details class="mobile-nav">
        <summary>Menu <span aria-hidden="true"></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#care">What we do</a>
          <a href="#welcome">First visit</a>
          <a href="#smiles">Smile wall</a>
          <a href="#questions">Questions</a>
          <a href="#appointment">Say hello</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker">Bright care for real life</p>
          <h1 id="hero-title">Your smile<br />has <em>plans.</em></h1>
          <p class="hero-intro">Checkups, questions, repairs, and smile goals, all in one upbeat, judgment-free place.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href="#appointment">Plan a first visit <span>↗</span></a>
            <a class="button button-clear" href="#care">Find your care <span>↓</span></a>
          </div>
          <p class="concept-note">Fictional practice concept. No appointment is scheduled.</p>
        </div>
        <div class="hero-art">
          <div class="sun-dot" aria-hidden="true"></div>
          <figure class="hero-photo">
            <picture>
              <source type="image/avif" srcset="/images/dental/smile-hero-800.avif 800w, /images/dental/smile-hero-1600.avif 1600w" sizes="(max-width: 780px) 100vw, 54vw" />
              <source type="image/webp" srcset="/images/dental/smile-hero-800.webp 800w, /images/dental/smile-hero-1600.webp 1600w" sizes="(max-width: 780px) 100vw, 54vw" />
              <img src="/images/dental/smile-hero-1600.webp" alt="A joyful woman laughing and showing her natural smile against a bright blue background" width="1600" height="1067" decoding="async" fetchpriority="high" />
            </picture>
          </figure>
          <div class="sticker sticker-one">Smile<br />out loud!</div>
          <div class="sticker sticker-two">No judgment<br />zone</div>
          <p class="image-credit">Original AI-generated concept image</p>
        </div>
      </section>

      <div class="smile-ticker" aria-label="Dental care categories">
        <div>
          <span>Checkups</span><i>✦</i><span>Cleanings</span><i>✦</i><span>Repairs</span><i>✦</i><span>Smile goals</span><i>✦</i><span>Clear answers</span><i>✦</i><span>Checkups</span><i>✦</i><span>Cleanings</span><i>✦</i>
        </div>
      </div>

      <section class="care" id="care" aria-labelledby="care-title">
        <div class="care-heading">
          <p class="section-tag">Start where you are</p>
          <h2 id="care-title">What can we help<br />you smile about?</h2>
          <p>Choose the thought that sounds most like you. A real practice could use this friendly entry point to make dental services easier to understand.</p>
        </div>
        <div class="care-paths">
          <a class="path path-blue" href="#appointment"><span>01</span><strong>Keep things healthy</strong><small>Checkups + cleanings</small><i>↗</i></a>
          <a class="path path-yellow" href="#appointment"><span>02</span><strong>Fix something</strong><small>Repair + restore</small><i>↗</i></a>
          <a class="path path-coral" href="#appointment"><span>03</span><strong>Love my smile</strong><small>Cosmetic conversations</small><i>↗</i></a>
          <a class="path path-mint" href="#welcome"><span>04</span><strong>Feel less nervous</strong><small>Comfort-first visits</small><i>↗</i></a>
        </div>
      </section>

      <section class="welcome" id="welcome" aria-labelledby="welcome-title">
        <div class="welcome-photo-wrap">
          <figure class="welcome-photo">
            <picture>
              <source type="image/avif" srcset="/images/dental/chair-laugh-700.avif 700w, /images/dental/chair-laugh-1400.avif 1400w" sizes="(max-width: 780px) 100vw, 58vw" />
              <source type="image/webp" srcset="/images/dental/chair-laugh-700.webp 700w, /images/dental/chair-laugh-1400.webp 1400w" sizes="(max-width: 780px) 100vw, 58vw" />
              <img src="/images/dental/chair-laugh-1400.webp" alt="A patient laughing during a relaxed conversation with a dental professional" width="1400" height="1050" loading="lazy" decoding="async" />
            </picture>
          </figure>
          <span class="photo-caption">A dental visit can feel like this.</span>
        </div>
        <div class="welcome-copy">
          <p class="section-tag">Your first visit</p>
          <h2 id="welcome-title">Really,<br />we’re glad<br />you’re here.</h2>
          <p>There is no perfect starting point. Tell us what matters, ask every question, and take the next step at your own pace.</p>
          <ol>
            <li><span>1</span><div><strong>Talk first</strong><small>Your goals and comfort come before a plan.</small></div></li>
            <li><span>2</span><div><strong>Look together</strong><small>See and understand what the clinician sees.</small></div></li>
            <li><span>3</span><div><strong>Choose your next step</strong><small>Clear options, without invented urgency.</small></div></li>
          </ol>
        </div>
      </section>

      <section class="smiles" id="smiles" aria-labelledby="smiles-title">
        <div class="smiles-head">
          <p class="section-tag">The smile wall</p>
          <h2 id="smiles-title">Healthy looks<br />good on <em>everyone.</em></h2>
          <p>Real smiles are expressive, individual, and never one-size-fits-all. This concept celebrates the people, not a promised cosmetic result.</p>
        </div>
        <figure class="trio-photo">
          <picture>
            <source type="image/avif" srcset="/images/dental/smile-trio-800.avif 800w, /images/dental/smile-trio-1600.avif 1600w" sizes="100vw" />
            <source type="image/webp" srcset="/images/dental/smile-trio-800.webp 800w, /images/dental/smile-trio-1600.webp 1600w" sizes="100vw" />
            <img src="/images/dental/smile-trio-1600.webp" alt="Three friends sharing a laugh against bold blue, yellow, and coral backgrounds" width="1600" height="900" loading="lazy" decoding="async" />
          </picture>
          <figcaption>Original AI-generated image for this fictional concept</figcaption>
        </figure>
        <div class="smile-stats" aria-label="Practice values">
          <p><strong>100%</strong><span>Questions welcome</span></p>
          <p><strong>0</strong><span>Lectures needed</span></p>
          <p><strong>Your pace</strong><span>Always the right pace</span></p>
        </div>
      </section>

      <section class="appointment" id="appointment" aria-labelledby="appointment-title">
        <div class="appointment-copy">
          <p class="section-tag">Come say hello</p>
          <h2 id="appointment-title">Ready when<br />you are.</h2>
          <p>This friendly request form demonstrates how a new-patient path could work. Mira Dental House is fictional, so nothing is submitted or stored.</p>
          <div class="appointment-badge">Concept only<br />No appointment is booked</div>
        </div>
        <form class="appointment-form" id="dental-form">
          <div class="form-top"><strong>Tell us a little</strong><span>1 minute</span></div>
          <label><span>Your name</span><input name="name" autocomplete="name" placeholder="First and last name" required /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
          <label><span>What’s on your mind?</span><select name="reason"><option>It is time for a checkup</option><option>Something feels uncomfortable</option><option>I have a repair question</option><option>I want to talk about my smile</option><option>I am nervous and not sure yet</option></select></label>
          <label><span>Anything that would make a visit easier?</span><textarea name="message" rows="3" placeholder="Share a question or comfort preference"></textarea></label>
          <button type="submit">Preview my hello <span>↗</span></button>
          <p class="form-status" id="dental-form-status" aria-live="polite">Demonstration only. Nothing is sent.</p>
        </form>
      </section>

      <section class="questions" id="questions" aria-labelledby="questions-title">
        <div class="questions-title">
          <p class="section-tag">Good to know</p>
          <h2 id="questions-title">Open wide.<br /><em>Ask away.</em></h2>
        </div>
        <div class="faq-list">
          <details><summary><span>01</span> Is Mira Dental House a real practice?<i>+</i></summary><p>No. It is an independent website concept created by PixelFox.design for a fictional dental brand.</p></details>
          <details><summary><span>02</span> Are these actual patients and clinicians?<i>+</i></summary><p>No. The people and scenes were AI-generated specifically for this design concept.</p></details>
          <details><summary><span>03</span> Where are the reviews and credentials?<i>+</i></summary><p>Those must be verified for a real practice. This concept does not invent patient stories, qualifications, insurance participation, or treatment outcomes.</p></details>
          <details><summary><span>04</span> Does the form send my information?<i>+</i></summary><p>No. It only demonstrates the interaction in your browser. Nothing is submitted or stored.</p></details>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-face" aria-hidden="true"><span>•</span><span>•</span><i></i></div>
      <div class="footer-main"><p>Keep smiling.</p><a href="#top">Back to the top ↗</a></div>
      <div class="footer-bottom">
        <strong>Mira Dental House</strong>
        <p>Mira Dental House is an independent fictional website concept by PixelFox.design. It is not a real dental practice and makes no patient, treatment, licensing, insurance, availability, or outcome claims. Images were AI-generated for this concept.</p>
        <a href="/">Return to PixelFox.design</a>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll(".mobile-nav a").forEach((link) => {
        link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
      });
      document.getElementById("dental-form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const status = document.getElementById("dental-form-status");
        if (status) status.textContent = "Preview complete. A real practice would review your note before confirming a visit. Nothing was sent.";
      });
    </script>

    <style is:global>
      :root {
        --blue: #1456ff;
        --blue-deep: #0d2f80;
        --yellow: #ffd52a;
        --coral: #ff6547;
        --mint: #93f3c8;
        --cream: #fff9e9;
        --white: #ffffff;
        --ink: #10233a;
        --line: rgba(16, 35, 58, 0.2);
        --display: "Gill Sans Ultra Bold", "Franklin Gothic Heavy", "Trebuchet MS", sans-serif;
        --body: "Avenir Next", "Century Gothic", "Trebuchet MS", sans-serif;
        --soft: "Cooper Black", "Bookman Old Style", Georgia, serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 92px; background: var(--cream); }
      body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--cream); font-family: var(--body); font-size: 17px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      img { display: block; max-width: 100%; }
      h1, h2, h3, p { margin-top: 0; }
      .skip-link { position: fixed; z-index: 300; top: 12px; left: 12px; padding: 12px 16px; color: var(--white); background: var(--ink); transform: translateY(-160%); }
      .skip-link:focus { transform: translateY(0); }
      .concept-bar { min-height: 38px; padding: 8px clamp(18px, 4vw, 64px); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--white); background: var(--ink); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
      .concept-bar a { color: var(--yellow); text-decoration: underline; text-underline-offset: 3px; }
      .site-header { position: relative; z-index: 40; min-height: 82px; padding: 0 clamp(18px, 4vw, 64px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px; color: var(--ink); background: var(--white); border-bottom: 2px solid var(--ink); }
      .brand { display: inline-flex; align-items: center; gap: 10px; justify-self: start; }
      .brand-bubble { width: 44px; height: 44px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; color: var(--white); background: var(--blue); font-family: var(--soft); font-size: 25px; transform: rotate(-8deg); }
      .brand > span:last-child { display: grid; line-height: 1; }
      .brand strong { font-family: var(--display); font-size: 23px; letter-spacing: -0.04em; text-transform: uppercase; }
      .brand small { margin-top: 3px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .desktop-nav { display: flex; align-items: center; gap: clamp(22px, 3vw, 44px); }
      .desktop-nav a, .header-cta { font-size: 13px; font-weight: 800; text-transform: uppercase; }
      .desktop-nav a { padding: 10px 0 5px; border-bottom: 3px solid transparent; }
      .desktop-nav a:hover, .desktop-nav a:focus-visible { border-bottom-color: var(--blue); }
      .header-cta { min-height: 48px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; justify-self: end; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); background: var(--yellow); box-shadow: 4px 4px 0 var(--ink); transition: transform 160ms ease, box-shadow 160ms ease; }
      .header-cta:hover, .header-cta:focus-visible { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
      .mobile-nav { display: none; }

      .hero { min-height: calc(100svh - 120px); display: grid; grid-template-columns: minmax(0, 46%) minmax(0, 54%); color: var(--white); background: var(--blue); border-bottom: 2px solid var(--ink); }
      .hero-copy { position: relative; z-index: 2; padding: clamp(64px, 8vw, 120px) clamp(24px, 5vw, 80px) 48px; display: flex; flex-direction: column; justify-content: center; }
      .kicker, .section-tag { margin-bottom: 26px; font-size: 13px; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
      .kicker::before, .section-tag::before { width: 28px; height: 10px; margin-right: 10px; display: inline-block; background: currentColor; border-radius: 50%; content: ""; }
      h1, h2 { font-family: var(--display); font-weight: 900; letter-spacing: -0.065em; text-transform: uppercase; }
      h1 { max-width: 760px; margin-bottom: 28px; font-size: clamp(72px, 8vw, 132px); line-height: 0.78; }
      h1 em { color: var(--yellow); font-family: var(--soft); font-size: 0.92em; font-style: normal; letter-spacing: -0.05em; text-transform: none; }
      .hero-intro { max-width: 580px; margin-bottom: 0; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; line-height: 1.5; }
      .hero-actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 13px; }
      .button { min-height: 56px; padding: 0 20px; display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); font-size: 13px; font-weight: 900; text-transform: uppercase; box-shadow: 4px 4px 0 var(--ink); transition: transform 160ms ease, box-shadow 160ms ease; }
      .button:hover, .button:focus-visible { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
      .button-yellow { background: var(--yellow); }
      .button-clear { color: var(--white); background: transparent; border-color: var(--white); box-shadow: 4px 4px 0 var(--yellow); }
      .concept-note { margin: auto 0 0; padding-top: 40px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
      .hero-art { position: relative; min-height: 620px; padding: clamp(30px, 4vw, 64px); display: grid; place-items: center; overflow: hidden; }
      .sun-dot { position: absolute; top: 4%; right: -8%; width: 54%; aspect-ratio: 1; border-radius: 50%; background: var(--yellow); }
      .hero-photo { position: relative; z-index: 1; width: min(100%, 780px); height: min(72vh, 760px); margin: 0; overflow: hidden; border: 3px solid var(--ink); border-radius: 46% 46% 18px 18px; box-shadow: 14px 14px 0 var(--ink); animation: photo-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both; }
      .hero-photo picture, .hero-photo img { width: 100%; height: 100%; }
      .hero-photo img { object-fit: cover; object-position: 62% center; }
      .sticker { position: absolute; z-index: 3; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; color: var(--ink); font-family: var(--soft); text-align: center; line-height: 1.05; box-shadow: 5px 5px 0 var(--ink); }
      .sticker-one { top: 8%; left: 1%; width: 150px; height: 150px; background: var(--yellow); font-size: 25px; transform: rotate(-10deg); }
      .sticker-two { right: 1%; bottom: 10%; width: 130px; height: 130px; background: var(--mint); font-size: 20px; transform: rotate(8deg); }
      .image-credit { position: absolute; z-index: 3; right: 26px; bottom: 12px; margin: 0; font-size: 12px; font-weight: 800; text-transform: uppercase; transform: rotate(-90deg) translateX(100%); transform-origin: right bottom; }
      .smile-ticker { overflow: hidden; border-bottom: 2px solid var(--ink); color: var(--ink); background: var(--yellow); }
      .smile-ticker div { width: max-content; min-height: 66px; display: flex; align-items: center; gap: 22px; animation: ticker 24s linear infinite; }
      .smile-ticker span { font-family: var(--display); font-size: 24px; text-transform: uppercase; }
      .smile-ticker i { color: var(--blue); font-size: 22px; font-style: normal; }

      .care { padding: clamp(82px, 9vw, 140px) clamp(22px, 6vw, 92px); background: var(--cream); }
      .care-heading { display: grid; grid-template-columns: 0.4fr 1.25fr 0.7fr; align-items: end; gap: 38px; }
      .care-heading .section-tag { align-self: start; }
      .care h2, .welcome h2, .smiles h2, .appointment h2, .questions h2 { margin-bottom: 0; font-size: clamp(56px, 6.8vw, 108px); line-height: 0.86; }
      .care-heading > p:last-child { margin-bottom: 4px; font-size: 18px; }
      .care-paths { margin-top: 70px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
      .path { min-height: 360px; padding: 24px; display: flex; flex-direction: column; border: 2px solid var(--ink); border-radius: 28px; color: var(--ink); box-shadow: 7px 7px 0 var(--ink); transition: transform 180ms ease, box-shadow 180ms ease; }
      .path:hover, .path:focus-visible { box-shadow: 2px 2px 0 var(--ink); transform: translate(5px, 5px) rotate(-1deg); }
      .path > span { font-weight: 900; }
      .path strong { margin: auto 0 10px; font-family: var(--display); font-size: clamp(30px, 3vw, 48px); line-height: 0.94; text-transform: uppercase; }
      .path small { min-height: 52px; font-size: 15px; font-weight: 700; }
      .path i { align-self: end; font-size: 28px; font-style: normal; }
      .path-blue { color: var(--white); background: var(--blue); }
      .path-yellow { background: var(--yellow); }
      .path-coral { background: var(--coral); }
      .path-mint { background: var(--mint); }

      .welcome { display: grid; grid-template-columns: minmax(0, 58%) minmax(0, 42%); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); background: var(--white); }
      .welcome-photo-wrap { position: relative; min-height: 820px; padding: clamp(30px, 4vw, 60px); display: grid; background: var(--coral); border-right: 2px solid var(--ink); }
      .welcome-photo { height: 100%; margin: 0; overflow: hidden; border: 3px solid var(--ink); border-radius: 22px 120px 22px 22px; box-shadow: 10px 10px 0 var(--ink); }
      .welcome-photo picture, .welcome-photo img { width: 100%; height: 100%; }
      .welcome-photo img { object-fit: cover; object-position: center; }
      .photo-caption { position: absolute; right: 8%; bottom: 7%; max-width: 250px; padding: 16px 20px; border: 2px solid var(--ink); border-radius: 999px; background: var(--yellow); font-family: var(--soft); font-size: 20px; line-height: 1.1; text-align: center; transform: rotate(-5deg); }
      .welcome-copy { padding: clamp(70px, 8vw, 120px) clamp(28px, 5vw, 80px); }
      .welcome-copy h2 { color: var(--blue); }
      .welcome-copy > p:not(.section-tag) { margin: 32px 0 40px; font-size: 19px; }
      .welcome-copy ol { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
      .welcome-copy li { padding: 20px 0; display: grid; grid-template-columns: 48px 1fr; gap: 14px; border-bottom: 2px solid var(--ink); }
      .welcome-copy li > span { width: 36px; height: 36px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; background: var(--mint); font-weight: 900; }
      .welcome-copy li div { display: grid; gap: 3px; }
      .welcome-copy li strong { font-family: var(--display); font-size: 21px; line-height: 1; text-transform: uppercase; }
      .welcome-copy li small { font-size: 15px; }

      .smiles { padding: clamp(82px, 9vw, 140px) clamp(22px, 6vw, 92px); color: var(--white); background: var(--blue-deep); }
      .smiles-head { display: grid; grid-template-columns: 0.42fr 1.3fr 0.62fr; align-items: end; gap: 40px; }
      .smiles h2 em, .questions h2 em { color: var(--yellow); font-family: var(--soft); font-size: 0.85em; font-style: normal; text-transform: none; }
      .smiles-head > p:last-child { margin-bottom: 4px; }
      .trio-photo { position: relative; margin: 70px 0 0; overflow: hidden; border: 3px solid var(--ink); border-radius: 120px 20px 120px 20px; box-shadow: 12px 12px 0 var(--yellow); }
      .trio-photo picture, .trio-photo img { width: 100%; }
      .trio-photo img { aspect-ratio: 16 / 8.3; object-fit: cover; }
