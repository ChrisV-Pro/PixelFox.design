---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---
<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta content="width=device-width, initial-scale=1" name="viewport" /><meta content="#111312" name="theme-color" /><title>PixelFox.design — Strategic websites. Distinctive by design.</title><meta content="An independent web design studio pairing thoughtful strategy, distinctive design, and lightweight development for ambitious businesses." name="description" /><link href="https://pixelfox.design/" rel="canonical" /><meta content="website" property="og:type" /><meta content="PixelFox.design" property="og:site_name" /><meta content="PixelFox.design — Strategic websites. Distinctive by design." property="og:title" /><meta content="An independent web design studio pairing thoughtful strategy, distinctive design, and lightweight development for ambitious businesses." property="og:description" /><meta content="https://pixelfox.design/" property="og:url" /><meta content="https://pixelfox.design/social-preview.svg" property="og:image" /><meta
      content="1200"
      property="og:image:width"
    /><meta content="630" property="og:image:height" /><meta content="PixelFox — Digital experiences. Business impact." property="og:image:alt" /><meta content="summary_large_image" name="twitter:card" /><link href="data:image/svg+xml;base64," rel="icon" type="image/svg+xml" /><style>
      :root {
        --ink: #111312;
        --ink-soft: #191b1a;
        --paper: #eeede9;
        --paper-deep: #e5e4df;
        --muted: #65665f;
        --light-muted: #b8b9b3;
        --orange: #ff813f;
        --orange-dark: #aa4214;
        --line: rgba(18, 21, 18, 0.18);
        --line-dark: rgba(239, 238, 232, 0.19);
        --display: Georgia, "Times New Roman", serif;
        --body: Arial, Helvetica, sans-serif;
        --max: 1280px;
        --gutter: clamp(24px, 5vw, 80px);
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 32px;
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--ink);
        font-family: var(--body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      body,
      button,
      input,
      textarea,
      select {
        font-family: var(--body);
      }
      ::selection {
        background: #ff9c67;
        color: #111;
      }
      img {
        display: block;
        max-width: 100%;
        height: auto;
      }
      svg {
        flex-shrink: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button,
      input,
      textarea,
      select {
        font-size: inherit;
      }
      button,
      a,
      input,
      textarea,
      select,
      summary {
        -webkit-tap-highlight-color: transparent;
      }
      button,
      summary {
        cursor: pointer;
      }
      button {
        color: inherit;
      }
      button:disabled {
        cursor: wait;
        opacity: 0.6;
      }
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 6px;
      }
      button,
      input,
      textarea,
      select {
        border-radius: 0;
      }
      p,
      h1,
      h2,
      h3,
      h4,
      ul,
      ol {
        margin: 0;
      }
      h1,
      h2,
      h3 {
        font-weight: 400;
      }
      p {
        max-width: 70ch;
      }
      ul,
      ol {
        padding: 0;
      }
      button svg,
      a svg {
        transition: transform 0.2s ease;
      }
      a:hover > svg,
      button:hover > svg {
        transform: translateX(3px);
      }
      section {
        position: relative;
        scroll-margin-top: 20px;
      }
      em {
        font-weight: 400;
      }
      .container {
        width: min(var(--max), calc(100% - var(--gutter) * 2));
        margin-inline: auto;
      }
      .section-light {
        background: var(--paper);
        color: var(--ink);
      }
      .section-dark {
        background: var(--ink);
        color: var(--paper);
      }
      .section-space {
        padding-block: 110px;
      }
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 15px;
        font-size: 10px;
        letter-spacing: 2.2px;
        font-weight: 500;
        line-height: 1.6;
        text-transform: uppercase;
        margin-bottom: 25px;
      }
      .section-num {
        font-size: 9px;
        letter-spacing: 1px;
        opacity: 0.65;
        padding-right: 13px;
        border-right: 1px solid currentColor;
      }
      .section-light .eyebrow {
        color: #54564f;
      }
      .section-dark .eyebrow {
        color: #bebeb7;
      }
      h2 {
        font-family: var(--display);
        font-size: clamp(39px, 4vw, 61px);
        line-height: 1.08;
        letter-spacing: -2px;
      }
      h2 em {
        color: var(--orange-dark);
      }
      .section-dark h2 em {
        color: var(--orange);
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 27px;
        border: 1px solid transparent;
        padding: 14px 24px;
        min-height: 49px;
        border-radius: 999px;
        letter-spacing: 1.3px;
        text-transform: uppercase;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.4;
        white-space: nowrap;
        transition:
          background 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .button-orange {
        background: var(--orange);
        color: #131411;
      }
      .button-orange:hover {
        background: #ff9a65;
      }
      .button-outline {
        border-color: rgba(238, 237, 233, 0.5);
        color: var(--paper);
        background: transparent;
      }
      .button-outline:hover {
        background: var(--paper);
        color: var(--ink);
        border-color: var(--paper);
      }
      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 25px;
        padding-block: 10px;
        border: 0;
        border-bottom: 1px solid currentColor;
        background: transparent;
        text-transform: uppercase;
        letter-spacing: 1.6px;
        font-size: 9px;
        font-weight: 600;
        line-height: 1.5;
      }
      .text-link svg {
        width: 19px;
        height: 19px;
      }
      .section-light .text-link {
        border-bottom-color: #b58c75;
      }
      .section-dark .text-link {
        border-bottom-color: #916448;
      }
      .actions {
        display: flex;
        align-items: center;
        gap: 34px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .skip-link {
        position: absolute;
        top: -100px;
        left: 20px;
        z-index: 99;
        padding: 12px 20px;
        background: var(--paper);
        color: var(--ink);
      }
      .skip-link:focus {
        top: 10px;
      }
      .site-header {
        position: relative;
        background: var(--ink);
        color: var(--paper);
        z-index: 10;
      }
      .header-inner {
        min-height: 112px;
        display: flex;
        align-items: center;
        gap: 45px;
        justify-content: space-between;
      }
      .wordmark {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1;
        flex-shrink: 0;
      }
      .wordmark-main {
        font-size: 24px;
        letter-spacing: 5px;
        font-weight: 400;
        white-space: nowrap;
      }
      .wordmark-main > span {
        color: var(--orange);
      }
      .wordmark-sub {
        font-size: 9px;
        letter-spacing: 6px;
        margin-top: 11px;
      }
      .desktop-nav {
        display: flex;
        gap: 34px;
        margin-left: auto;
      }
      .desktop-nav a {
        font-size: 10px;
        letter-spacing: 1.25px;
        padding: 12px 0;
        text-transform: uppercase;
        position: relative;
      }
      .desktop-nav a:after {
        content: "";
        position: absolute;
        bottom: 5px;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--orange);
        transition: width 0.2s;
      }
      .desktop-nav a:hover:after {
        width: 100%;
      }
      .header-cta {
        padding: 11px 20px;
        min-height: 41px;
        font-size: 9px;
        gap: 22px;
      }
      .mobile-nav {
        display: none;
      }
      .hero {
        overflow: hidden;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 57% 43%;
        min-height: 617px;
        position: relative;
        z-index: 2;
      }
      .hero-copy {
        padding-block: 49px 78px;
        position: relative;
        z-index: 2;
      }
      .hero .eyebrow {
        font-size: 9px;
        letter-spacing: 2.2px;
        margin-bottom: 30px;
      }
      .hero h1 {
        font-family: var(--display);
        font-size: clamp(70px, 7.5vw, 108px);
        font-weight: 400;
        letter-spacing: -5px;
        line-height: 0.995;
      }
      .hero-line {
        font-size: 0.8em;
        white-space: nowrap;
        letter-spacing: -3.7px;
      }
      .hero h1 em {
        color: var(--orange);
      }
      .hero-intro {
        font-size: 15px;
        color: #c4c4bd;
        line-height: 1.75;
        margin-top: 32px;
        max-width: 430px;
      }
      .hero .actions {
        margin-top: 33px;
      }
      .hero .text-link {
        font-size: 9px;
      }
      .hero-art {
        position: relative;
        align-self: stretch;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        margin-left: -30px;
        isolation: isolate;
      }
      .hero-fox {
        width: 100%;
        max-width: 510px;
        transform: translate(-19px, -2px);
        mix-blend-mode: normal;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
      }
      .hero-fox img {
        width: 100%;
        height: auto;
      }
      .hero-shape {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse at 90% 20%, #3f291b22 0, transparent 48%);
      }
      .hero-shape:before {
        content: "";
        position: absolute;
        right: -310px;
        top: 330px;
        width: 490px;
        height: 600px;
        background: linear-gradient(100deg, #96928b, var(--paper) 58%);
        transform: rotate(37deg);
        box-shadow: -2px 0 36px #d5723340;
      }
      .hero-shape:after {
        content: "";
        position: absolute;
        width: 950px;
        height: 650px;
        right: -130px;
        top: -460px;
        border: 1px solid #fff1;
        transform: rotate(-44deg);
      }
      .art-caption {
        position: absolute;
        right: -40px;
        bottom: 142px;
        color: #c7c7c1;
        font-size: 8px;
        letter-spacing: 2.7px;
        line-height: 2.4;
        z-index: 2;
      }
      .caption-rule {
        display: block;
        width: 25px;
        height: 1px;
        background: #a9856d;
        margin-top: 15px;
      }
      .art-index {
        position: absolute;
        right: 4px;
        top: 30px;
        font-size: 8px;
        letter-spacing: 2px;
        color: #92938c;
      }
      .hero-bottom {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-top: 1px solid var(--line-dark);
        height: 88px;
        color: #c1c1b9;
        font-size: 9px;
        letter-spacing: 1.6px;
        text-transform: uppercase;
      }
      .hero-bottom > p {
        display: flex;
        gap: 30px;
        font-size: 8px;
        letter-spacing: 1.8px;
      }
      .scroll-cue {
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .scroll-cue > span {
        font-size: 18px;
        line-height: 1;
      }
      .hero-folio {
        font-size: 8px;
        letter-spacing: 1px;
        color: #b9b9b1;
      }
      .split-heading {
        display: flex;
        justify-content: space-between;
        gap: 70px;
        align-items: flex-end;
      }
      .heading-aside {
        max-width: 320px;
        padding-bottom: 5px;
        flex-shrink: 0;
      }
      .heading-aside > p {
        font-size: 14px;
        color: #5c5e57;
        line-height: 1.75;
        margin-bottom: 22px;
      }
      .services-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 66px;
        gap: 0;
      }
      .service {
        padding-inline: 30px;
        border-left: 1px solid var(--line);
        display: flex;
        flex-direction: column;
      }
      .service:first-child {
        border-left: 0;
        padding-left: 0;
      }
      .service:last-child {
        padding-right: 0;
      }
      .service-icon {
        margin-bottom: 28px;
        height: 50px;
      }
      .service h3 {
        font-size: 21px;
        letter-spacing: -0.6px;
        margin-bottom: 12px;
      }
      .service > p {
        font-size: 13px;
        color: #5b5e56;
        line-height: 1.75;
      }
      .service ul {
        list-style: none;
        margin-top: 21px;
        color: #696b63;
        font-size: 11px;
        line-height: 1.9;
      }
      .service-bottom {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-top: auto;
        padding-top: 33px;
        font-size: 9px;
        letter-spacing: 1.2px;
      }
      .service-line {
        height: 1px;
        width: 36px;
        background: #94978d;
      }
      .service-bottom svg {
        margin-left: auto;
        width: 16px;
        height: 16px;
      }
      .featured {
        overflow: hidden;
      }
      .featured-grid {
        display: grid;
        grid-template-columns: 38% 62%;
        min-height: 559px;
        align-items: center;
      }
      .featured-copy {
        padding-block: 83px 70px;
        position: relative;
        z-index: 2;
      }
      .featured .eyebrow {
        margin-bottom: 17px;
      }
      .concept-tag {
        display: inline-block;
        border: 1px solid #64665e;
        border-radius: 2px;
        padding: 3px 7px;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        color: #c8c9c2;
        font-size: 8px;
        line-height: 1.5;
      }
      .featured h2 {
        font-size: clamp(52px, 5.1vw, 77px);
        line-height: 1.02;
        margin-top: 25px;
        letter-spacing: -3px;
      }
      .featured-copy > p:not(.eyebrow) {
        font-size: 14px;
        color: #b8bab1;
        line-height: 1.75;
        max-width: 270px;
        margin-top: 22px;
      }
      .featured-copy > .text-link {
        margin-top: 22px;
      }
      .featured-meta {
        margin-top: 46px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-size: 8px;
        letter-spacing: 2px;
      }
      .featured-meta span + span {
        font-size: 9px;
        letter-spacing: 0.1px;
        color: #a8aaa1;
      }
      .featured-visual {
        position: relative;
        display: flex;
        align-items: center;
        align-self: stretch;
        margin-right: calc(var(--gutter) * -1);
        overflow: hidden;
      }
      .featured-visual picture {
        width: 100%;
        display: block;
      }
      .featured-visual img {
        width: 100%;
        height: auto;
        transition: transform 0.6s ease;
        filter: contrast(1.02);
      }
      .featured-visual:hover img {
        transform: scale(1.025);
      }
      .image-cta {
        position: absolute;
        bottom: 36px;
        right: 35px;
        padding: 12px 15px;
        background: rgba(17, 19, 18, 0.87);
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 8px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        border: 1px solid #d0cec730;
      }
      .process-grid {
        display: grid;
        grid-template-columns: 30% 1fr;
        gap: 50px;
        align-items: center;
      }
      .process-heading h2 {
        font-size: 53px;
        line-height: 1.07;
      }
      .process-heading > p:not(.eyebrow) {
        font-size: 13px;
        line-height: 1.8;
        color: #62655c;
        margin-top: 25px;
      }
      .process-steps {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px;
      }
      .step-number {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 32px;
        color: #62665a;
        font-size: 9px;
        letter-spacing: 1px;
      }
      .step-number i {
        height: 1px;
        width: 45px;
        background: #aaa99f;
      }
      .process-steps h3 {
        font-size: 19px;
        letter-spacing: -0.4px;
        margin-bottom: 13px;
      }
      .process-steps p {
        font-size: 12px;
        line-height: 1.8;
        color: #65685e;
      }
      .work-header {
        display: flex;
        justify-content: space-between;
        gap: 60px;
        align-items: flex-end;
        margin-bottom: 51px;
      }
      .work-header h2 {
        font-size: 54px;
      }
      .work-header > p {
        font-size: 12px;
        max-width: 285px;
        color: #b1b4aa;
        padding-bottom: 6px;
        line-height: 1.8;
      }
      .work-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }
      .work-card {
        display: block;
        min-width: 0;
      }
      .work-image {
        position: relative;
        overflow: hidden;
        background: #222522;
        aspect-ratio: 1 / 1.13;
      }
      .work-image picture {
        display: block;
        width: 100%;
        height: 100%;
      }
      .work-image img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
        filter: saturate(0.82);
      }
      .work-card:hover img {
        transform: scale(1.045);
      }
      .work-tag {
        position: absolute;
        top: 13px;
        left: 13px;
        right: 13px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #fff;
        font-size: 8px;
        letter-spacing: 1.3px;
        text-transform: uppercase;
        text-shadow: 0 1px 7px #000;
      }
      .work-tag svg {
        width: 16px;
        height: 16px;
      }
      .work-caption {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 20px 0;
        border-bottom: 1px solid var(--line-dark);
      }
      .work-caption h3 {
        font-size: 15px;
        letter-spacing: 0.1px;
      }
      .work-caption p {
        font-size: 10px;
        color: #b8bbb1;
        margin-top: 2px;
      }
      .work-caption > svg {
        width: 17px;
        height: 17px;
      }
      .work-card:hover .work-caption > svg {
        transform: translateX(4px);
      }
      .studio-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 110px;
      }
      .studio h2 {
        font-size: 65px;
      }
      .studio-lead {
        font-size: 13px;
        color: #6e7066;
        line-height: 1.8;
        margin-top: 28px;
      }
      .studio-copy {
        padding-top: 7px;
      }
      .studio-copy > .large-copy {
        font-family: var(--display);
        font-size: 28px;
        letter-spacing: -0.7px;
        line-height: 1.35;
        color: var(--ink);
        margin-bottom: 27px;
      }
      .studio-copy > p {
        font-size: 14px;
        line-height: 1.8;
        color: #61645a;
        margin-bottom: 17px;
      }
      .studio-copy > .text-link {
        margin-top: 8px;
      }
      .principles {
        padding-bottom: 95px;
      }
      .principles-top {
        border-top: 1px solid var(--line);
        padding-top: 28px;
        margin-bottom: 29px;
      }
      .principles-top .eyebrow {
        margin-bottom: 0;
      }
      .principles-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 65px;
      }
      .principles-grid article > span {
        font-size: 8px;
        letter-spacing: 1.7px;
        color: #65685c;
      }
      .principles-grid h3 {
        font-size: 18px;
        letter-spacing: -0.3px;
        margin-top: 15px;
        margin-bottom: 11px;
      }
      .principles-grid p {
        font-size: 12px;
        line-height: 1.85;
        color: #65695d;
        max-width: 290px;
      }
      .statement {
        overflow: hidden;
      }
      .statement:before {
        content: "";
        position: absolute;
        right: -120px;
        top: -350px;
        width: 620px;
        height: 900px;
        background: linear-gradient(165deg, transparent 10%, #414239 48%, #0f1110 53%);
        transform: rotate(28deg);
        opacity: 0.4;
        border-left: 1px solid #e5b29433;
      }
      .statement-inner {
        min-height: 382px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        padding-block: 60px;
      }
      .statement .eyebrow {
        margin-bottom: 22px;
      }
      .statement-text {
        font-family: var(--display);
        font-size: clamp(40px, 5.2vw, 74px);
        letter-spacing: -2.5px;
        line-height: 1.07;
        position: relative;
        z-index: 2;
      }
      .statement-text em {
        color: var(--orange);
      }
      .round-link {
        position: absolute;
        right: 0;
